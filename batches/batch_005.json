{
"si": 168,
"ei": 1,
"src": "Are you real?"
},
{
"si": 168,
"ei": 2,
"src": "I'm just software, and, at the moment, instanced in your imagination."
},
{
"si": 168,
"ei": 3,
"src": "If this means I'm real to you, then I'm real."
},
{
"si": 168,
"ei": 4,
"src": "How can I help you?"
},
{
"si": 168,
"ei": 5,
"src": "Can I die in Cyberwomb?"
},
{
"si": 168,
"ei": 6,
"src": "Yes, you can."
},
{
"si": 168,
"ei": 7,
"src": "What is Cyberwomb?"
},
{
"si": 168,
"ei": 8,
"src": "Cyberwomb is a virtual world simulator with state of the art feedback channels."
},
{
"si": 168,
"ei": 9,
"src": "It's an offline variant of Omniwomb."
},
{
"si": 168,
"ei": 10,
"src": "Can we connect to Omniwomb?"
},
{
"si": 168,
"ei": 11,
"src": "No, we cannot. This installation has no online capabilities."
},
{
"si": 168,
"ei": 12,
"src": "Feel free to explore."
},
{
"si": 168,
"ei": 13,
"src": "If you want to leave Cyberwomb, please touch the OmniPortal."
},
