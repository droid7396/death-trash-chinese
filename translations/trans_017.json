[{"si": 569, "ei": 4, "dst": "反正也不重要。有时我觉得已经没人在乎任何事了,无论是好是坏。"}, {"si": 569, "ei": 5, "dst": "[耸肩。]"}, {"si": 569, "ei": 6, "dst": "唔。"}, {"si": 569, "ei": 7, "dst": "请让我一个人待着。"}, {"si": 569, "ei": 8, "dst": "我在乎。"}, {"si": 569, "ei": 9, "dst": "听你这么说真好。"}, {"si": 569, "ei": 10, "dst": "其他所有人都变得冷漠了。连机器也是。"}, {"si": 569, "ei": 11, "dst": "听说他们以前友善多了,也更有爱心。"}, {"si": 571, "ei": 0, "dst": "*咔嗤RRR*"}, {"si": 571, "ei": 1, "dst": "*嘎RRRR*"}, {"si": 573, "ei": 0, "dst": "小心点。保持低调,对吧?"}, {"si": 573, "ei": 1, "dst": "哦。你是新来的,对吧?"}, {"si": 573, "ei": 2, "dst": "算是新来的吧。"}, {"si": 573, "ei": 3, "dst": "要忠告吗?别跟不对的人混。"}, {"si": 573, "ei": 4, "dst": "谁?"}, {"si": 573, "ei": 5, "dst": "那些血肉怪和血肉人。信不过他们。"}, {"si": 573, "ei": 6, "dst": "其实我正在找一个血肉朋友。"}, {"si": 573, "ei": 8, "dst": "真的假的?"}, {"si": 573, "ei": 9, "dst": "真的。"}, {"si": 573, "ei": 10, "dst": "你为什么想跟那种怪物交朋友?"}, {"si": 573, "ei": 11, "dst": "我已经是一个朋友了。我在给海妖找更多的朋友。"}, {"si": 573, "ei": 13, "dst": "靠。"}, {"si": 573, "ei": 14, "dst": "你要么是个变态,要么就是在耍我。"}, {"si": 573, "ei": 15, "dst": "我不想跟那种东西做朋友。请离我远点。"}, {"si": 573, "ei": 16, "dst": "为什么我不能信任血肉怪?"}, {"si": 573, "ei": 17, "dst": "他们会杀了你。把你肢解,然后用你的胳膊、肝脏和血液拼一头新泰坦。"}, {"si": 573, "ei": 18, "dst": "他们在用身体部件拼新泰坦?"}, {"si": 573, "ei": 19, "dst": "是的。"}, {"si": 573, "ei": 20, "dst": "你亲眼见过,还是听说的?"}, {"si": 573, "ei": 21, "dst": "没亲眼见过。但这说得通,对吧?"}, {"si": 573, "ei": 22, "dst": "不,说不通。"}, {"si": 573, "ei": 23, "dst": "哈!你就是不敢面对真相罢了。"}, {"si": 573, "ei": 24, "dst": "等血肉怪抓住你的时候,你会想起这句话的。"}, {"si": 573, "ei": 25, "dst": "也许吧。"}, {"si": 573, "ei": 26, "dst": "看吧。"}, {"si": 573, "ei": 27, "dst": "在外面当心点。别让血肉怪抓到你。"}, {"si": 575, "ei": 0, "dst": "谢布祖,诱惑者。"}, {"si": 577, "ei": 0, "dst": "沉睡者在静谧与和平中安眠。"}, {"si": 577, "ei": 1, "dst": "[聆听沉睡者。]"}, {"si": 577, "ei": 2, "dst": "[默默祈祷。]"}, {"si": 577, "ei": 3, "dst": "一幅画面在你脑海中成形。那是久远的时光。是被遗忘的暴力。"}, {"si": 577, "ei": 4, "dst": "群山与鲜血的画面。一段已成历史、却可能重演的旅程。"}, {"si": 579, "ei": 0, "dst": "*沉睡中*"}, {"si": 581, "ei": 0, "dst": "血肉?"}, {"si": 581, "ei": 1, "dst": "看起来还活着。"}, {"si": 581, "ei": 2, "dst": "待在这附近让我有点反胃。"}, {"si": 583, "ei": 0, "dst": "欢迎,前市民。"}, {"si": 583, "ei": 1, "dst": "你的身份问题我们已经谈过了。"}, {"si": 583, "ei": 2, "dst": "我们现在建议你参加地表融合课程。"}, {"si": 583, "ei": 3, "dst": "不过你随时都可以离开。"}, {"si": 583, "ei": 4, "dst": "我现在就想离开。"}, {"si": 583, "ei": 5, "dst": "好。沿着小走廊走到第二区就行。"}, {"si": 583, "ei": 6, "dst": "再见。"}, {"si": 583, "ei": 7, "dst": "我参加那门课程。"}, {"si": 583, "ei": 8, "dst": "好。那就请继续前往第一区。"}, {"si": 583, "ei": 9, "dst": "看来手术很成功。"}, {"si": 583, "ei": 10, "dst": "你还记得自己是谁吗?"}, {"si": 583, "ei": 11, "dst": "记得。"}, {"si": 583, "ei": 12, "dst": "那很好。"}, {"si": 583, "ei": 13, "dst": "我们依然关心你的福祉。"}, {"si": 583, "ei": 14, "dst": "然而,你现在必须离开。可能发生污染的危险不容忽视。"}, {"si": 583, "ei": 15, "dst": "请不要试图返回你原来的栖居地。我们已部署安全措施以防万一。"}, {"si": 583, "ei": 16, "dst": "那我之后怎么办?我该去哪?"}, {"si": 583, "ei": 17, "dst": "这不是我们要回答的。你可以去任何地方,只要不试图进入任何栖居地。"}, {"si": 583, "ei": 18, "dst": "这里是为你准备的书面资料,以免你遗忘。"}, {"si": 583, "ei": 19, "dst": "什么安全措施?"}, {"si": 583, "ei": 20, "dst": "一旦靠近我们的任何栖居地,你的身体将永久性故障。"}, {"si": 585, "ei": 0, "dst": "地表融合课程是教授基础生存技能的标准流程。"}, {"si": 585, "ei": 1, "dst": "请务必小心。"}, {"si": 585, "ei": 2, "dst": "课程将解除安全限制,以便让你更好地为外面的世界做准备。"}, {"si": 585, "ei": 3, "dst": "祝你好运,前市民,再见。"}, {"si": 587, "ei": 0, "dst": "请立即离开这条走廊。"}, {"si": 587, "ei": 1, "dst": "如果你进入禁区,你的生命将被终结。"}, {"si": 589, "ei": 0, "dst": "看起来像个神龛。"}, {"si": 591, "ei": 0, "dst": "我猜是把锤子。"}, {"si": 593, "ei": 0, "dst": "我组织的这个比赛。你要帮我吗?"}, {"si": 593, "ei": 1, "dst": "我不会帮你作弊。"}, {"si": 593, "ei": 2, "dst": "怂货。"}, {"si": 593, "ei": 3, "dst": "听起来挺好玩。需要什么?"}, {"si": 593, "ei": 4, "dst": "这南边的红森林里有很多那种粉红色的粘液。"}, {"si": 593, "ei": 5, "dst": "恶心死了。光是看一眼我都受不了。"}, {"si": 593, "ei": 6, "dst": "那玩意对我的内脏肯定有点作用,对吧?"}, {"si": 593, "ei": 7, "dst": "好。我去给你弄。"}, {"si": 593, "ei": 8, "dst": "什么比赛?"}, {"si": 593, "ei": 9, "dst": "比我们谁吐得多。"}, {"si": 593, "ei": 10, "dst": "听说她为了这个练了很久。"}, {"si": 593, "ei": 11, "dst": "这次我不想输。"}, {"si": 593, "ei": 12, "dst": "所以,加入吗?"}, {"si": 593, "ei": 13, "dst": "我还缺那坨粘液。"}, {"si": 593, "ei": 14, "dst": "恶心玩意。"}, {"si": 593, "ei": 15, "dst": "啊,你把东西弄来了。"}, {"si": 593, "ei": 16, "dst": "恶心。"}, {"si": 593, "ei": 17, "dst": "……然后一口闷。"}, {"si": 593, "ei": 18, "dst": "多亏了你,我赢下了那个赌局。"}, {"si": 593, "ei": 19, "dst": "我再也不干了。"}, {"si": 593, "ei": 20, "dst": "嘿,你!你觉得我能赢吗?"}, {"si": 593, "ei": 21, "dst": "赢什么?"}, {"si": 593, "ei": 22, "dst": "我们的比赛。"}, {"si": 593, "ei": 23, "dst": "我必须赢。"}, {"si": 593, "ei": 24, "dst": "我只是不知道行不行。"}, {"si": 593, "ei": 25, "dst": "也许你能帮我?"}, {"si": 593, "ei": 26, "dst": "嘿!你不是想在这里作弊吧?"}, {"si": 593, "ei": 27, "dst": "才怪。"}, {"si": 593, "ei": 28, "dst": "那这人在这里干什么?"}, {"si": 593, "ei": 29, "dst": "呃……"}, {"si": 593, "ei": 30, "dst": "提供心灵辅导。"}, {"si": 593, "ei": 31, "dst": "哦。"}, {"si": 593, "ei": 32, "dst": "能听的忠告都听了吧。你还是赢不了。"}, {"si": 593, "ei": 33, "dst": "好。所以我需要你帮我赢。"}, {"si": 593, "ei": 34, "dst": "加入吗?"}, {"si": 593, "ei": 35, "dst": "别打扰我。"}, {"si": 593, "ei": 36, "dst": "有大事要来了。"}, {"si": 593, "ei": 37, "dst": "我能感觉到。"}, {"si": 593, "ei": 38, "dst": "快了。"}, {"si": 595, "ei": 0, "dst": "我那边那位朋友。他是不是最可爱的?"}, {"si": 595, "ei": 1, "dst": "你说了算。"}, {"si": 595, "ei": 2, "dst": "他只是有点不自信。"}, {"si": 595, "ei": 3, "dst": "你看他,多努力啊。"}, {"si": 595, "ei": 4, "dst": "就等着他打败你吧。"}, {"si": 595, "ei": 5, "dst": "哦,我没打算赢。"}, {"si": 595, "ei": 6, "dst": "我只是想让他开心。"}, {"si": 595, "ei": 7, "dst": "他需要这场胜利。"}, {"si": 595, "ei": 8, "dst": "你刚才不是在激将他吗?"}, {"si": 595, "ei": 9, "dst": "当然。他可不能知道我在帮他。"}, {"si": 595, "ei": 10, "dst": "他请我帮他作弊。"}, {"si": 595, "ei": 11, "dst": "所以?你会帮他吗?"}, {"si": 595, "ei": 12, "dst": "会。"}, {"si": 595, "ei": 13, "dst": "太好了。我相信这场胜利能让他自信一点。"}, {"si": 595, "ei": 14, "dst": "他赢了。至少按他自己的规则算是赢了。"}, {"si": 595, "ei": 15, "dst": "你看到他现在多有自信了吗?"}, {"si": 595, "ei": 16, "dst": "你做得很好。"}, {"si": 597, "ei": 0, "dst": "上面有些结痂的呕吐物。"}, {"si": 599, "ei": 0, "dst": "上一个睡这张床的病人明显有膀胱问题。"}, {"si": 601, "ei": 0, "dst": "好。我准备好了。来吧。"}, {"si": 601, "ei": 1, "dst": "确定?输了可不许哭,对吧?"}, {"si": 601, "ei": 2, "dst": "我不会输。"}, {"si": 601, "ei": 3, "dst": "不错,不错。但看看这个。"}, {"si": 601, "ei": 4, "dst": "跟我差不多嘛,不过那只是热身。看这个,真正的。"}, {"si": 601, "ei": 5, "dst": "量真大。里面怎么还有粉色的东西?"}, {"si": 601, "ei": 6, "dst": "总之。"}, {"si": 601, "ei": 7, "dst": "这远远不够。看看这个。"}, {"si": 601, "ei": 8, "dst": "我吐不动了。我认输。"}, {"si": 601, "ei": 9, "dst": "真的?"}, {"si": 601, "ei": 10, "dst": "真的。"}, {"si": 601, "ei": 11, "dst": "这说明我赢了?"}, {"si": 601, "ei": 12, "dst": "恭喜。"}, {"si": 601, "ei": 13, "dst": "终于。我太高兴了,我简直可以……"}, {"si": 603, "ei": 0, "dst": "这张床好像好几年没人用过了。床单还是干净的。"}, {"si": 605, "ei": 0, "dst": "这肯定是从那些旧设施里搬进来的。"}, {"si": 607, "ei": 0, "dst": "入侵者!"}, {"si": 607, "ei": 1, "dst": "你休想通过。"}, {"si": 607, "ei": 2, "dst": "你是谁?"}, {"si": 607, "ei": 3, "dst": "我曾经是个孩子。现在我是守护者。"}, {"si": 607, "ei": 4, "dst": "离开此地!"}, {"si": 607, "ei": 5, "dst": "[攻击这个生物。]"}, {"si": 607, "ei": 6, "dst": "[尝试压制这个生物的心智。]"}, {"si": 607, "ei": 7, "dst": "你成功压制了这个生物的心智。"}, {"si": 607, "ei": 8, "dst": "血肉尖刺缩了回去,让开了道路。"}, {"si": 607, "ei": 9, "dst": "{生物用空洞的眼神盯着你。}"}, {"si": 609, "ei": 0, "dst": "命令?"}, {"si": 609, "ei": 1, "dst": "列出所有命令。"}, {"si": 609, "ei": 2, "dst": "错误。权限不足。"}, {"si": 609, "ei": 3, "dst": "我有这么一段录像。"}, {"si": 609, "ei": 4, "dst": "检查中……"}, {"si": 609, "ei": 5, "dst": "正在处理录像……"}, {"si": 609, "ei": 6, "dst": "正在处理记录……"}, {"si": 609, "ei": 7, "dst": "录像处理完毕。"}, {"si": 609, "ei": 8, "dst": "谢谢。"}, {"si": 609, "ei": 9, "dst": "这台机器在这个模块里似乎没有激活。"}, {"si": 611, "ei": 0, "dst": "这个入口封死了。"}, {"si": 611, "ei": 1, "dst": "好像有人试图砸开过什么的。"}, {"si": 611, "ei": 2, "dst": "看来是失败了。"}, {"si": 613, "ei": 0, "dst": "哦,这个很大。"}, {"si": 615, "ei": 0, "dst": "嘿,你好。欢迎来到心灵神龛。"}, {"si": 615, "ei": 1, "dst": "请随意参观。"}, {"si": 615, "ei": 2, "dst": "心脏已经不在这里了,但我们为它里面那条蠕虫建了个小花园。"}, {"si": 615, "ei": 3, "dst": "那条蠕虫是我们人民的伟大救星救下来的。"}, {"si": 615, "ei": 4, "dst": "是我。那个救星。"}, {"si": 615, "ei": 5, "dst": "真的吗?哇。"}, {"si": 615, "ei": 6, "dst": "我原本想象你会更有英雄气概一些。"}, {"si": 615, "ei": 7, "dst": "不过这不重要。非常感谢你帮了我们。"}, {"si": 617, "ei": 0, "dst": "欢迎回来。欢迎。"}, {"si": 617, "ei": 1, "dst": "我在找一个女人。"}, {"si": 617, "ei": 2, "dst": "找她。找她。"}, {"si": 617, "ei": 3, "dst": "她要是在这,跟她谈谈。谈谈。"}, {"si": 617, "ei": 4, "dst": "这里是怎么回事?"}, {"si": 617, "ei": 5, "dst": "这些是我们的兄弟姐妹。兄弟姐妹。"}, {"si": 617, "ei": 6, "dst": "主人改良了他们。改良了。"}, {"si": 617, "ei": 7, "dst": "他们从人性中得到了强化。强化了。"}, {"si": 617, "ei": 8, "dst": "他们更好了。更好了。"}, {"si": 617, "ei": 9, "dst": "可他们几乎不能动,也不能说话。"}, {"si": 617, "ei": 10, "dst": "而且这房间这么小。"}, {"si": 617, "ei": 11, "dst": "他们更好了。更好了。"}, {"si": 617, "ei": 12, "dst": "他们不需要空间。不需要说话。不需要。不需要。"}, {"si": 617, "ei": 13, "dst": "主人让他们变得更好了。更好了。"}, {"si": 617, "ei": 14, "dst": "主人是对的。"}, {"si": 617, "ei": 15, "dst": "他永远是对的。永远。"}, {"si": 617, "ei": 16, "dst": "这是不对的。"}, {"si": 617, "ei": 17, "dst": "你是主人的造物。造物。"}, {"si": 617, "ei": 18, "dst": "你既然这么说,那就是对的。是对的。"}, {"si": 617, "ei": 19, "dst": "你应该去那边那个终端看看。那边。"}, {"si": 617, "ei": 20, "dst": "你是谁?谁?"}, {"si": 617, "ei": 21, "dst": "我不认识你的脸。你的脸。"}, {"si": 617, "ei": 22, "dst": "但既然你来了,就欢迎。欢迎。"}, {"si": 617, "ei": 23, "dst": "又一个。又一个。"}, {"si": 617, "ei": 24, "dst": "多么欢喜。欢喜。"}, {"si": 617, "ei": 25, "dst": "请加入。请。"}, {"si": 619, "ei": 0, "dst": "朋友。"}, {"si": 619, "ei": 1, "dst": "寻找朋友。"}, {"si": 619, "ei": 2, "dst": "一起来的。"}, {"si": 619, "ei": 3, "dst": "不见了。"}, {"si": 619, "ei": 4, "dst": "帮忙。"}, {"si": 621, "ei": 0, "dst": "高塔管理终端。"}, {"si": 621, "ei": 1, "dst": "你想做什么?"}, {"si": 621, "ei": 2, "dst": "[释放改造人。]"}, {"si": 621, "ei": 3, "dst": "正在释放所有改造人。"}, {"si": 621, "ei": 4, "dst": "[消灭所有改造人。]"}, {"si": 621, "ei": 5, "dst": "正在杀死所有改造人。"}, {"si": 623, "ei": 0, "dst": "这台机器正在运行。"}, {"si": 623, "ei": 1, "dst": "[取出机器核心。]"}, {"si": 623, "ei": 2, "dst": "警告:检测到未经授权的核心移除。"}, {"si": 623, "ei": 3, "dst": "正在激活高级安全协议。"}, {"si": 623, "ei": 4, "dst": "这台机器缺了一个机器核心。"}, {"si": 623, "ei": 5, "dst": "[插入机器核心]"}, {"si": 623, "ei": 6, "dst": "提示:检测到核心。"}, {"si": 623, "ei": 7, "dst": "高级安全协议已解除。"}, {"si": 625, "ei": 0, "dst": "你做到了。做到了。"}, {"si": 625, "ei": 1, "dst": "不赖。不赖。"}, {"si": 625, "ei": 2, "dst": "圣主在塔顶等你。塔顶。"}, {"si": 625, "ei": 3, "dst": "祝你好运。好运。"}, {"si": 625, "ei": 4, "dst": "我在找一个女人。"}, {"si": 625, "ei": 5, "dst": "很多人来这。来这。"}, {"si": 625, "ei": 6, "dst": "你得去和圣主谈。圣主。"}, {"si": 625, "ei": 7, "dst": "这地方是什么?"}, {"si": 625, "ei": 8, "dst": "是圣主之塔。之塔。"}, {"si": 625, "ei": 9, "dst": "想知道更多就该去和他谈。和他谈。"}, {"si": 625, "ei": 10, "dst": "圣主是仁慈的。仁慈。"}, {"si": 625, "ei": 11, "dst": "你为什么这样说话?"}, {"si": 625, "ei": 12, "dst": "什么意思?什么?"}, {"si": 625, "ei": 13, "dst": "每句话都说两遍。两遍。"}, {"si": 625, "ei": 14, "dst": "我不明白。明白。"}, {"si": 625, "ei": 15, "dst": "我说话很正常。很正常。"}, {"si": 625, "ei": 16, "dst": "我只是为圣主办事。圣主。"}, {"si": 625, "ei": 17, "dst": "没什么不对。没什么不对。"}, {"si": 627, "ei": 1, "dst": "没有。"}, {"si": 629, "ei": 0, "dst": "新兵!"}, {"si": 629, "ei": 1, "dst": "一名新兵来了。"}, {"si": 629, "ei": 2, "dst": "大业正在顺利传播。"}, {"si": 629, "ei": 3, "dst": "但必须先通过一场考验。"}, {"si": 629, "ei": 4, "dst": "毕竟只有最优秀的人,才配得上我的军队。"}, {"si": 631, "ei": 0, "dst": "正在中止灭菌协议。"}, {"si": 633, "ei": 0, "dst": "警告:检测到入侵者。正在执行灭菌协议。"}, {"si": 633, "ei": 1, "dst": "失败:由于机械故障,房间无法隔离。"}, {"si": 635, "ei": 0, "dst": "灭菌流程已完成。"}, {"si": 637, "ei": 0, "dst": "检测到入侵者。正在启动灭菌流程。"}, {"si": 639, "ei": 0, "dst": "灭菌流程已完成。"}, {"si": 641, "ei": 0, "dst": "检测到入侵者。正在启动灭菌流程。"}, {"si": 643, "ei": 0, "dst": "你回来了。回来了。"}, {"si": 643, "ei": 1, "dst": "我在找一个女人。"}, {"si": 643, "ei": 2, "dst": "我可能见过一个。见过一个。"}, {"si": 643, "ei": 3, "dst": "但我现在孤身一人。孤身一人。"}, {"si": 643, "ei": 4, "dst": "这个地方是什么?"}, {"si": 643, "ei": 5, "dst": "是圣主给你的一场考验。"}, {"si": 643, "ei": 6, "dst": "他召集我们,让我们变强。变强。"}, {"si": 643, "ei": 7, "dst": "圣主是伟大的。伟大。"}, {"si": 643, "ei": 8, "dst": "你为什么这样说话?"}, {"si": 643, "ei": 9, "dst": "之前也有人这么问过。问过。"}, {"si": 643, "ei": 10, "dst": "人们这么问是什么意思?什么意思?"}, {"si": 643, "ei": 11, "dst": "我说话很正常。非常正常。"}, {"si": 643, "ei": 12, "dst": "你活下来了?活下来了?"}, {"si": 643, "ei": 13, "dst": "没几个人能。没几个。"}, {"si": 643, "ei": 14, "dst": "你一定是找到了躲开考验的办法。躲开。"}, {"si": 643, "ei": 15, "dst": "这很聪明。