[{"si": 469, "ei": 33, "dst": "恕我直言,我现在帮不了你。"}, {"si": 469, "ei": 34, "dst": "你可以去试试东边泰坦之肠的祭司,运气也许会好些。"}, {"si": 469, "ei": 35, "dst": "祝你的朝圣一切顺利。"}, {"si": 469, "ei": 36, "dst": "东边泰坦之肠的祭司会有进一步的信息给你。"}, {"si": 469, "ei": 37, "dst": "看来泰坦确实保佑了你。"}, {"si": 471, "ei": 0, "dst": "他死了。"}, {"si": 471, "ei": 1, "dst": "你回来了?"}, {"si": 471, "ei": 2, "dst": "你没看见我在受苦吗?"}, {"si": 471, "ei": 3, "dst": "你屠戮了我,毁了我。"}, {"si": 471, "ei": 4, "dst": "你是来炫耀的?还是来折磨我的?"}, {"si": 471, "ei": 5, "dst": "等等……"}, {"si": 471, "ei": 6, "dst": "你看起来不一样。你不是他们的人,对吧?"}, {"si": 471, "ei": 7, "dst": "一定是泰坦派你来的,来完成我最后的心愿。"}, {"si": 471, "ei": 8, "dst": "给,拿着这个,去新德尔斐。"}, {"si": 471, "ei": 9, "dst": "告诉他们,猎神者偷走了心脏。"}, {"si": 471, "ei": 10, "dst": "快去吧,让我安息。"}, {"si": 471, "ei": 11, "dst": "求你,快去新德尔斐。"}, {"si": 473, "ei": 0, "dst": "这是圣地。"}, {"si": 473, "ei": 1, "dst": "供奉泰坦之心的神龛。"}, {"si": 473, "ei": 2, "dst": "如果你想成为泰坦的朝圣者,请去新德尔斐找大祭司。"}, {"si": 475, "ei": 0, "dst": "我做不到。暂时。"}, {"si": 475, "ei": 1, "dst": "我没那个心情。"}, {"si": 475, "ei": 2, "dst": "我吐不出来。"}, {"si": 475, "ei": 3, "dst": "我的胃是空的。"}, {"si": 477, "ei": 0, "dst": "我盯着你呢。"}, {"si": 477, "ei": 1, "dst": "别耍花样。"}, {"si": 477, "ei": 2, "dst": "你想喝多醉都行。"}, {"si": 477, "ei": 3, "dst": "只要把武器收好。"}, {"si": 477, "ei": 4, "dst": "吧台那个哭的家伙怎么回事?"}, {"si": 477, "ei": 5, "dst": "那只是纳德太感情用事了。"}, {"si": 477, "ei": 6, "dst": "他以前养了只宠物血肉蠕虫。叫伊尔娅还是什么的。"}, {"si": 477, "ei": 7, "dst": "但上星期它凑炮塔太近了。"}, {"si": 477, "ei": 8, "dst": "当场被炸成了碎片。"}, {"si": 477, "ei": 9, "dst": "血腥的场面。真的。"}, {"si": 477, "ei": 10, "dst": "但从那以后他就一直在酒吧里。哭。"}, {"si": 477, "ei": 11, "dst": "我不介意。只要他付账。"}, {"si": 479, "ei": 0, "dst": "我昨天喝得太醉,断片了。"}, {"si": 479, "ei": 1, "dst": "还是前天来着?"}, {"si": 479, "ei": 2, "dst": "给你个忠告:永远在最后一杯前停下。"}, {"si": 479, "ei": 3, "dst": "最后一杯总会让你越过界限。"}, {"si": 479, "ei": 4, "dst": "在那之前停住,你就没事。"}, {"si": 479, "ei": 5, "dst": "你知道他们都说喝太多酒伤身吗?"}, {"si": 479, "ei": 6, "dst": "他们错了。"}, {"si": 479, "ei": 7, "dst": "这才是生活。"}, {"si": 479, "ei": 8, "dst": "告诉我,你幸福吗?"}, {"si": 479, "ei": 9, "dst": "不太幸福。"}, {"si": 479, "ei": 10, "dst": "那你也许需要好好吐一场。"}, {"si": 479, "ei": 11, "dst": "把所有糟心的事都吐出来。"}, {"si": 479, "ei": 12, "dst": "幸福。"}, {"si": 479, "ei": 13, "dst": "这就是我说的。"}, {"si": 479, "ei": 14, "dst": "酒。"}, {"si": 479, "ei": 15, "dst": "什么?"}, {"si": 479, "ei": 16, "dst": "你可真没劲。"}, {"si": 479, "ei": 17, "dst": "酒?"}, {"si": 479, "ei": 18, "dst": "酒!"}, {"si": 479, "ei": 19, "dst": "酒!"}, {"si": 479, "ei": 20, "dst": "酒————。"}, {"si": 479, "ei": 21, "dst": "酒!"}, {"si": 479, "ei": 22, "dst": "哈哈哈哈哈。"}, {"si": 479, "ei": 24, "dst": "呼。"}, {"si": 479, "ei": 25, "dst": "你们是双胞胎吗?"}, {"si": 479, "ei": 26, "dst": "不对等等,你们有三个。"}, {"si": 479, "ei": 27, "dst": "我肯定没醉。"}, {"si": 479, "ei": 28, "dst": "看,我还能走直线。"}, {"si": 479, "ei": 29, "dst": "好吧。也许走不了。"}, {"si": 479, "ei": 30, "dst": "我已经旅行好长时间了。"}, {"si": 479, "ei": 31, "dst": "呕吐酒吧就是完美的歇脚点。"}, {"si": 479, "ei": 32, "dst": "想知道我为什么喝醉吗?"}, {"si": 479, "ei": 33, "dst": "不太想。"}, {"si": 479, "ei": 34, "dst": "你说得对,那是浪费时间。"}, {"si": 479, "ei": 35, "dst": "更多酒!"}, {"si": 479, "ei": 36, "dst": "说吧。"}, {"si": 479, "ei": 37, "dst": "酒精。"}, {"si": 479, "ei": 38, "dst": "你有酒要分享吗?"}, {"si": 479, "ei": 39, "dst": "不是给你这种人的。"}, {"si": 479, "ei": 40, "dst": "是是是。你也去他妈的吧。"}, {"si": 479, "ei": 41, "dst": "没什么。抱歉。"}, {"si": 479, "ei": 42, "dst": "扫兴。"}, {"si": 479, "ei": 43, "dst": "再不小心点,我很快就要清醒了。"}, {"si": 479, "ei": 44, "dst": "当然。"}, {"si": 479, "ei": 45, "dst": "老兄,你是最棒的。"}, {"si": 479, "ei": 46, "dst": "这里的肉……"}, {"si": 479, "ei": 47, "dst": "最近吃起来乏味得很。"}, {"si": 479, "ei": 48, "dst": "我不知道他们对这些肉做了什么。"}, {"si": 479, "ei": 49, "dst": "味道就是不一样了。"}, {"si": 479, "ei": 50, "dst": "你,我,那边那个房间。意下如何?"}, {"si": 479, "ei": 51, "dst": "我大概不该去。"}, {"si": 479, "ei": 52, "dst": "那些机器人跟我说过会被消灭什么的。"}, {"si": 479, "ei": 53, "dst": "切。你信他们?"}, {"si": 479, "ei": 54, "dst": "跟我来嘛。会很棒的。"}, {"si": 479, "ei": 55, "dst": "不行。"}, {"si": 479, "ei": 56, "dst": "扫兴。"}, {"si": 479, "ei": 57, "dst": "去他的。来吧。"}, {"si": 479, "ei": 58, "dst": "你真好看。"}, {"si": 479, "ei": 59, "dst": "给,拿着。我请客。"}, {"si": 479, "ei": 60, "dst": "哇哦。你醉了。"}, {"si": 479, "ei": 61, "dst": "跟我一样。"}, {"si": 481, "ei": 0, "dst": "你,我,那边那个房间。意下如何?"}, {"si": 481, "ei": 1, "dst": "现在不行,抱歉。"}, {"si": 481, "ei": 2, "dst": "但你看到吧台那边那个哭哭啼啼的家伙了吗?"}, {"si": 481, "ei": 3, "dst": "你是说纳德?"}, {"si": 481, "ei": 4, "dst": "不如你去陪陪他?"}, {"si": 481, "ei": 5, "dst": "想得美。我要找乐子。他看起来一点都不好玩。"}, {"si": 481, "ei": 6, "dst": "你看看他。你怎么能这么没心没肺?"}, {"si": 481, "ei": 7, "dst": "好啦。好啦。明白了。"}, {"si": 481, "ei": 8, "dst": "我去照顾他。暂时。"}, {"si": 481, "ei": 9, "dst": "但你得正式给我们引荐一下。"}, {"si": 481, "ei": 10, "dst": "要我改变主意,得给我什么?"}, {"si": 481, "ei": 11, "dst": "你把我当什么人了?"}, {"si": 481, "ei": 12, "dst": "人人都有个价。"}, {"si": 481, "ei": 13, "dst": "100 金。"}, {"si": 481, "ei": 14, "dst": "太贵了。"}, {"si": 481, "ei": 15, "dst": "那我不帮了。"}, {"si": 481, "ei": 16, "dst": "成交。"}, {"si": 481, "ei": 17, "dst": "我只是现在没那么多。"}, {"si": 481, "ei": 18, "dst": "那就等钱够了再来。"}, {"si": 481, "ei": 19, "dst": "我给你 60。"}, {"si": 481, "ei": 20, "dst": "滚开。我可没那么便宜。"}, {"si": 481, "ei": 21, "dst": "我给你 60。"}, {"si": 481, "ei": 22, "dst": "这还差不多。"}, {"si": 481, "ei": 23, "dst": "我只是现在没那么多。"}, {"si": 481, "ei": 24, "dst": "跟我讨价还价,又舍不得付钱。"}, {"si": 481, "ei": 25, "dst": "你可真不聪明。"}, {"si": 481, "ei": 26, "dst": "怎么了?"}, {"si": 481, "ei": 27, "dst": "你认识吧台那个哭的家伙吗?"}, {"si": 481, "ei": 28, "dst": "纳德?他已经哭了好几个星期了。"}, {"si": 481, "ei": 29, "dst": "真希望我也能喝得跟他一样多。"}, {"si": 481, "ei": 30, "dst": "他在哭什么?"}, {"si": 481, "ei": 31, "dst": "一个叫米尔娅的还是什么的人。"}, {"si": 481, "ei": 32, "dst": "不知道那是谁。"}, {"si": 481, "ei": 33, "dst": "从没见过。"}, {"si": 481, "ei": 34, "dst": "守卫们也许知道得更多。"}, {"si": 481, "ei": 35, "dst": "好了,酒在哪?"}, {"si": 481, "ei": 36, "dst": "别打扰我们。我们正沉浸在这氛围里。"}, {"si": 481, "ei": 37, "dst": "对。别打扰我们!"}, {"si": 483, "ei": 0, "dst": "你好!"}, {"si": 485, "ei": 0, "dst": "挤一挤的话,这上面能坐两个人。"}, {"si": 487, "ei": 0, "dst": "好像有人忘了冲水。"}, {"si": 489, "ei": 0, "dst": "哦。只是些\"玩具\"。"}, {"si": 489, "ei": 1, "dst": "别碰那个衣柜!"}, {"si": 491, "ei": 0, "dst": "看来酒吧在这里囤了不少肉。"}, {"si": 491, "ei": 1, "dst": "我猜这一带的人也会饿嘛。"}, {"si": 491, "ei": 2, "dst": "这些肉被血肉蛆感染了。"}, {"si": 491, "ei": 3, "dst": "但现在没有蛆了。"}, {"si": 491, "ei": 4, "dst": "这些肯定就是埃尔德雷德说的血肉蛆。"}, {"si": 491, "ei": 5, "dst": "看来我可以去弄那个毒药了。"}, {"si": 491, "ei": 6, "dst": "来吧。"}, {"si": 491, "ei": 7, "dst": "把它洒得到处都是。"}, {"si": 491, "ei": 8, "dst": "再见吧,蛆虫!"}, {"si": 491, "ei": 9, "dst": "好。回酒保那去。"}, {"si": 493, "ei": 0, "dst": "你好。希望你在呕吐酒吧住得愉快。"}, {"si": 495, "ei": 0, "dst": "搞什么鬼?"}, {"si": 495, "ei": 1, "dst": "我没看到你从楼梯上来,那你一定是溜进来的。"}, {"si": 495, "ei": 2, "dst": "别到处鬼鬼祟祟的,好吗?"}, {"si": 495, "ei": 3, "dst": "我们喜欢这里平平安安的。"}, {"si": 497, "ei": 0, "dst": "你好,欢迎来到呕吐酒吧!"}, {"si": 497, "ei": 1, "dst": "最好的酒。最好的肉。还需要什么?"}, {"si": 497, "ei": 2, "dst": "友善点,别讨人嫌,注意脚下。"}, {"si": 497, "ei": 3, "dst": "还有,这条很重要:在里面别明着携带武器。"}, {"si": 497, "ei": 4, "dst": "我们要的是太平。"}, {"si": 497, "ei": 5, "dst": "我不管什么太平。"}, {"si": 497, "ei": 6, "dst": "行。那你就待在外面。"}, {"si": 497, "ei": 7, "dst": "里面的人神经紧绷。他们看到你手里有武器就会开枪。"}, {"si": 497, "ei": 8, "dst": "我的武器想去哪就去哪带着。"}, {"si": 497, "ei": 9, "dst": "好。我会照办。"}, {"si": 497, "ei": 10, "dst": "好。在里面别拔武器。大家神经紧绷。"}, {"si": 497, "ei": 11, "dst": "离我他妈远点。"}, {"si": 497, "ei": 12, "dst": "还有,这条很重要:把武器收起来。"}, {"si": 499, "ei": 0, "dst": "这是艺术吧,我猜?"}, {"si": 501, "ei": 0, "dst": "寻找「屠夫切肉」"}, {"si": 501, "ei": 1, "dst": "回到猎人身边"}, {"si": 501, "ei": 2, "dst": "一块好肉"}, {"si": 503, "ei": 0, "dst": "进入艺术家的模块"}, {"si": 503, "ei": 1, "dst": "帮助缪斯释放她的潜能"}, {"si": 503, "ei": 2, "dst": "缪斯与往昔之魂"}, {"si": 505, "ei": 0, "dst": "向收藏者献上一段动人的记忆"}, {"si": 505, "ei": 1, "dst": "献上记忆"}, {"si": 507, "ei": 0, "dst": "为总管取得母亲的核心印记"}, {"si": 507, "ei": 1, "dst": "拿到核心印记"}, {"si": 507, "ei": 2, "dst": "母亲的核心印记"}, {"si": 509, "ei": 0, "dst": "获得精致的滋味"}, {"si": 509, "ei": 1, "dst": "弄到一块肉或一段记忆"}, {"si": 509, "ei": 2, "dst": "寻找滋味行家"}, {"si": 509, "ei": 3, "dst": "后天养成的品味"}, {"si": 511, "ei": 0, "dst": "探索城市"}, {"si": 511, "ei": 1, "dst": "