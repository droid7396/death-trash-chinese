[{"si": 391, "ei": 0, "dst": "有时我在想:到底总是我对,还是别人总是错?"}, {"si": 391, "ei": 1, "dst": "你想过血肉泰坦是从哪来的吗?"}, {"si": 391, "ei": 2, "dst": "嘿,你看起来真性感。"}, {"si": 391, "ei": 3, "dst": "别听那个历史学家的。"}, {"si": 391, "ei": 4, "dst": "这地方是神圣的。管好你他妈的嘴。"}, {"si": 391, "ei": 5, "dst": "我们就像一个血肉相连的大家庭。"}, {"si": 391, "ei": 6, "dst": "我最近遇到了一个机器的追随者。真是个白痴。"}, {"si": 391, "ei": 7, "dst": "你惹了我们中的一个,就是惹了我们全体。"}, {"si": 391, "ei": 8, "dst": "血肉泰坦就像我们的兄弟姐妹。是我们的父与母。也是我们的主人。"}, {"si": 391, "ei": 9, "dst": "大祭司是个智者。"}, {"si": 391, "ei": 10, "dst": "很多人来这里找大祭司谈话。"}, {"si": 393, "ei": 0, "dst": "泰坦保佑你,我的孩子。"}, {"si": 393, "ei": 1, "dst": "什么?"}, {"si": 393, "ei": 2, "dst": "血肉泰坦。"}, {"si": 393, "ei": 3, "dst": "这些地方的主人。"}, {"si": 393, "ei": 4, "dst": "我们的主人。"}, {"si": 393, "ei": 5, "dst": "你是谁,竟然不知道他们?"}, {"si": 393, "ei": 6, "dst": "我不会告诉你。"}, {"si": 393, "ei": 7, "dst": "多么离经叛道。"}, {"si": 393, "ei": 8, "dst": "但如果这是泰坦给我的考验,我会坚持到底。"}, {"si": 393, "ei": 9, "dst": "无名之辈。"}, {"si": 393, "ei": 10, "dst": "多么谦卑。"}, {"si": 393, "ei": 11, "dst": "你一定是被他们保佑着,哪怕你自己不知道。"}, {"si": 393, "ei": 12, "dst": "**forename**。"}, {"si": 393, "ei": 13, "dst": "很好。很高兴认识你。"}, {"si": 393, "ei": 14, "dst": "我不需要他们的保佑。"}, {"si": 393, "ei": 15, "dst": "一个迷失的灵魂。"}, {"si": 393, "ei": 16, "dst": "我怜悯你。"}, {"si": 393, "ei": 17, "dst": "但你还没有被抛弃。"}, {"si": 393, "ei": 18, "dst": "让我帮你找到回归羊群的路。"}, {"si": 393, "ei": 19, "dst": "你是谁?"}, {"si": 393, "ei": 20, "dst": "我不会告诉你。"}, {"si": 393, "ei": 21, "dst": "多么离经叛道。"}, {"si": 393, "ei": 22, "dst": "但如果这是泰坦给我的考验,我会坚持到底。"}, {"si": 393, "ei": 23, "dst": "无名之辈。"}, {"si": 393, "ei": 24, "dst": "至少你还有自知之明。"}, {"si": 393, "ei": 25, "dst": "**forename**。"}, {"si": 393, "ei": 26, "dst": "很好。很高兴认识你。"}, {"si": 393, "ei": 27, "dst": "泰坦?就像那个血肉海妖?"}, {"si": 393, "ei": 28, "dst": "你见过他们中的一位?"}, {"si": 393, "ei": 29, "dst": "多么幸运。"}, {"si": 393, "ei": 30, "dst": "你是谁,受祝福的人?"}, {"si": 393, "ei": 31, "dst": "无名之辈。"}, {"si": 393, "ei": 32, "dst": "我看到了一颗谦卑的灵魂。"}, {"si": 393, "ei": 33, "dst": "**forename**。"}, {"si": 393, "ei": 34, "dst": "很好。很高兴认识你。"}, {"si": 393, "ei": 35, "dst": "谢谢,大概吧。"}, {"si": 393, "ei": 36, "dst": "你看起来不太虔诚。"}, {"si": 393, "ei": 37, "dst": "你可能是谁?"}, {"si": 393, "ei": 38, "dst": "无名之辈。"}, {"si": 393, "ei": 39, "dst": "我看到了一颗谦卑的灵魂。"}, {"si": 393, "ei": 40, "dst": "你最好对泰坦表现出更多敬意。"}, {"si": 393, "ei": 41, "dst": "我会的。"}, {"si": 393, "ei": 42, "dst": "很好。"}, {"si": 393, "ei": 43, "dst": "我一直都敬着。"}, {"si": 393, "ei": 44, "dst": "但你看起来不像泰坦。"}, {"si": 393, "ei": 45, "dst": "说得有理。"}, {"si": 393, "ei": 46, "dst": "我为什么要敬?"}, {"si": 393, "ei": 47, "dst": "泰坦是未来生命的证明。"}, {"si": 393, "ei": 48, "dst": "他们走过的地方,土壤受到祝福。"}, {"si": 393, "ei": 49, "dst": "并赐予我们每日的肉食。"}, {"si": 393, "ei": 50, "dst": "**forename**。"}, {"si": 393, "ei": 51, "dst": "很好。很高兴认识你。"}, {"si": 395, "ei": 0, "dst": "还不行。"}, {"si": 395, "ei": 1, "dst": "出事了。"}, {"si": 395, "ei": 2, "dst": "泰坦的心脏被偷走了,守护它的祭司也被杀了。"}, {"si": 395, "ei": 3, "dst": "据推测是猎神者干的。"}, {"si": 395, "ei": 4, "dst": "在这件事解决之前,我没有状态与你同行。"}, {"si": 395, "ei": 5, "dst": "哦。明白了。"}, {"si": 395, "ei": 6, "dst": "祝你好运。"}, {"si": 395, "ei": 7, "dst": "泰坦保佑我们。"}, {"si": 395, "ei": 8, "dst": "也许我能帮忙?"}, {"si": 395, "ei": 9, "dst": "也许这正是泰坦从一开始就为你安排的任务。"}, {"si": 395, "ei": 10, "dst": "我会派你去找回那颗心脏。"}, {"si": 395, "ei": 11, "dst": "但它太大了,就算是你的身板也拿不动。"}, {"si": 395, "ei": 12, "dst": "那我该怎么做?"}, {"si": 395, "ei": 13, "dst": "不用担心。"}, {"si": 395, "ei": 14, "dst": "在它心中,你会找到一粒泰坦之种。"}, {"si": 395, "ei": 15, "dst": "那不是它的孩子,而是它的源头。"}, {"si": 395, "ei": 16, "dst": "把它带给我,它就会重归昔日的荣光。"}, {"si": 395, "ei": 17, "dst": "好。明白了。"}, {"si": 395, "ei": 18, "dst": "我这就出发。"}, {"si": 395, "ei": 19, "dst": "拿着这个。它会帮你的。"}, {"si": 395, "ei": 20, "dst": "那我去哪找那颗心脏?"}, {"si": 395, "ei": 21, "dst": "你应该试试北边的猎神者监狱。"}, {"si": 395, "ei": 22, "dst": "但小心。进去可不是没有危险的。"}, {"si": 395, "ei": 23, "dst": "就算你已经向泰坦证明了自己。"}, {"si": 395, "ei": 24, "dst": "你是一个真正的信徒。"}, {"si": 395, "ei": 25, "dst": "你确实受到泰坦的保佑。"}, {"si": 395, "ei": 26, "dst": "他们一定是派你来的,早就知道会发生这种事。"}, {"si": 395, "ei": 27, "dst": "我们核实了你的报告,很遗憾,看来是真的。"}, {"si": 395, "ei": 28, "dst": "差不多。只是出了件相当令人担忧的事。"}, {"si": 395, "ei": 29, "dst": "它让我们焦头烂额。"}, {"si": 395, "ei": 30, "dst": "我回来了。"}, {"si": 395, "ei": 31, "dst": "和我们听说的一样。"}, {"si": 395, "ei": 32, "dst": "心灵祭司被杀,还被肢解了。"}, {"si": 395, "ei": 33, "dst": "他的血溅得到处都是。"}, {"si": 395, "ei": 34, "dst": "他挣扎着爬远了一点。但太迟了。"}, {"si": 395, "ei": 35, "dst": "猎神者?"}, {"si": 395, "ei": 36, "dst": "猎神者。"}, {"si": 395, "ei": 37, "dst": "该死!"}, {"si": 395, "ei": 38, "dst": "嗯。"}, {"si": 395, "ei": 39, "dst": "他们还偷走了心脏。"}, {"si": 395, "ei": 40, "dst": "该死……"}, {"si": 395, "ei": 41, "dst": "你做得很好。谢谢你。"}, {"si": 395, "ei": 42, "dst": "我很抱歉。"}, {"si": 395, "ei": 43, "dst": "你只能等这团乱麻理清之后了。"}, {"si": 395, "ei": 44, "dst": "心灵祭司是在基座前被杀害的。"}, {"si": 395, "ei": 45, "dst": "凶手还拿走了他的随身物品。"}, {"si": 395, "ei": 46, "dst": "但看起来不像是猎神者干的。"}, {"si": 395, "ei": 47, "dst": "不是猎神者?"}, {"si": 395, "ei": 48, "dst": "不。他们至少会炫耀尸体。"}, {"si": 395, "ei": 49, "dst": "这次的手法要干脆得多。"}, {"si": 395, "ei": 50, "dst": "那心脏……?"}, {"si": 395, "ei": 51, "dst": "没了。"}, {"si": 395, "ei": 52, "dst": "没有祭司看守,猎神者一定是趁乱下手抢走的。"}, {"si": 395, "ei": 53, "dst": "太可怕了。"}, {"si": 395, "ei": 54, "dst": "差不多。我们还在调查心灵祭司的事。"}, {"si": 395, "ei": 55, "dst": "我很抱歉,泰坦之心已经被偷走了。"}, {"si": 397, "ei": 0, "dst": "我都不知道从何说起。"}, {"si": 397, "ei": 1, "dst": "对,对。"}, {"si": 397, "ei": 2, "dst": "给,拿着这个。也许能帮上忙。"}, {"si": 397, "ei": 3, "dst": "这是什么?"}, {"si": 397, "ei": 4, "dst": "它能让你进入猎神者监狱。"}, {"si": 397, "ei": 5, "dst": "小心。那是个危险的地方。"}, {"si": 397, "ei": 7, "dst": "泰坦宽恕我。"}, {"si": 397, "ei": 8, "dst": "我本想给你猎神者监狱的钥匙。"}, {"si": 397, "ei": 9, "dst": "但它似乎已不在我身上。"}, {"si": 397, "ei": 10, "dst": "这一定是泰坦要给你多设一道考验。"}, {"si": 397, "ei": 11, "dst": "那我该怎么办?"}, {"si": 397, "ei": 12, "dst": "我把猎神者监狱的钥匙给过你。"}, {"si": 397, "ei": 13, "dst": "你应该从那里找起。"}, {"si": 397, "ei": 14, "dst": "猎神者监狱对我来说太危险了。"}, {"si": 397, "ei": 15, "dst": "泰坦在注视着你。"}, {"si": 397, "ei": 16, "dst": "我确信你会成功。"}, {"si": 397, "ei": 17, "dst": "在这里。"}, {"si": 397, "ei": 18, "dst": "你做到了。"}, {"si": 397, "ei": 19, "dst": "了不起。"}, {"si": 397, "ei": 20, "dst": "你一定是被泰坦选中的圣人。"}, {"si": 397, "ei": 21, "dst": "请把种子交给我。"}, {"si": 397, "ei": 22, "dst": "我们会把它送回属于它的地方。"}, {"si": 399, "ei": 0, "dst": "见到你太好了,我有话要跟你说。"}, {"si": 399, "ei": 1, "dst": "你记得我说过不能和你分享此地的秘密吗?"}, {"si": 399, "ei": 2, "dst": "唉,惭愧,结果是我干了蠢事。"}, {"si": 399, "ei": 3, "dst": "钥匙一直在我另一个口袋里,我只是忘了查。"}, {"si": 399, "ei": 4, "dst": "我深表歉意。"}, {"si": 399, "ei": 5, "dst": "拿着这个,亲眼看看这地方曾经的模样吧。"}, {"si": 399, "ei": 6, "dst": "哦,受祝福的人,我有话要跟你说。"}, {"si": 399, "ei": 7, "dst": "哦 **forename**,我有话要跟你说。"}, {"si": 399, "ei": 8, "dst": "你想聊什么?"}, {"si": 399, "ei": 9, "dst": "这个地方是什么?"}, {"si": 399, "ei": 10, "dst": "我们站在新德尔斐的神圣遗迹之中。"}, {"si": 399, "ei": 11, "dst": "此地如此古老,就连下面小屋里的历史学家都难以参透。"}, {"si": 399, "ei": 12, "dst": "但即便如此,唯一重要的历史只有沉睡者的历史。"}, {"si": 399, "ei": 13, "dst": "他选择了这里作为长眠之地。"}, {"si": 399, "ei": 14, "dst": "于是我们聚在他的周围,向他祈祷。"}, {"si": 399, "ei": 15, "dst": "愿他保佑我们。"}, {"si": 399, "ei": 16, "dst": "还有别的想听的吗?"}, {"si": 399, "ei": 17, "dst": "你是谁?"}, {"si": 399, "ei": 18, "dst": "我是新德尔斐的大祭司。"}, {"si": 399, "ei": 19, "dst": "我传达泰坦的意志。"}, {"si": 399, "ei": 20, "dst": "并担任泰坦与所有其他人之间的桥梁。"}, {"si": 399, "ei": 21, "dst": "因此,我早已舍弃了自己的身份。"}, {"si": 399, "ei": 22, "dst": "如今我只是一具承载主人们的容器。"}, {"si": 399, "ei": 23, "dst": "赞美血肉。"}, {"si": 399, "ei": 24, "dst": "显然,关于这个地方你藏着什么。"}, {"si": 399, "ei": 25, "dst": "告诉我新德尔斐的秘密。"}, {"si": 399, "ei": 26, "dst": "我听说成为朝圣者什么的?"}, {"si": 399, "ei": 27, "dst": "你想向主人们证明你的虔诚,对吧?"}, {"si": 399, "ei": 28, "dst": "关于我的朝圣……"}, {"si": 399, "ei": 29, "dst": "泰坦之心的祭司被杀了。"}, {"si": 399, "ei": 30, "dst": "我们现在准备好了吗?"}, {"si": 399, "ei": 31, "dst": "关于那粒种子……"}, {"si": 399, "ei": 32, "dst": "我找到了种子。"}, {"si": 399, "ei": 33, "dst": "你之前不肯告诉我的秘密是什么?"}, {"si": 399, "ei": 34, "dst": "我现在证明自己的价值了吗?"}, {"si": 399, "ei": 35, "dst": "还差最后一步。"}, {"si": 399, "ei": 36, "dst": "去向沉睡者祈祷吧。"}, {"si": 399, "ei": 37, "dst": "你要我做的事是什么来着?"}, {"si": 399, "ei": 38, "dst": "那是你成为真正信徒之路的最后一步。"}, {"si": 399, "ei": 39, "dst": "去向沉睡者祈祷吧。"}, {"si": 399, "ei": 40, "dst": "我做完祈祷了。"}, {"si": 399, "ei": 41, "dst": "做得好。"}, {"si": 399, "ei": 42, "dst": "你已经充分证明了自己。"}, {"si": 399, "ei": 43, "dst": "拿着这个,并安心记住:泰坦爱你,一如你爱他们。"}, {"si": 399, "ei": 44, "dst": "受祝福的人!"}, {"si": 399, "ei": 45, "dst": "真荣幸又见到你,**forename**。"}, {"si": 401, "ei": 0, "dst": "不久前,我们发现了一头泰坦的遗体。"}, {"si": 401, "ei": 1, "dst": "我们将它分解,把各部分供奉在各处。"}, {"si": 401, "ei": 2, "dst": "好让各地的人们都能见证泰坦荣耀的奇观。"}, {"si": 401, "ei": 3, "dst": "去朝圣吧,去见颅之神龛、肠之神龛与心之神龛的守护者。"}, {"si": 401, "ei": 4, "dst": "向他们证明自己,他们会给你一枚认可印记。"}, {"si": 401, "ei": 5, "dst": "你准备好接受这个任务了吗?"}, {"si": 401, "ei": 6, "dst": "不。听着太麻烦了。"}, {"si": 401, "ei": 7, "dst": "我就知道这是你的回答。"}, {"si": 401, "ei": 8, "dst": "等你愿意证明虔诚的时候再来找我。"}, {"si": 401, "ei": 9, "dst": "当然!"}, {"si": 401, "ei": 10, "dst": "好。"}, {"si": 401, "ei": 11, "dst": "第一座神龛,泰坦之颅,在这南边的山里。"}, {"si": 401, "ei": 12, "dst": "我天生就准备好了。"}, {"si": 401, "ei": 13, "dst": "你是说这些印记?"}, {"si": 401, "ei": 14, "dst": "你已经收集齐了?"}, {"si": 401, "ei": 15, "dst": "太好了。"}, {"si": 401, "ei": 16, "dst": "我没有料到。"}, {"si": 401, "ei": 17, "dst": "你一定是被泰坦保佑了。"}, {"si": 401, "ei": 18, "dst": "虽然这确实出乎意料。"}, {"si": 401, "ei": 19, "dst": "我需要准备一些东西。"}, {"si": 401, "ei": 20, "dst": "等你下次来新德尔斐我们再谈。"}, {"si": 401, "ei": 21, "dst": "你真的受着祝福。"}, {"si": 403, "ei": 0, "dst": "你还没有获得第一枚印记,在泰坦之颅。"}, {"si": 403, "ei": 1, "dst": "第二枚印记要在泰坦之肠获得,在这东南边。"}, {"si": 403, "ei": 2, "dst": "最后一枚印记可以在泰坦之心拿到。"}, {"si": 403, "ei": 3, "dst": "从这里往东走就能找到。"}, {"si": 403, "ei": 4, "dst": "你回来了。"}, {"si": 403, "ei": 5, "dst": "而且看起来很成功。"}, {"si": 403, "ei": 6, "dst": "我能感觉到泰坦在你体内生长。"}, {"si": 403, "ei": 7, "dst": "但在继续之前,我需要准备一些东西。"}, {"si": 403, "ei": 8, "dst": "等你下次来新德尔斐我们再谈。"}, {"si": 405, "ei": 0, "dst": "发生了什么?"}, {"si": 405, "ei": 1, "dst": "全都告诉我!"}, {"si": 405, "ei": 2, "dst": "他被肢解了,血溅得到处都是。"}, {"si": 405, "ei": 3, "dst": "他已经死了,但临死前提到了猎神者。"}, {"si": 405, "ei": 4, "dst": "猎神者?"}, {"si": 405, "ei": 5, "dst": "这可不得了。"}, {"si": 405, "ei": 6, "dst": "你,那边那位!"}, {"si": 405, "ei": 7, "dst": "怎么?"}, {"si": 405, "ei": 8, "dst": "去泰坦之心查看那边的情况!"}, {"si": 405, "ei": 9, "dst": "啊,靠。"}, {"si": 405, "ei": 10, "dst": "我这份清闲的守卫工作泡汤了。"}, {"si": 405, "ei": 11, "dst": "你说什么?"}, {"si": 405, "ei": 12, "dst": "不不不。"}, {"si": 405, "ei": 13, "dst": "这就去,这就去。"}, {"si": 405, "ei": 14, "dst": "非常感谢你告诉我们这件事。"}, {"si": 405, "ei": 15, "dst": "这确实是坏消息。"}, {"si": 407, "ei": 0, "dst": "那个历史学家又多嘴了?"}, {"si": 407, "ei": 1, "dst": "我警告过他管好自己的嘴。"}, {"si": 407, "ei": 2, "dst": "请别插手这件事。"}, {"si": 407, "ei": 3, "dst": "我们这样讲述这段历史是有充分理由的。"}, {"si": 407, "ei": 4, "dst": "好吧。你不必告诉我。"}, {"si": 407, "ei": 5, "dst": "啊,你通情达理,很好。"}, {"si": 407, "ei": 6, "dst": "祝你愉快。"}, {"si": 407, "ei": 7, "dst": "我坚持。告诉我!"}, {"si": 407, "ei": 8, "dst": "我看跟你争论不值得。"}, {"si": 407, "ei": 9, "dst": "但你得先证明你对泰坦的虔诚。"}, {"si": 407, "ei": 10, "dst": "没门。"}, {"si": 407, "ei": 11, "dst": "反正多半也不值得。"}, {"si": 407, "ei": 12, "dst": "我就知道这是你的回答。"}, {"si": 407, "ei": 13, "dst": "等你愿意证明虔诚的时候再来找我。"}, {"si": 407, "ei": 14, "dst": "好吧。"}, {"si": 407, "ei": 15, "dst": "我需要做什么?"}, {"si": 407, "ei": 16, "dst": "完成朝圣考验的最后几步,证明你的虔诚,我们或许可以再谈。"}, {"si": 407, "ei": 17, "dst": "完成你的朝圣,我们或许可以再谈这件事。"}, {"si": 407, "ei": 18, "dst": "但我正忙着处理泰坦之心的局势。"}, {"si": 407, "ei": 19, "dst": "等这事结束再来问我。"}, {"si": 407, "ei": 20, "dst": "但你得先完成对泰坦虔诚的证明。"}, {"si": 407, "ei": 21, "dst": "而这,当然,只能等我为最后一步做好准备之后。"}, {"si": 407, "ei": 22, "dst": "所以在那之前请保持耐心。"}, {"si": 407, "ei": 23, "dst": "你得先证明虔诚,我才会开口。"}, {"si": 407, "ei": 24, "dst": "等你完成成为真正信徒的最后一步之后,再来问我。"}, {"si": 407, "ei": 25, "dst": "你得先证明虔诚,我才会开口。"}, {"si": 407, "ei": 26, "dst": "很抱歉,我们仍在为泰坦之心的变故忧心。"}, {"si": 407, "ei": 27, "dst": "我现在无暇顾及此事。"}, {"si": 409, "ei": 0, "dst": "终于到了这一步。"}, {"si": 409, "ei": 1, "dst": "我本不愿如此,但你已经证明自己绰绰有余。"}, {"si": 409, "ei": 2, "dst": "无论我多么希望这仍是一个秘密。"}, {"si": 409, "ei": 3, "dst": "我曾背负着下方那扇门的钥匙。"}, {"si": 409, "ei": 4, "dst": "门后是这个地方往昔的残迹。"}, {"si": 409, "ei": 5, "dst": "但泰坦听到了我的祈祷,卸下了我这副重担。"}, {"si": 409, "ei": 6, "dst": "钥匙不见了。"}, {"si": 409, "ei": 7, "dst": "随之而去的,还有我向你揭示秘密的能力。"}, {"si": 409, "ei": 8, "dst": "随之而去的,还有我向你揭示答案的能力。"}, {"si": 409, "ei": 9, "dst": "给,拿着这个,穿过下面那扇门。"}, {"si": 409, "ei": 10, "dst": "亲身感受这地方曾经是什么吧。"}, {"si": 409, "ei": 11, "dst": "哦,我多么希望你别问。"}, {"si": 409, "ei": 12, "dst": "终于到了这一步。"}, {"si": 409, "ei": 13, "dst": "我曾希望把你打发走,就不用告诉你了。"}, {"si": 411, "ei": 1, "dst": "喂?"}, {"si": 411, "ei": 2, "dst": "你还有兴趣跟我说话?"}, {"si": 411, "ei": 3, "dst": "真让人兴奋。"}, {"si": 411, "ei": 4, "dst": "你需要什么?"}, {"si": 411, "ei": 5, "dst": "其他人为什么不跟你说话?"}, {"si": 411, "ei": 6, "dst": "哦,不知道。"}, {"si": 411, "ei": 7, "dst": "其他人,他们更关心那些仪式什么的。"}, {"si": 411, "ei": 8, "dst": "而不是我们社群真正赖以建立的故事。"}, {"si": 411, "ei": 9, "dst": "大概我让他们觉得无聊了吧。"}, {"si": 411, "ei": 10, "dst": "除了大祭司,也许。"}, {"si": 411, "ei": 11, "dst": "虽然我们在很多事上意见不合,但他一直对我很好。"}, {"si": 411, "ei": 12, "dst": "还有别的事吗?"}, {"si": 411, "ei": 13, "dst": "这个地方真实历史是怎么回事?"}, {"si": 411, "ei": 14, "dst": "不不不。"}, {"si": 411, "ei": 15, "dst": "大祭司叫我别谈这个。"}, {"si": 411, "ei": 16, "dst": "这里只是一个比大流血还古老的遗迹。"}, {"si": 411, "ei": 17, "dst": "沉睡者选中了这里的一处水池作为他的长眠之地。"}, {"si": 411, "ei": 18, "dst": "没有别的了。"}, {"si": 411, "ei": 19, "dst": "所以别再问我这个了。"}, {"si": 411, "ei": 20, "dst": "沉睡者是谁?"}, {"si": 411, "ei": 21, "dst": "血肉泰坦之一。"}, {"si": 411, "ei": 22, "dst": "据说他曾在这一带的沙漠中游荡。"}, {"si": 411, "ei": 23, "dst": "但有一天他决定在池水中休眠。"}, {"si": 411, "ei": 24, "dst": "于是新德尔斐成了圣地。"}, {"si": 411, "ei": 25, "dst": "朝圣者来这里向他祈祷。"}, {"si": 411, "ei": 26, "dst": "至少官方的说法是这样。"}, {"si": 411, "ei": 27, "dst": "文献里讲的却是另一回事。"}, {"si": 411, "ei": 28, "dst": "哦,等等。大祭司叫我别谈这个。"}, {"si": 411, "ei": 29, "dst": "这场大流血是什么?"}, {"si": 411, "ei": 30, "dst": "那是很久以前的事了。"}, {"si": 411, "ei": 31, "dst": "这颗星球曾经完全正常。"}, {"si": 411, "ei": 32, "dst": "但后来开始下血雨,下血肉。"}, {"si": 411, "ei": 33, "dst": "下了很久。也许有几年。"}, {"si": 411, "ei": 34, "dst": "那个时代的记录不多。"}, {"si": 411, "ei": 35, "dst": "不久之后,泰坦开始出现。"}, {"si": 411, "ei": 36, "dst": "血肉泰坦是什么?"}, {"si": 411, "ei": 37, "dst": "神秘的血肉存在。"}, {"si": 411, "ei": 38, "dst": "他们在大流血之后开始出现。"}, {"si": 411, "ei": 39, "dst": "他们走到哪里,血肉就在哪里生长。"}, {"si": 411, "ei": 40, "dst": "而血肉所至,生命随之而来。"}, {"si": 411, "ei": 41, "dst": "至少我们是这么信的。"}, {"si": 411, "ei": 42, "dst": "但他们的历史非常模糊。"}, {"si": 411, "ei": 43, "dst": "那么,这个地方的历史是什么?"}, {"si": 411, "ei": 44, "dst": "这些是新德尔斐的遗迹。"}, {"si": 411, "ei": 45, "dst": "这地方在大流血之前就已古老。"}, {"si": 411, "ei": 46, "dst": "水池里注满神秘的液体。"}, {"si": 411, "ei": 47, "dst": "沉睡者选中了其中一个作为他的长眠之地。"}, {"si": 411, "ei": 48, "dst": "你是谁?"}, {"si": 411, "ei": 49, "dst": "我是历史学家。"}, {"si": 411, "ei": 50, "dst": "我研究与血肉泰坦相关的地点的历史。"}, {"si": 411, "ei": 51, "dst": "但文献太少了。"}, {"si": 411, "ei": 53, "dst": "喂!"}, {"si": 411, "ei": 54, "dst": "哦,你在跟我说话。"}, {"si": 411, "ei": 55, "dst": "从来没有人跟我说话。"}, {"si": 413, "ei": 0, "dst": "我们食用血肉,血肉也将食用我们。"}, {"si": 413, "ei": 1, "dst": "我的祈祷会被听见的。"}, {"si": 413, "ei": 2, "dst": "我是来祈祷的。"}, {"si": 413, "ei": 3, "dst": "这里真他妈热。"}, {"si": 413, "ei": 4, "dst": "我好渴。"}, {"si": 413, "ei": 5, "dst": "大流血发生时,这些遗迹就已经很古老了。"}, {"si": 413, "ei": 6, "dst": "我走了五天,就为了看一眼沉睡者。"}, {"si": 413, "ei": 7, "dst": "他们说新德尔斐藏着一个秘密。"}, {"si": 413, "ei": 8, "dst": "你没有见到沉睡者吗?"}, {"si": 413, "ei": 9, "dst": "没想到这里这么热。"}, {"si": 413, "ei": 10, "dst": "大祭司是智慧的。"}, {"si": 413, "ei": 11, "dst": "我从远方赶来,还是没搭上关系。"}, {"si": 415, "ei": 0, "dst": "为了血肉。"}, {"si": 415, "ei": 1, "dst": "愿血肉祝福你。"}, {"si": 415, "ei": 2, "dst": "追随泰坦。"}, {"si": 415, "ei": 3, "dst": "如你所愿。"}, {"si": 415, "ei": 4, "dst": "愿伤口在安宁中愈合。"}, {"si": 415, "ei": 5, "dst": "太阳终将再次升起。"}, {"si": 415, "ei": 6, "dst": "照顾好你的身体。"}, {"si": 415, "ei": 7, "dst": "不要犹豫。去做!"}, {"si": 415, "ei": 8, "dst": "记住要存在。"}, {"si": 415, "ei": 9, "dst": "愿泰坦赐你安宁。"}, {"si": 415, "ei": 10, "dst": "去吧,我的孩子。"}, {"si": 415, "ei": 11, "dst": "认清你的意志。"}, {"si": 415, "ei": 12, "dst": "赞美血肉。"}, {"si": 415, "ei": 13, "dst": "保护你自己。"}, {"si": 415, "ei": 14, "dst": "相信血液。"}, {"si": 417, "ei": 0, "dst": "你回来了。"}, {"si": 417, "ei": 1, "dst": "你可愿意接受泰坦的祝福?"}, {"si": 417, "ei": 2, "dst": "这些祝福真的有用吗?"}, {"si": 417, "ei": 3, "dst": "那边那头泰坦好像不太活跃。"}, {"si": 417, "ei": 4, "dst": "闭嘴,蠢货!"}, {"si": 417, "ei": 5, "dst": "不要让朝圣者的信仰动摇。"}, {"si": 417, "ei": 6, "dst": "学学那个历史学家,安安静静待在他的小屋里。"}, {"si": 417, "ei": 7, "dst": "此地受沉睡者祝福,任何人的言语都不得玷污。"}, {"si": 417, "ei": 8, "dst": "这便是泰坦的荣耀。"}, {"si": 417, "ei": 9, "dst": "水池里那个大家伙是怎么回事?"}, {"si": 417, "ei": 10, "dst": "不得妄议沉睡者。"}, {"si": 417, "ei": 11, "dst": "他曾是一位在这片土地上漫游的泰坦,决定就在此地休眠。"}, {"si": 417, "ei": 12, "dst": "他莅临于此,是我们的福分。"}, {"si": 417, "ei": 13, "dst": "而我们与世间众人共享他的祝福。"}, {"si": 417, "ei": 14, "dst": "哪怕是你,也能领受。"}, {"si": 417, "ei": 15, "dst": "这些人都是谁?"}, {"si": 417, "ei": 16, "dst": "曾经迷失,而后寻得真理之路的灵魂。"}, {"si": 417, "ei": 17, "dst": "他们从四面八方赶来,以朝圣表明虔诚。"}, {"si": 417, "ei": 18, "dst": "他们来此领受泰坦的祝福。"}, {"si": 417, "ei": 19, "dst": "其中最坚定的人甚至决定留下,把整个生命都奉献在主人面前。"}, {"si": 417, "ei": 20, "dst": "你也可以成为他们中的一员。"}, {"si": 417, "ei": 21, "dst": "不过你在力量与虔诚上都早已远超他们。"}, {"si": 417, "ei": 22, "dst": "泰坦?"}, {"si": 417, "ei": 23, "dst": "哦,可怜的灵魂,你不知道他们吗?"}, {"si": 417, "ei": 24, "dst": "我们的守护者与主人。"}, {"si": 417, "ei": 25, "dst": "他们看到我们罪恶的行径,前来引领我们走向极乐。"}, {"si": 417, "ei": 26, "dst": "他们走到哪里,血肉便在哪里生长。"}, {"si": 417, "ei": 27, "dst": "血肉生长之处,生命绽放。"}, {"si": 417, "ei": 28, "dst": "赞美他们吧,我的孩子,因为他们对你仍怀有希望。"}, {"si": 417, "ei": 29, "dst": "来吧,与我们一起赞美。"}, {"si": 417, "ei": 30, "dst": "你肯定是在开玩笑。"}, {"si": 417, "ei": 31, "dst": "毕竟你拯救过一位的种子。"}, {"si": 417, "ei": 32, "dst": "正是他们派你来帮助我们的。"}, {"si": 417, "ei": 33, "dst": "哦,我的眼睛看到了多么奇怪的景象。"}, {"si": 417, "ei": 34, "dst": "一个还未加入羊群的孩子。"}, {"si": 417, "ei": 35, "dst": "过来,过来。"}, {"si": 417, "ei": 36, "dst": "让泰坦的恩典祝福你,如同祝福所有其他人。"}, {"si": 417, "ei": 37, "dst": "你回来了。"}, {"si": 417, "ei": 38, "dst": "泰坦保佑你。"}, {"si": 417, "ei": 39, "dst": "你的英雄事迹我有所耳闻。"}, {"si": 417, "ei": 40, "dst": "泰坦对你必有宏大的安排。"}, {"si": 419, "ei": 0, "dst": "你好。"}, {"si": 419, "ei": 1, "dst": "嗨。"}, {"si": 421, "ei": 0, "dst": "欢迎。"}, {"si": 423, "ei": 0, "dst": "嘿,姐妹。"}, {"si": 423, "ei": 1, "dst": "我有个关于独身的问题。"}, {"si": 423, "ei": 2, "dst": "什么意思?我们没有强制独身的规矩。"}, {"si": 423, "ei": 3, "dst": "什么?!我禁欲了这么久,而且……从来没人告诉过我?"}, {"si": 423, "ei": 4, "dst": "*耸肩*"}, {"si": 423, "ei": 5, "dst": "好吧。那我这就充分利用起来。"}, {"si": 423, "ei": 6, "dst": "嘿,兄弟。"}, {"si": 423, "ei": 7, "dst": "怎么样?"}, {"si": 423, "ei": 8, "dst": "看看谁来了。"}, {"si": 423, "ei": 9, "dst": "终于决定过来了,对吧?你一直盯着我看。"}, {"si": 423, "ei": 10, "dst": "我没有。"}, {"si": 423, "ei": 11, "dst": "你有。"}, {"si": 423, "ei": 12, "dst": "我没有。"}, {"si": 423, "ei": 14, "dst": "好吧。回头见。"}, {"si": 423, "ei": 15, "dst": "为了血肉!"}, {"si": 423, "ei": 16, "dst": "血肉万岁!"}, {"si": 423, "ei": 17, "dst": "我得吃点东西。"}, {"si": 423, "ei": 18, "dst": "嗯,行吧。随便。"}, {"si": 423, "ei": 19, "dst": "你有没有不是肉的食物?能给我吗?"}, {"si": 423, "ei": 20, "dst": "哈哈哈。"}, {"si": 423, "ei": 21, "dst": "血肉万岁!"}, {"si": 423, "ei": 22, "dst": "肉食万岁。"}, {"si": 423, "ei": 23, "dst": "你读过关于联合孩子们的那段经文吗?"}, {"si": 423, "ei": 24, "dst": "你知道那说的是不是我们?我是说,孩子们。"}, {"si": 423, "ei": 25, "dst": "我看起来像管事的吗?我真不知道。"}, {"si": 423, "ei": 26, "dst": "它字面上可以指孩子,对吧?也许这是暗示我们应该开始造一些?"}, {"si": 423, "ei": 27, "dst": "我不太确定。"}, {"si": 423, "ei": 28, "dst": "嘿。今天怎么样?"}, {"si": 423, "ei": 29, "dst": "疼。但我不想抱怨太多。"}, {"si": 423, "ei": 30, "dst": "你的呢?"}, {"si": 423, "ei": 31, "dst": "比疼还糟。真是他妈的。"}, {"si": 423, "ei": 32, "dst": "就好像有人存心把这里变成我的地狱,往我头上淋屎……"}, {"si": 423, "ei": 33, "dst": "啊,算了,我也不想抱怨。"}, {"si": 423, "ei": 34, "dst": "欢迎!"}, {"si": 425, "ei": 0, "dst": "那么,他们是怎么抓住你的?"}, {"si": 425, "ei": 1, "dst": "我出去撒尿。"}, {"si": 425, "ei": 2, "dst": "他们就藏在灌木丛里。"}, {"si": 425, "ei": 3, "dst": "怎么说呢,他们对那场面不太满意。"}, {"si": 425, "ei": 4, "dst": "赞美泰坦!"}, {"si": 425, "ei": 5, "dst": "赞美。"}, {"si": 425, "ei": 6, "dst": "我想我老婆了。"}, {"si": 425, "ei": 7, "dst": "你有老婆?"}, {"si": 425, "ei": 8, "dst": "没有。"}, {"si": 425, "ei": 9, "dst": "但如果有的话,过了这么久我也会想她的。"}, {"si": 425, "ei": 10, "dst": "我们在这里待多久了?"}, {"si": 425, "ei": 11, "dst": "不知道。"}, {"si"