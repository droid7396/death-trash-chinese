[{"si": 671, "ei": 3, "dst": "持有钥匙的人,以及句句撒谎的那些人,每次你猜错都会更换。"}, {"si": 671, "ei": 4, "dst": "别搞砸了,好吗?"}, {"si": 671, "ei": 5, "dst": "嘿,你!"}, {"si": 671, "ei": 6, "dst": "这里是你最后的考验。"}, {"si": 671, "ei": 7, "dst": "要继续往上,你需要一把钥匙。"}, {"si": 671, "ei": 8, "dst": "我身后的守卫中有一人拿着它。试着查出是谁。"}, {"si": 671, "ei": 9, "dst": "可能是那边的德伦。"}, {"si": 671, "ei": 10, "dst": "嗨。"}, {"si": 671, "ei": 11, "dst": "也可能是克鲁沃。"}, {"si": 671, "ei": 13, "dst": "你好。"}, {"si": 671, "ei": 14, "dst": "或者其他人中的一个。"}, {"si": 673, "ei": 0, "dst": "哦,可怜的失败品。可怜的失败品。"}, {"si": 673, "ei": 1, "dst": "是谁把他们弄成这样?是谁?"}, {"si": 673, "ei": 2, "dst": "它为什么非得死呢?为什么?"}, {"si": 673, "ei": 3, "dst": "什么失败品?"}, {"si": 673, "ei": 4, "dst": "他们是从楼上下来的。从楼上。"}, {"si": 673, "ei": 5, "dst": "圣主歇息的地方。圣主。"}, {"si": 673, "ei": 6, "dst": "我们把他们收留了。收留了。"}, {"si": 673, "ei": 7, "dst": "但我很担心。很担心。"}, {"si": 673, "ei": 8, "dst": "他们还好吗?还好吗?"}, {"si": 673, "ei": 9, "dst": "你是说那个很痛苦的改造人?"}, {"si": 673, "ei": 10, "dst": "哦不,他很痛苦?他很痛苦?"}, {"si": 673, "ei": 11, "dst": "我们应该帮帮他。应该帮。"}, {"si": 673, "ei": 12, "dst": "不。"}, {"si": 673, "ei": 13, "dst": "你这么想真可惜。真可惜。"}, {"si": 673, "ei": 14, "dst": "愿圣主宽恕你。宽恕你。"}, {"si": 673, "ei": 15, "dst": "你还可以改变主意。改变主意。"}, {"si": 673, "ei": 16, "dst": "当然。"}, {"si": 673, "ei": 17, "dst": "很好。很好。"}, {"si": 673, "ei": 18, "dst": "我想我知道一个办法。一个办法。"}, {"si": 673, "ei": 19, "dst": "但我们得为此收集些东西。些东西。"}, {"si": 673, "ei": 20, "dst": "我们需要一些粘液、一个脑和一些血肉。一些血肉。"}, {"si": 673, "ei": 21, "dst": "我确信你要的一切在这一层都能找到。这一层。"}, {"si": 673, "ei": 22, "dst": "你是说小房间里的那些?"}, {"si": 673, "ei": 23, "dst": "你认识他们?认识?"}, {"si": 673, "ei": 24, "dst": "我和其中一个谈过。"}, {"si": 673, "ei": 25, "dst": "他很痛苦。"}, {"si": 673, "ei": 26, "dst": "那可不好。不好。"}, {"si": 673, "ei": 27, "dst": "我们得帮忙。得帮忙。"}, {"si": 673, "ei": 28, "dst": "你把止痛药给他了吗?给他了吗?"}, {"si": 673, "ei": 29, "dst": "请快点。快点。"}, {"si": 673, "ei": 30, "dst": "我们需要止痛药的原料。止痛药。"}, {"si": 673, "ei": 31, "dst": "请快点。快点。"}, {"si": 673, "ei": 32, "dst": "你回来了。回来了。"}, {"si": 673, "ei": 33, "dst": "我们需要的东西你都拿到了吗?都拿到了?"}, {"si": 673, "ei": 34, "dst": "还没有。"}, {"si": 673, "ei": 35, "dst": "那就请快点去拿。快点。"}, {"si": 673, "ei": 36, "dst": "是的。"}, {"si": 673, "ei": 37, "dst": "很好。很好。"}, {"si": 673, "ei": 38, "dst": "做好了。好了。"}, {"si": 673, "ei": 39, "dst": "请把这个交给那个改造人。改造人。"}, {"si": 673, "ei": 40, "dst": "他会好受一些的。好受一些。"}, {"si": 673, "ei": 41, "dst": "[给出怪异之肉。]"}, {"si": 673, "ei": 42, "dst": "[给出普通肉块。]"}, {"si": 673, "ei": 43, "dst": "没有起效。没有起效。"}, {"si": 673, "ei": 44, "dst": "为什么?为什么?"}, {"si": 673, "ei": 45, "dst": "是哪味原料错了吗?原料错了?"}, {"si": 673, "ei": 46, "dst": "你帮助那些失败品,做得很好。失败品。"}, {"si": 673, "ei": 47, "dst": "圣主会非常感激的。非常感激。"}, {"si": 675, "ei": 0, "dst": "请别打断我们。打断我们。"}, {"si": 675, "ei": 1, "dst": "我们正在分析这台机器人。这台机器人。"}, {"si": 675, "ei": 2, "dst": "我在找止痛药的原料。"}, {"si": 675, "ei": 3, "dst": "我不关心。不关心。"}, {"si": 675, "ei": 4, "dst": "我在工作。工作。"}, {"si": 675, "ei": 5, "dst": "随便。随便。"}, {"si": 675, "ei": 6, "dst": "如果我给你这个,你能闭嘴吗?能吗?"}, {"si": 677, "ei": 0, "dst": "这个怎么样?这个怎么样?"}, {"si": 677, "ei": 1, "dst": "我们从两边把外壳拉开。两边。"}, {"si": 677, "ei": 2, "dst": "这样暴露传感器会容易得多。容易得多。"}, {"si": 677, "ei": 3, "dst": "我们已经试过了。试过了。"}, {"si": 677, "ei": 4, "dst": "但这需要重得多的机械。重得多。"}, {"si": 677, "ei": 5, "dst": "我有个主意。一个主意。"}, {"si": 677, "ei": 6, "dst": "是什么?什么?"}, {"si": 677, "ei": 7, "dst": "我们取下它的悬浮模块。悬浮模块。"}, {"si": 677, "ei": 8, "dst": "再装到人类躯干上。人类躯干。"}, {"si": 677, "ei": 9, "dst": "我们能让没有腿的人飞起来。没有腿的人飞。"}, {"si": 677, "ei": 10, "dst": "你已经忘了上次我们那么做时发生了什么吗?上次?"}, {"si": 677, "ei": 11, "dst": "你觉得你能帮我拿到热力拆焊器吗?热力拆焊器?"}, {"si": 677, "ei": 12, "dst": "当然。当然。"}, {"si": 677, "ei": 13, "dst": "给。给。"}, {"si": 677, "ei": 14, "dst": "谢谢。谢谢。"}, {"si": 679, "ei": 0, "dst": "看这个。看。"}, {"si": 679, "ei": 1, "dst": "真是精巧。精巧。"}, {"si": 679, "ei": 2, "dst": "有意思。有意思。"}, {"si": 679, "ei": 3, "dst": "这么多零件。这么多。"}, {"si": 679, "ei": 4, "dst": "你看到这个了吗?看到了吗?"}, {"si": 681, "ei": 0, "dst": "一台悬浮机器人。"}, {"si": 681, "ei": 1, "dst": "它背上的舱门开着,露出里面所有的线路和机械结构。"}, {"si": 681, "ei": 2, "dst": "*滋滋滋"}, {"si": 681, "ei": 3, "dst": "我最好还是离它远点。"}, {"si": 681, "ei": 4, "dst": "来试试。来试试。"}, {"si": 681, "ei": 5, "dst": "*滋滋滋"}, {"si": 681, "ei": 6, "dst": "哎哟!哎哟!"}, {"si": 683, "ei": 0, "dst": "我为圣主做事。圣主。"}, {"si": 683, "ei": 1, "dst": "我们会改良他的军队。他的军队。"}, {"si": 683, "ei": 2, "dst": "圣主很伟大。很伟大。"}, {"si": 683, "ei": 3, "dst": "能见到他是种荣耀。一种荣耀。"}, {"si": 683, "ei": 4, "dst": "有时我会想。我会想。"}, {"si": 683, "ei": 5, "dst": "我是怎么到这儿来的?怎么来的?"}, {"si": 683, "ei": 6, "dst": "圣主很仁慈。很仁慈。"}, {"si": 683, "ei": 7, "dst": "他给了我们这个地方睡觉。睡觉。"}, {"si": 683, "ei": 8, "dst": "你有止痛药的原料吗?"}, {"si": 683, "ei": 9, "dst": "抱歉。抱歉。"}, {"si": 683, "ei": 10, "dst": "我什么都没有。什么都没有。"}, {"si": 683, "ei": 11, "dst": "止痛药?止痛药?"}, {"si": 683, "ei": 12, "dst": "谁在痛苦?谁?"}, {"si": 683, "ei": 13, "dst": "小房间里那个失败的改造人。"}, {"si": 683, "ei": 14, "dst": "是。是。"}, {"si": 683, "ei": 15, "dst": "我想帮忙。帮忙。"}, {"si": 683, "ei": 16, "dst": "但我只有粘液。只有粘液。"}, {"si": 683, "ei": 17, "dst": "这其实能帮大忙。"}, {"si": 683, "ei": 18, "dst": "那就拿去吧。拿去吧。"}, {"si": 685, "ei": 0, "dst": "钥匙在哪儿?"}, {"si": 687, "ei": 1, "dst": "没什么。"}, {"si": 689, "ei": 0, "dst": "新兵!"}, {"si": 689, "ei": 1, "dst": "你现在抵达了强者居住的地方。"}, {"si": 689, "ei": 2, "dst": "这是幸存者之地。"}, {"si": 689, "ei": 3, "dst": "这是我们谋划如何击败机器之神的地方。"}, {"si": 689, "ei": 4, "dst": "这是强者与智者之地。"}, {"si": 689, "ei": 5, "dst": "而现在,你也属于这里。"}, {"si": 691, "ei": 0, "dst": "欢迎来到机械身体部件移除装置。"}, {"si": 691, "ei": 1, "dst": "本装置能为您做什么?"}, {"si": 691, "ei": 2, "dst": "本装置具体是做什么的?"}, {"si": 691, "ei": 3, "dst": "本装置用于协助移除机械身体部件。"}, {"si": 691, "ei": 4, "dst": "开始检查……"}, {"si": 691, "ei": 5, "dst": "未检测到机械身体部件。"}, {"si": 691, "ei": 6, "dst": "检测到机械武器部件。"}, {"si": 691, "ei": 7, "dst": "要移除该机械部件吗?"}, {"si": 691, "ei": 8, "dst": "不,别移除。"}, {"si": 691, "ei": 9, "dst": "是,请移除这件武器。"}, {"si": 691, "ei": 10, "dst": "开始程序……"}, {"si": 693, "ei": 0, "dst": "你看起来很强壮。非常强壮。"}, {"si": 693, "ei": 1, "dst": "你愿意帮我吗?帮我?"}, {"si": 693, "ei": 2, "dst": "很紧急。紧急。"}, {"si": 693, "ei": 3, "dst": "放弃吧。"}, {"si": 693, "ei": 4, "dst": "你的朋友不会再回来了。"}, {"si": 693, "ei": 5, "dst": "骗子!骗子!"}, {"si": 693, "ei": 6, "dst": "我知道她还在里面。在里面。"}, {"si": 693, "ei": 7, "dst": "等着有人去救她。救她。"}, {"si": 693, "ei": 8, "dst": "你还好吗?"}, {"si": 693, "ei": 9, "dst": "很好。很好。"}, {"si": 693, "ei": 10, "dst": "既然不再是独自一人,时间过得快多了。快多了。"}, {"si": 693, "ei": 11, "dst": "不过,你能替我去一趟塔里吗?替我?"}, {"si": 693, "ei": 12, "dst": "我的朋友还在里面。还在。"}, {"si": 693, "ei": 13, "dst": "我很担心。担心。"}, {"si": 693, "ei": 14, "dst": "你为什么这样说话?"}, {"si": 693, "ei": 15, "dst": "什么意思?意思?"}, {"si": 693, "ei": 16, "dst": "总是在重复词语。一遍又一遍。"}, {"si": 693, "ei": 17, "dst": "我说话很正常。很正常。"}, {"si": 693, "ei": 18, "dst": "但别说我了。说我。"}, {"si": 693, "ei": 19, "dst": "我需要帮助。帮我。"}, {"si": 693, "ei": 20, "dst": "我已经在帮了。"}, {"si": 693, "ei": 21, "dst": "你看起来很强壮。非常强壮。"}, {"si": 693, "ei": 22, "dst": "请帮忙。帮我。"}, {"si": 693, "ei": 23, "dst": "嘿,你!你!"}, {"si": 693, "ei": 24, "dst": "那么,你现在打算做什么?"}, {"si": 693, "ei": 25, "dst": "当然是照顾你的朋友。"}, {"si": 693, "ei": 26, "dst": "你帮了我大忙。"}, {"si": 693, "ei": 27, "dst": "多亏了你,我才能再见到诺尔。"}, {"si": 693, "ei": 28, "dst": "尽管她有点……不一样了。"}, {"si": 695, "ei": 0, "dst": "我找到你的朋友了。"}, {"si": 695, "ei": 1, "dst": "但她和你记忆中的样子有点不一样了。"}, {"si": 695, "ei": 2, "dst": "嘿,你!你!"}, {"si": 695, "ei": 3, "dst": "你看起来很强壮。非常强壮。"}, {"si": 695, "ei": 4, "dst": "你愿意帮我吗?帮我?"}, {"si": 695, "ei": 5, "dst": "很紧急。紧急。"}, {"si": 695, "ei": 6, "dst": "朋友。"}, {"si": 695, "ei": 7, "dst": "你看起来很强壮。非常强壮。"}, {"si": 695, "ei": 8, "dst": "你愿意帮我吗?帮我?"}, {"si": 695, "ei": 9, "dst": "很紧急。紧急。"}, {"si": 695, "ei": 10, "dst": "这他妈是什么情况?"}, {"si": 695, "ei": 11, "dst": "我在找能救我朋友的人。我朋友。"}, {"si": 695, "ei": 12, "dst": "嗯,这话你之前已经说过了。"}, {"si": 695, "ei": 13, "dst": "不,我没说过。没说过。"}, {"si": 695, "ei": 14, "dst": "你说过。"}, {"si": 695, "ei": 15, "dst": "你是在说我疯了吗?我疯?"}, {"si": 695, "ei": 16, "dst": "不。"}, {"si": 695, "ei": 17, "dst": "我没有疯。没有疯。"}, {"si": 695, "ei": 18, "dst": "让我证明给你看。"}, {"si": 695, "ei": 19, "dst": "好。"}, {"si": 695, "ei": 20, "dst": "你在重复自己。"}, {"si": 695, "ei": 21, "dst": "你看起来很强壮。非常强壮。"}, {"si": 695, "ei": 22, "dst": "嗯,这话你之前已经说过了。"}, {"si": 695, "ei": 23, "dst": "你愿意帮我吗?帮我?"}, {"si": 695, "ei": 24, "dst": "我已经帮了。"}, {"si": 695, "ei": 25, "dst": "她就在这儿。"}, {"si": 695, "ei": 26, "dst": "她是我的朋友?朋友?"}, {"si": 695, "ei": 27, "dst": "朋友。"}, {"si": 695, "ei": 28, "dst": "哦,太好了。太好了。"}, {"si": 695, "ei": 29, "dst": "你看,我的朋友进了这座塔。塔。"}, {"si": 695, "ei": 30, "dst": "她还没出来。还没有。"}, {"si": 695, "ei": 31, "dst": "你愿意进去替我把她带出来吗?替我?"}, {"si": 695, "ei": 32, "dst": "我。朋友。待一起。"}, {"si": 695, "ei": 33, "dst": "你想和我待在一起?和我?"}, {"si": 695, "ei": 34, "dst": "是。待一起。朋友。"}, {"si": 695, "ei": 35, "dst": "那我们可以一起在这里等我朋友。一起。"}, {"si": 695, "ei": 36, "dst": "等有强壮的人来,我们就派他进去找她。找她。"}, {"si": 695, "ei": 37, "dst": "朋友。"}, {"si": 695, "ei": 38, "dst": "冷静点。"}, {"si": 695, "ei": 39, "dst": "你的朋友就在这儿。"}, {"si": 695, "ei": 40, "dst": "我的朋友……在这儿?在哪儿?"}, {"si": 695, "ei": 41, "dst": "你是瞎了吗?"}, {"si": 695, "ei": 42, "dst": "她就明晃晃地站在你旁边啊。"}, {"si": 695, "ei": 43, "dst": "这不可能是我的朋友。朋友。"}, {"si": 695, "ei": 44, "dst": "我的朋友非常漂亮。非常漂亮。"}, {"si": 695, "ei": 45, "dst": "她在塔里等着。等着。"}, {"si": 695, "ei": 46, "dst": "你至少可以跟她谈谈。"}, {"si": 695, "ei": 47, "dst": "好。好。"}, {"si": 695, "ei": 48, "dst": "那么,你是谁?你是?"}, {"si": 695, "ei": 49, "dst": "不,那真是你的朋友。"}, {"si": 695, "ei": 50, "dst": "你真的在说真话?真话?"}, {"si": 695, "ei": 51, "dst": "如果这真是她,她一定在受苦。受苦。"}, {"si": 695, "ei": 52, "dst": "我们必须把她从痛苦中解救出来。痛苦中。"}, {"si": 695, "ei": 53, "dst": "对,你看。"}, {"si": 695, "ei": 54, "dst": "这个人是我的朋友?朋友?"}, {"si": 695, "ei": 55, "dst": "是的。"}, {"si": 695, "ei": 56, "dst": "我不明白。不明白。"}, {"si": 695, "ei": 57, "dst": "请相信我。"}, {"si": 695, "ei": 58, "dst": "她明显认得你。"}, {"si": 695, "ei": 59, "dst": "我不认识她。不认识。"}, {"si": 695, "ei": 60, "dst": "你如果不是来帮忙的,就走开。走开。"}, {"si": 695, "ei": 61, "dst": "你也一样。一样。"}, {"si": 695, "ei": 62, "dst": "可是朋友?"}, {"si": 695, "ei": 63, "dst": "走开就是。走开。"}, {"si": 695, "ei": 64, "dst": "你们两个是一起来的。"}, {"si": 695, "ei": 65, "dst": "我不太明白为什么,但不知怎的你最后跑到了外面,叫别人去爬塔。"}, {"si": 695, "ei": 66, "dst": "这讲不通。讲不通。"}, {"si": 695, "ei": 67, "dst": "我在等我的朋友。我朋友。"}, {"si": 695, "ei": 68, "dst": "她在塔里。塔里。"}, {"si": 695, "ei": 69, "dst": "我知道的。我知道。"}, {"si": 695, "ei": 70, "dst": "如果你不愿相信我,那你至少愿意和这个改造人交个朋友吗?"}, {"si": 695, "ei": 71, "dst": "她会成为我的朋友?朋友?"}, {"si": 695, "ei": 72, "dst": "不。我们以前就是好朋友。"}, {"si": 695, "ei": 73, "dst": "这对你们俩都好。"}, {"si": 695, "ei": 74, "dst": "好好照顾彼此,好吗?"}, {"si": 695, "ei": 75, "dst": "你被泰坦洗脑了。"}, {"si": 695, "ei": 76, "dst": "洗脑?洗脑?"}, {"si": 695, "ei": 77, "dst": "是的。他对人干这种事。"}, {"si": 695, "ei": 78, "dst": "他们都说话绕圈子。像你一样。"}, {"si": 695, "ei": 79, "dst": "这也能解释你为什么认不出她。"}, {"si": 695, "ei": 80, "dst": "我不明白。不明白。"}, {"si": 695, "ei": 81, "dst": "这让我头疼。我头疼。"}, {"si": 695, "ei": 82, "dst": "放松。这样下去可不健康。"}, {"si": 695, "ei": 83, "dst": "你只要知道,这位女士想和你做朋友。"}, {"si": 695, "ei": 84, "dst": "撑住。你必须想起来。"}, {"si": 695, "ei": 85, "dst": "她是你的朋友。"}, {"si": 695, "ei": 86, "dst": "我们。朋友。一起来的。"}, {"si": 695, "ei": 87, "dst": "好痛。好痛。"}, {"si": 695, "ei": 88, "dst": "好痛。好痛。好痛。好痛。好痛。好痛。好痛。好痛。好痛。好痛————。"}, {"si": 695, "ei": 89, "dst": "啊啊啊啊啊啊。"}, {"si": 695, "ei": 90, "dst": "我的天哪。"}, {"si": 695, "ei": 91, "dst": "你是诺尔吗?"}, {"si": 695, "ei": 92, "dst": "我们本来想去塔里的。"}, {"si": 695, "ei": 93, "dst": "你他妈到底遭遇了什么?"}, {"si": 695, "ei": 94, "dst": "过来。让我照顾你。"}, {"si": 695, "ei": 95, "dst": "想起来。你们俩是一起爬上这座塔的。"}, {"si": 695, "ei": 96, "dst": "塔里有个泰坦,把她变成了这样。"}, {"si": 695, "ei": 97, "dst": "然后他把你放出来,替他诱骗更多人。"}, {"si": 695, "ei": 98, "dst": "我在诱骗人?诱骗?"}, {"si": 695, "ei": 99, "dst": "这……好痛。我头疼。"}, {"si": 697, "ei": 0, "dst": "你的朋友死了。"}, {"si": 697, "ei": 1, "dst": "你真傻。真傻。"}, {"si": 697, "ei": 2, "dst": "她在塔里面。等着。等着。"}, {"si": 699, "ei": 0, "dst": "你为什么这样说话。"}, {"si": 699, "ei": 1, "dst": "这个你已经问过了。问过了。"}, {"si": 699, "ei": 2, "dst": "你为什么重复自己?"}, {"si": 699, "ei": 3, "dst": "我不明白。不明白。"}, {"si": 699, "ei": 4, "dst": "我只需要帮助。帮助。"}, {"si": 699, "ei": 5, "dst": "出什么事了?"}, {"si": 699, "ei": 6, "dst": "我的朋友进了这座塔。塔。"}, {"si": 699, "ei": 7, "dst": "她还没回来。没回来。"}, {"si": 699, "ei": 8, "dst": "已经过去好几天了。好几天。"}, {"si": 699, "ei": 9, "dst": "我觉得她不在人世了。"}, {"si": 699, "ei": 10, "dst": "什么意思?什么意思?"}, {"si": 699, "ei": 11, "dst": "我就等她。等她。"}, {"si": 699, "ei": 12, "dst": "那还等什么?"}, {"si": 699, "ei": 13, "dst": "我说不清。说不清。"}, {"si": 699, "ei": 14, "dst": "请进去吧。进去。"}, {"si": 699, "ei": 15, "dst": "请帮帮我。帮忙。"}, {"si": 699, "ei": 16, "dst": "你不能自己去找她吗?"}, {"si": 699, "ei": 17, "dst": "多么奇怪的想法。奇怪。"}, {"si": 699, "ei": 18, "dst": "我不能。不能。"}, {"si": 699, "ei": 19, "dst": "有东西拦着我。拦着。"}, {"si": 699, "ei": 20, "dst": "你愿意帮我吗?帮我?"}, {"si": 699, "ei": 21, "dst": "行,我去看看。"}, {"si": 699, "ei": 22, "dst": "谢谢你。你。"}, {"si": 699, "ei": 23, "dst": "我觉得她不在里面了。"}, {"si": 701, "ei": 0, "dst": "最近有个女人来过吗?"}, {"si": 701, "ei": 1, "dst": "自我开始传扬以来,前来者众多。"}, {"si": 701, "ei": 2, "dst": "你说的那个人也许活了下来,也许没有。"}, {"si": 701, "ei": 3, "dst": "若你想查证,便到塔顶来。"}, {"si": 701, "ei": 4, "dst": "你是谁?"}, {"si": 701, "ei": 5, "dst": "我是那看见危险的人。"}, {"si": 701, "ei": 6, "dst": "我是那反抗机器的人。"}, {"si": 701, "ei": 7, "dst": "我是那立于塔顶的人。"}, {"si": 701, "ei": 8, "dst": "抵达我处,一切自会解答。"}, {"si": 701, "ei": 9, "dst": "这里在发生什么?"}, {"si": 701, "ei": 10, "dst": "原来实验对象甚至不知道自己为何在此。"}, {"si": 701, "ei": 11, "dst": "不必担忧。"}, {"si": 701, "ei": 12, "dst": "若你想变得更强。"}]