[{"si": 469, "ei": 33, "dst": "原谅我,但我现在帮不了你什么。"}, {"si": 469, "ei": 34, "dst": "你可以去泰坦之肠找那里的祭司,运气也许会好些。"}, {"si": 469, "ei": 35, "dst": "祝你朝圣顺利。"}, {"si": 469, "ei": 36, "dst": "东边泰坦之肠的祭司会有更多信息给你。"}, {"si": 469, "ei": 37, "dst": "看来泰坦们确实降福于你了。"}, {"si": 471, "ei": 0, "dst": "他死了。"}, {"si": 471, "ei": 1, "dst": "你回来了?"}, {"si": 471, "ei": 2, "dst": "你没看见我有多痛苦吗?"}, {"si": 471, "ei": 3, "dst": "你屠戮了我,毁掉了我。"}, {"si": 471, "ei": 4, "dst": "你是来炫耀的吗?还是来折磨我的?"}, {"si": 471, "ei": 5, "dst": "等等……"}, {"si": 471, "ei": 6, "dst": "你看起来不太一样。你不是他们那伙的,对吧?"}, {"si": 471, "ei": 7, "dst": "一定是泰坦派你来的,来完成我最后一件事。"}, {"si": 471, "ei": 8, "dst": "来,拿着这个,去新德尔斐。"}, {"si": 471, "ei": 9, "dst": "告诉他们,心被猎神者偷走了。"}, {"si": 471, "ei": 10, "dst": "走吧,让我安息。"}, {"si": 471, "ei": 11, "dst": "求你,快去新德尔斐"}, {"si": 473, "ei": 0, "dst": "这里是圣地。"}, {"si": 473, "ei": 1, "dst": "一座泰坦心脏的神龛。"}, {"si": 473, "ei": 2, "dst": "如果你想成为泰坦的朝圣者,请去新德尔斐找大祭司。"}, {"si": 475, "ei": 0, "dst": "我吐不出来。暂时。"}, {"si": 475, "ei": 1, "dst": "我没那个心情。"}, {"si": 475, "ei": 2, "dst": "我吐不出来。"}, {"si": 475, "ei": 3, "dst": "我肚子是空的。"}, {"si": 477, "ei": 0, "dst": "我盯着你呢。"}, {"si": 477, "ei": 1, "dst": "别干什么蠢事。"}, {"si": 477, "ei": 2, "dst": "你想喝多醉都行。"}, {"si": 477, "ei": 3, "dst": "只要把武器收好就行。"}, {"si": 477, "ei": 4, "dst": "吧台那个哭的家伙是怎么回事?"}, {"si": 477, "ei": 5, "dst": "那只是纳德又多愁善感了。"}, {"si": 477, "ei": 6, "dst": "他以前养了只宠物血肉蠕虫。叫什么米尔娅之类的。"}, {"si": 477, "ei": 7, "dst": "但上周它凑炮塔凑得太近了。"}, {"si": 477, "ei": 8, "dst": "当场被炸成了碎片。"}, {"si": 477, "ei": 9, "dst": "那场面,血呼啦的。真的。"}, {"si": 477, "ei": 10, "dst": "但从那以后他就一直待在这儿。哭。"}, {"si": 477, "ei": 11, "dst": "我不介意。只要他付钱。"}, {"si": 479, "ei": 0, "dst": "我昨天喝得太醉,断片了。"}, {"si": 479, "ei": 1, "dst": "还是前天来着?"}, {"si": 479, "ei": 2, "dst": "给你个忠告:永远在最后一杯之前停下。"}, {"si": 479, "ei": 3, "dst": "最后一杯总会让你越过界限。"}, {"si": 479, "ei": 4, "dst": "在它之前停住,你就没事。"}, {"si": 479, "ei": 5, "dst": "你知道人们总说酒喝多了伤身吗?"}, {"si": 479, "ei": 6, "dst": "他们错了。"}, {"si": 479, "ei": 7, "dst": "这才叫生活。"}, {"si": 479, "ei": 8, "dst": "告诉我,你幸福吗?"}, {"si": 479, "ei": 9, "dst": "算不上。"}, {"si": 479, "ei": 10, "dst": "那你可能需要痛快吐一场。"}, {"si": 479, "ei": 11, "dst": "能把所有不好的东西都吐出去。"}, {"si": 479, "ei": 12, "dst": "幸福。"}, {"si": 479, "ei": 13, "dst": "这就是我说的嘛。"}, {"si": 479, "ei": 14, "dst": "酒。"}, {"si": 479, "ei": 15, "dst": "什么?"}, {"si": 479, "ei": 16, "dst": "你可真没劲。"}, {"si": 479, "ei": 17, "dst": "酒?"}, {"si": 479, "ei": 18, "dst": "酒!"}, {"si": 479, "ei": 19, "dst": "酒!"}, {"si": 479, "ei": 20, "dst": "酒——————。"}, {"si": 479, "ei": 21, "dst": "酒——————!"}, {"si": 479, "ei": 22, "dst": "哈哈哈哈哈哈。"}, {"si": 479, "ei": 24, "dst": "呼。"}, {"si": 479, "ei": 25, "dst": "你们是双胞胎吗?"}, {"si": 479, "ei": 26, "dst": "不对等等,你们有三个。"}, {"si": 479, "ei": 27, "dst": "我绝对没醉。"}, {"si": 479, "ei": 28, "dst": "看,我还能走直线呢。"}, {"si": 479, "ei": 29, "dst": "好吧。也许走不了。"}, {"si": 479, "ei": 30, "dst": "我旅行已经有一阵子了。"}, {"si": 479, "ei": 31, "dst": "呕吐酒吧就是最完美的歇脚点。"}, {"si": 479, "ei": 32, "dst": "想知道我为什么喝醉吗?"}, {"si": 479, "ei": 33, "dst": "不太想。"}, {"si": 479, "ei": 34, "dst": "你说得对,那是浪费时间。"}, {"si": 479, "ei": 35, "dst": "再来点酒!"}, {"si": 479, "ei": 36, "dst": "说吧。"}, {"si": 479, "ei": 37, "dst": "酒精。"}, {"si": 479, "ei": 38, "dst": "你有酒可以分我点吗?"}, {"si": 479, "ei": 39, "dst": "可不给你这种人。"}, {"si": 479, "ei": 40, "dst": "行行行。你也去死吧。"}, {"si": 479, "ei": 41, "dst": "没什么。抱歉。"}, {"si": 479, "ei": 42, "dst": "真扫兴。"}, {"si": 479, "ei": 43, "dst": "再不小心点,我马上就要清醒了。"}, {"si": 479, "ei": 44, "dst": "当然。"}, {"si": 479, "ei": 45, "dst": "哥们,你真是太好了。"}, {"si": 479, "ei": 46, "dst": "这里的肉……"}, {"si": 479, "ei": 47, "dst": "最近吃起来太没劲了。"}, {"si": 479, "ei": 48, "dst": "我不知道他们对手上的肉做了什么。"}, {"si": 479, "ei": 49, "dst": "味道就是不一样。"}, {"si": 479, "ei": 50, "dst": "你,我,那边的房间。怎么样?"}, {"si": 479, "ei": 51, "dst": "我大概不该去。"}, {"si": 479, "ei": 52, "dst": "机器人跟我说过什么终止处理之类的话。"}, {"si": 479, "ei": 53, "dst": "切。你信它们?"}, {"si": 479, "ei": 54, "dst": "跟我来就是了。会很舒服的。"}, {"si": 479, "ei": 55, "dst": "没门。"}, {"si": 479, "ei": 56, "dst": "真扫兴。"}, {"si": 479, "ei": 57, "dst": "管他的。来吧。"}, {"si": 479, "ei": 58, "dst": "你长得不错。"}, {"si": 479, "ei": 59, "dst": "来,拿着这个。我请客。"}, {"si": 479, "ei": 60, "dst": "哇哦。你醉了。"}, {"si": 479, "ei": 61, "dst": "跟我一样。"}, {"si": 481, "ei": 0, "dst": "你,我,那边的房间。怎么样?"}, {"si": 481, "ei": 1, "dst": "现在不行,抱歉。"}, {"si": 481, "ei": 2, "dst": "不过你看到吧台那边那个哭哭啼啼的可怜虫了吗?"}, {"si": 481, "ei": 3, "dst": "你是说纳德?"}, {"si": 481, "ei": 4, "dst": "要不你去陪陪他?"}, {"si": 481, "ei": 5, "dst": "没门。我想要点乐子。他看起来一点也不像乐子。"}, {"si": 481, "ei": 6, "dst": "你就看看他吧。你怎么能这么没心没肺?"}, {"si": 481, "ei": 7, "dst": "好啦。好啦。明白了。"}, {"si": 481, "ei": 8, "dst": "我去照顾他。暂时。"}, {"si": 481, "ei": 9, "dst": "但你得正式给我们引荐一下。"}, {"si": 481, "ei": 10, "dst": "要给你什么你才肯改主意?"}, {"si": 481, "ei": 11, "dst": "你把我当什么人了?"}, {"si": 481, "ei": 12, "dst": "人人都有个价。"}, {"si": 481, "ei": 13, "dst": "100 金币。"}, {"si": 481, "ei": 14, "dst": "太贵了。"}, {"si": 481, "ei": 15, "dst": "那我不帮你了。"}, {"si": 481, "ei": 16, "dst": "成交。"}, {"si": 481, "ei": 17, "dst": "我现在就是拿不出来。"}, {"si": 481, "ei": 18, "dst": "那就等钱够了再来。"}, {"si": 481, "ei": 19, "dst": "我给你 60。"}, {"si": 481, "ei": 20, "dst": "滚。我可没那么廉价。"}, {"si": 481, "ei": 21, "dst": "我给你 60。"}, {"si": 481, "ei": 22, "dst": "这还行。"}, {"si": 481, "ei": 23, "dst": "我现在就是拿不出来。"}, {"si": 481, "ei": 24, "dst": "跟我讨价还价,结果又付不起钱。"}, {"si": 481, "ei": 25, "dst": "你可真不聪明。"}, {"si": 481, "ei": 26, "dst": "怎么了?"}, {"si": 481, "ei": 27, "dst": "你认识吧台那个哭鼻子的家伙吗?"}, {"si": 481, "ei": 28, "dst": "纳德?他都哭了好几个星期了。"}, {"si": 481, "ei": 29, "dst": "真希望我的酒量有他一半好。"}, {"si": 481, "ei": 30, "dst": "他到底在哭什么?"}, {"si": 481, "ei": 31, "dst": "一个叫米尔娅的,还是什么类似的名字。"}, {"si": 481, "ei": 32, "dst": "不知道那是谁。"}, {"si": 481, "ei": 33, "dst": "从没见过。"}, {"si": 481, "ei": 34, "dst": "守卫们可能知道得更多。"}, {"si": 481, "ei": 35, "dst": "好了,酒在哪儿?"}, {"si": 481, "ei": 36, "dst": "别打扰我们。我们正浪漫着呢。"}, {"si": 481, "ei": 37, "dst": "就是。别打扰我们!"}, {"si": 483, "ei": 0, "dst": "你好!"}, {"si": 485, "ei": 0, "dst": "这张床能睡两个人,只要互相搂着点。"}, {"si": 487, "ei": 0, "dst": "好像有人忘了冲水。"}, {"si": 489, "ei": 0, "dst": "哦。只是一些\"玩具\"。"}, {"si": 489, "ei": 1, "dst": "别碰那个衣柜!"}, {"si": 491, "ei": 0, "dst": "看来酒吧在这儿囤了些肉。"}, {"si": 491, "ei": 1, "dst": "我猜这边的人也会饿嘛。"}, {"si": 491, "ei": 2, "dst": "这些肉被血肉蛆感染过。"}, {"si": 491, "ei": 3, "dst": "但现在没有蛆了。"}, {"si": 491, "ei": 4, "dst": "这些应该就是埃尔德雷德提到的血肉蛆。"}, {"si": 491, "ei": 5, "dst": "估计我可以试着弄点那种毒药。"}, {"si": 491, "ei": 6, "dst": "来吧。"}, {"si": 491, "ei": 7, "dst": "把毒撒得到处都是。"}, {"si": 491, "ei": 8, "dst": "再见吧,蛆虫们!"}, {"si": 491, "ei": 9, "dst": "好了。回去找酒保。"}, {"si": 493, "ei": 0, "dst": "你好。希望你在呕吐酒吧待得愉快。"}, {"si": 495, "ei": 0, "dst": "搞什么鬼?"}, {"si": 495, "ei": 1, "dst": "我没看见你从楼梯上来,那你肯定是溜进来的。"}, {"si": 495, "ei": 2, "dst": "别到处鬼鬼祟祟的,行吗?"}, {"si": 495, "ei": 3, "dst": "我们这儿喜欢太平。"}, {"si": 497, "ei": 0, "dst": "你好,欢迎来到呕吐酒吧!"}, {"si": 497, "ei": 1, "dst": "最好的酒。最好的肉。你还需要什么?"}, {"si": 497, "ei": 2, "dst": "友善点,别讨人嫌,走路看着点脚下。"}, {"si": 497, "ei": 3, "dst": "还有,这条很重要:在里面别明着带武器。"}, {"si": 497, "ei": 4, "dst": "我们喜欢太平。"}, {"si": 497, "ei": 5, "dst": "我不做太平的买卖。"}, {"si": 497, "ei": 6, "dst": "行。那你就待在外面。"}, {"si": 497, "ei": 7, "dst": "里面的人神经都绷得很紧。他们要是看见你手里有武器,会开枪的。"}, {"si": 497, "ei": 8, "dst": "我的武器想带到哪儿就带到哪儿。"}, {"si": 497, "ei": 9, "dst": "好。我会照办。"}, {"si": 497, "ei": 10, "dst": "很好。在里面别拔武器。大家都很紧张。"}, {"si": 497, "ei": 11, "dst": "他妈的离我远点。"}, {"si": 497, "ei": 12, "dst": "还有,这条很重要:把武器收起来。"}, {"si": 499, "ei": 0, "dst": "我猜这算是艺术?"}, {"si": 501, "ei": 0, "dst": "找到「屠夫切肉」"}, {"si": 501, "ei": 1, "dst": "回到猎人那里"}, {"si": 501, "ei": 2, "dst": "一块上等好肉"}, {"si": 503, "ei": 0, "dst": "进入艺术家的模块"}, {"si": 503, "ei": 1, "dst": "帮助缪斯发挥她的潜能"}, {"si": 503, "ei": 2, "dst": "缪斯与往昔之魂"}, {"si": 505, "ei": 0, "dst": "给收藏者送去一段动人的记忆"}, {"si": 505, "ei": 1, "dst": "献上记忆"}, {"si": 507, "ei": 0, "dst": "为总管取得母亲的核心印记"}, {"si": 507, "ei": 1, "dst": "取得核心印记"}, {"si": 507, "ei": 2, "dst": "母亲的核心印记"}, {"si": 509, "ei": 0, "dst": "获得非凡的味觉"}, {"si": 509, "ei": 1, "dst": "拿到那块肉或一段记忆"}, {"si": 509, "ei": 2, "dst": "找一位味觉专家"}, {"si": 509, "ei": 3, "dst": "后天养成的品味"}, {"si": 5