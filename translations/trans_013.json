[{"si": 365, "ei": 5, "dst": "祝你有美好的一天。"}, {"si": 367, "ei": 0, "dst": "它已经被拆件回收了。"}, {"si": 369, "ei": 0, "dst": "它在嗡嗡响。是电吗?"}, {"si": 371, "ei": 0, "dst": "这里有个小铭牌。"}, {"si": 371, "ei": 1, "dst": "\"为你自己和子孙后代保存数据。保证 5000 年。\""}, {"si": 371, "ei": 3, "dst": "内部已被石笋刺穿。"}, {"si": 373, "ei": 0, "dst": "一些棕色的东西在不停地往下滴。"}, {"si": 375, "ei": 0, "dst": "下面卡着一只毛绒玩具的腿。"}, {"si": 377, "ei": 0, "dst": "它是温的,好像最近被用过。"}, {"si": 379, "ei": 0, "dst": "这里面有些旋转的刷子。不过它们转起来有点费劲。"}, {"si": 381, "ei": 0, "dst": "这地方倒是挺适合咽气的。"}, {"si": 383, "ei": 0, "dst": "你回来了。"}, {"si": 383, "ei": 1, "dst": "最近你的研究有进展吗?"}, {"si": 383, "ei": 2, "dst": "并没有。科学向来是个缓慢的过程。"}, {"si": 383, "ei": 3, "dst": "但我很有毅力。我们会弄明白的。"}, {"si": 383, "ei": 4, "dst": "还有别的事吗?"}, {"si": 383, "ei": 5, "dst": "你知道去哪给一个多肉的大块头找朋友吗?"}, {"si": 383, "ei": 6, "dst": "呃……什么?"}, {"si": 383, "ei": 7, "dst": "我遇到了这个巨大的血肉生物。看着像某种触手动物。"}, {"si": 383, "ei": 8, "dst": "它有点孤独,正在找朋友。"}, {"si": 383, "ei": 9, "dst": "有意思。"}, {"si": 383, "ei": 10, "dst": "那样的生物需要什么样的朋友?另一个血肉生物?"}, {"si": 383, "ei": 11, "dst": "我不知道。不过它已经接受我做朋友了。"}, {"si": 383, "ei": 12, "dst": "有意思。"}, {"si": 383, "ei": 13, "dst": "那生物危险吗?"}, {"si": 383, "ei": 14, "dst": "我不知道。"}, {"si": 383, "ei": 16, "dst": "有意思。"}, {"si": 383, "ei": 17, "dst": "也许你可以改造一个人造人来干这事。"}, {"si": 383, "ei": 18, "dst": "那生物有了朋友,我们有了观察的机会,也不会有人陷入危险。"}, {"si": 383, "ei": 19, "dst": "我去哪找能干这个的人造人?"}, {"si": 383, "ei": 20, "dst": "去问执法者是没用的。"}, {"si": 383, "ei": 21, "dst": "但我在陶里斯外面见过一个坏了的人造人,在南边的老房子附近。"}, {"si": 383, "ei": 22, "dst": "好。我去看看。谢谢。"}, {"si": 383, "ei": 23, "dst": "哦,我想我知道是哪个。"}, {"si": 383, "ei": 24, "dst": "谢谢。"}, {"si": 383, "ei": 25, "dst": "就是我跟你说的那个血肉触手生物。"}, {"si": 383, "ei": 26, "dst": "你能给我做检查吗?"}, {"si": 383, "ei": 27, "dst": "可以,我愿意。"}, {"si": 383, "ei": 28, "dst": "你知道,这对我而言也相当有意思。"}, {"si": 383, "ei": 29, "dst": "你将是我能研究的第一个还处于非常早期阶段的病例。"}, {"si": 383, "ei": 30, "dst": "非常令人兴奋。"}, {"si": 383, "ei": 31, "dst": "早期?这么说你知道这会发展成什么?"}, {"si": 383, "ei": 32, "dst": "不知道。目前还不清楚。也许是某种变异。"}, {"si": 383, "ei": 33, "dst": "呃……有治愈的办法吗?"}, {"si": 383, "ei": 34, "dst": "我不认为有。"}, {"si": 383, "ei": 35, "dst": "但先做紧要的事。我的设备还不完全支持人类细胞研究。"}, {"si": 383, "ei": 36, "dst": "我需要一个医疗扫描仪和一些八角液。"}, {"si": 383, "ei": 37, "dst": "也许你可以从陶里斯的医生那弄台扫描仪。告诉我是为了我,莫图斯。"}, {"si": 383, "ei": 38, "dst": "八角液这附近没有。你得去北边的某处旧设施找找。"}, {"si": 383, "ei": 39, "dst": "最后,如果你能给我弄点变异人脑组织,那会很有帮助。"}, {"si": 383, "ei": 40, "dst": "好。我去看看。"}, {"si": 383, "ei": 41, "dst": "你要我做什么来着?"}, {"si": 383, "ei": 42, "dst": "走到血肉枢纽那里,看看血肉是否对你有反应。"}, {"si": 383, "ei": 43, "dst": "你需要我做什么来着?"}, {"si": 383, "ei": 44, "dst": "一些脑组织、一些八角液,还有一台医疗扫描仪。"}, {"si": 383, "ei": 45, "dst": "好。我去看看。"}, {"si": 383, "ei": 46, "dst": "你要的东西我都齐了。"}, {"si": 383, "ei": 47, "dst": "好。给我吧。"}, {"si": 383, "ei": 48, "dst": "好。让我准备一下。"}, {"si": 383, "ei": 49, "dst": "好了。我已经把扫描仪的频率调整到能监听任何血肉活动。"}, {"si": 383, "ei": 50, "dst": "让我看看。"}, {"si": 383, "ei": 51, "dst": "嗯。确实有活动。"}, {"si": 383, "ei": 52, "dst": "不过不多。"}, {"si": 383, "ei": 53, "dst": "如果用八角液强化你的身体,血肉枢纽会作何反应,那会很有意思。"}, {"si": 383, "ei": 54, "dst": "血肉枢纽?"}, {"si": 383, "ei": 55, "dst": "那是我给填满这些洞穴的血肉枢纽起的名字。"}, {"si": 383, "ei": 56, "dst": "它有主体,有触手,有节点。"}, {"si": 383, "ei": 57, "dst": "这个洞穴深处有一个了不起的节点。"}, {"si": 383, "ei": 58, "dst": "来,让我往你皮肤上涂一点八角液。"}, {"si": 383, "ei": 59, "dst": "如果我没错,这会让你对枢纽的吸引力大增。"}, {"si": 383, "ei": 60, "dst": "去那个节点那试试吧。"}, {"si": 383, "ei": 61, "dst": "好。"}, {"si": 383, "ei": 62, "dst": "哦。我已经跟那东西说过话了。"}, {"si": 383, "ei": 63, "dst": "有意思。你的变异一定比预想的发展得更快。"}, {"si": 383, "ei": 64, "dst": "但更重要的是,你看到了什么?它有智慧吗?"}, {"si": 383, "ei": 65, "dst": "血肉枢纽本身我说不准。"}, {"si": 383, "ei": 66, "dst": "但里面有个人,通过枢纽在交流。"}, {"si": 383, "ei": 67, "dst": "他自称先知。他要我找到他。"}, {"si": 383, "ei": 68, "dst": "哦。可是……怎么找?为什么?"}, {"si": 383, "ei": 69, "dst": "我还不知道。"}, {"si": 383, "ei": 70, "dst": "引人入胜。"}, {"si": 383, "ei": 71, "dst": "先知提到了一个蠕虫萨满。"}, {"si": 383, "ei": 72, "dst": "还说蠕虫萨满注定会帮助先知。"}, {"si": 383, "ei": 73, "dst": "听起来很怪。"}, {"si": 383, "ei": 74, "dst": "萨满,你说?也许就像古树的那个女巫?"}, {"si": 383, "ei": 75, "dst": "女巫?"}, {"si": 383, "ei": 76, "dst": "大家是这么叫她的。我不太清楚她的底细。"}, {"si": 383, "ei": 77, "dst": "女巫。萨满。也许是同一个人。或者有关联。"}, {"si": 383, "ei": 78, "dst": "我觉得你应该去跟她谈谈。"}, {"si": 383, "ei": 79, "dst": "好。"}, {"si": 383, "ei": 80, "dst": "引人入胜。听起来像一场真正的冒险。"}, {"si": 383, "ei": 81, "dst": "不过我想你已经赚得了一些休息时间。"}, {"si": 383, "ei": 82, "dst": "我检查了血肉枢纽……"}, {"si": 383, "ei": 83, "dst": "然后呢?"}, {"si": 383, "ei": 84, "dst": "它对我有反应。我甚至觉得我能与它交流。"}, {"si": 383, "ei": 85, "dst": "只是我的声音不够强,或者类似的问题。"}, {"si": 383, "ei": 86, "dst": "引人入胜。"}, {"si": 383, "ei": 87, "dst": "那你会……你会怎么获得一个更洪亮的声音?"}, {"si": 383, "ei": 88, "dst": "不知道。我会四处找找。"}, {"si": 383, "ei": 89, "dst": "也许我会找到另一个血肉节点之类的东西。"}, {"si": 383, "ei": 90, "dst": "真不知道。"}, {"si": 383, "ei": 91, "dst": "不过我遇到了那个巨大的血肉生物。看着像某种触手动物。"}, {"si": 383, "ei": 92, "dst": "也许那个生物能教我怎么获得更洪亮的声音?"}, {"si": 383, "ei": 93, "dst": "有意思。"}, {"si": 383, "ei": 94, "dst": "嗯。值得一试,我想。"}, {"si": 383, "ei": 95, "dst": "好。我去跟它谈谈。"}, {"si": 383, "ei": 96, "dst": "也许是我说过的那个血肉触手生物。"}, {"si": 383, "ei": 97, "dst": "我跟血肉枢纽交谈过了。"}, {"si": 383, "ei": 98, "dst": "是吗?那……我们说的是一个有智慧的存在吗?"}, {"si": 383, "ei": 99, "dst": "关于先知……"}, {"si": 383, "ei": 100, "dst": "关于血肉枢纽……"}, {"si": 383, "ei": 101, "dst": "你之前想去找那个触手生物,看它能不能教你怎么跟血肉枢纽交流。"}, {"si": 383, "ei": 102, "dst": "啊,对。"}, {"si": 383, "ei": 103, "dst": "我觉得我现在可以和血肉枢纽交谈了。"}, {"si": 383, "ei": 104, "dst": "好。你打算怎么做?"}, {"si": 383, "ei": 105, "dst": "不知道怎么做,但我感觉我现在有声音了。"}, {"si": 383, "ei": 106, "dst": "有意思。请试试吧。"}, {"si": 383, "ei": 107, "dst": "一位访客。"}, {"si": 383, "ei": 108, "dst": "你在这里做什么?"}, {"si": 383, "ei": 109, "dst": "检查血肉。检查机器。弄清我们在它们之中的位置。"}, {"si": 383, "ei": 110, "dst": "不过我目前的研究主要聚焦在血肉上。"}, {"si": 383, "ei": 111, "dst": "我好奇……你对周围这些形形色色的肉有什么看法?"}, {"si": 383, "ei": 112, "dst": "[保持沉默。]"}, {"si": 383, "ei": 113, "dst": "我的总体观察是:它很不寻常,而且我们无法分辨它从何而来。"}, {"si": 383, "ei": 114, "dst": "我关心的是它的来源。以及它与感染和变异的关系。"}, {"si": 383, "ei": 115, "dst": "呃呃……我因为被污染而被赶出了栖居地。这有关系吗?"}, {"si": 383, "ei": 116, "dst": "有意思。没有任何可见的疾病迹象。"}, {"si": 383, "ei": 117, "dst": "你感觉怎么样?"}, {"si": 383, "ei": 118, "dst": "大部分时间挺正常。偶尔会一阵恶心,有想吐的冲动。"}, {"si": 383, "ei": 119, "dst": "好。那些可能是你的新陈代谢开始转变的初期迹象。"}, {"si": 383, "ei": 120, "dst": "这很不寻常。"}, {"si": 383, "ei": 121, "dst": "这是个好观察。"}, {"si": 383, "ei": 122, "dst": "我甚至会说,这些肉没有可辨的来源。"}, {"si": 383, "ei": 123, "dst": "它是免费的食物。"}, {"si": 383, "ei": 124, "dst": "我想是吧。"}, {"si": 383, "ei": 125, "dst": "而且量很大。"}, {"si": 383, "ei": 126, "dst": "正确。"}, {"si": 383, "ei": 127, "dst": "它就在那里。"}, {"si": 383, "ei": 128, "dst": "嗯,\"就在那里\"是个挺大胆的假设。"}, {"si": 385, "ei": 0, "dst": "你回到我身边,我很高兴。"}, {"si": 385, "ei": 1, "dst": "你就是等待已久的同伴吗?"}, {"si": 385, "ei": 2, "dst": "我想我可以做那个同伴。"}, {"si": 385, "ei": 3, "dst": "哦,我感到多么喜悦。"}, {"si": 385, "ei": 4, "dst": "我确实压制过那些过早滋生的希望。我不敢奢求太多。"}, {"si": 385, "ei": 5, "dst": "但一丝细流仍在,我承认。而现在我看到,那是有根据的。"}, {"si": 385, "ei": 6, "dst": "那么请在前领路,指引我。"}, {"si": 385, "ei": 7, "dst": "从今往后,我命名你为同伴。"}, {"si": 385, "ei": 8, "dst": "黑暗洞穴中一张友善的脸。"}, {"si": 385, "ei": 9, "dst": "我的心因遇见另一个人而绽放,我的心情也轻快起来,因为我知道自己不再那么孤独了。"}, {"si": 385, "ei": 10, "dst": "看到这个世界上如此多的冷漠,我很痛心。"}, {"si": 385, "ei": 11, "dst": "这一段旅程一起走过,会是乐事,对吧?"}, {"si": 385, "ei": 12, "dst": "前进吧,怀着坚定的心。"}, {"si": 385, "ei": 13, "dst": "亲爱的同伴,让我们继续上路。"}, {"si": 385, "ei": 14, "dst": "我能感觉到一股深厚的暖意充盈在我们周围。"}, {"si": 385, "ei": 15, "dst": "这地方在对我说话。开阔的结构,太阳和树木:它们在欢迎我,不是吗?"}, {"si": 385, "ei": 16, "dst": "我能看见我的心智在此栖息,这里的环境定能驱散一切无聊的念头,对此我深信不疑。"}, {"si": 385, "ei": 17, "dst": "那就这样定了。"}, {"si": 385, "ei": 18, "dst": "我会想念这份陪伴的,但我知道你现在必须继续你的旅程。"}, {"si": 385, "ei": 19, "dst": "再见了,我的朋友。"}, {"si": 385, "ei": 20, "dst": "亲爱的同伴,这地方让我心生畏惧。"}, {"si": 385, "ei": 21, "dst": "我脑海边缘有一股不安的力量,引诱我留在这里。"}, {"si": 385, "ei": 22, "dst": "那是一种躁动,却也是一种充实,我渴望它。"}, {"si": 385, "ei": 23, "dst": "这里会是我停留、生活、长居的地方吗?"}, {"si": 385, "ei": 24, "dst": "是的,就是这里。"}, {"si": 385, "ei": 25, "dst": "我头顶笼罩着恐惧,但现在我明白,这就是我注定停留之地。"}, {"si": 385, "ei": 26, "dst": "人生充满了挑战,不是吗?"}, {"si": 385, "ei": 27, "dst": "而我们不应逃避它们,亲爱的同伴。"}, {"si": 385, "ei": 28, "dst": "这里真美。"}, {"si": 385, "ei": 29, "dst": "我常常想起我们一起参与的任务,亲爱的同伴。"}, {"si": 385, "ei": 30, "dst": "但我如今很高兴,我们找到了一处歇息之地。"}, {"si": 385, "ei": 31, "dst": "亲爱的同伴,看来我们面前有两条路。"}, {"si": 385, "ei": 32, "dst": "右边的路会通向一个安静的地方。一处荒凉的所在,心可以在那里永远休息。"}, {"si": 385, "ei": 33, "dst": "我能感到我的心渴望着它。"}, {"si": 385, "ei": 34, "dst": "但还有另一种感觉。"}, {"si": 385, "ei": 35, "dst": "一种存在,一种\"未知\",一缕摇摆不定的不安,它在召唤我们向左走。"}, {"si": 385, "ei": 36, "dst": "哦,看着前方那条黑暗的路,我为我的灵魂担忧。但与此同时,我心中又有好奇的精神,渴望去探索。"}, {"si": 385, "ei": 37, "dst": "向前走吧,同伴,我会跟着。"}, {"si": 385, "ei": 38, "dst": "EnteringDarkArea"}, {"si": 385, "ei": 39, "dst": "这地方让我心中充满不祥的预感。"}, {"si": 385, "ei": 40, "dst": "EnteringTranquilArea"}, {"si": 385, "ei": 41, "dst": "哦哦,看看这和平友善的地方。"}, {"si": 385, "ei": 42, "dst": "EnteringCrossroads"}, {"si": 385, "ei": 43, "dst": "我们到了岔路口。让我们静思一下这段旅程。"}, {"si": 387, "ei": 0, "dst": "嘿,老头。"}, {"si": 387, "ei": 1, "dst": "哈哈哈。瞧瞧你。穿着衣服,一本正经的。"}, {"si": 387, "ei": 2, "dst": "今天过得不错?"}, {"si": 387, "ei": 3, "dst": "好得不能再好。"}, {"si": 387, "ei": 4, "dst": "来,看看我的舞技……"}, {"si": 387, "ei": 5, "dst": "这是我庆祝太阳的方式。"}, {"si": 387, "ei": 6, "dst": "好了,你走吧。"}, {"si": 387, "ei": 7, "dst": "也许你会对一个又大又多肉的朋友感兴趣?"}, {"si": 387, "ei": 8, "dst": "哦哦。你是说那边神庙里的那个大血肉怪物?"}, {"si": 387, "ei": 9, "dst": "不。我对和它处关系没兴趣。"}, {"si": 387, "ei": 10, "dst": "我是说……衣服很实用。"}, {"si": 387, "ei": 11, "dst": "呜哦。说过了,一本正经。"}, {"si": 387, "ei": 12, "dst": "嘿,我没兴趣。"}, {"si": 387, "ei": 13, "dst": "现在请让我一个人待着。"}, {"si": 387, "ei": 14, "dst": "我走了。"}, {"si": 387, "ei": 15, "dst": "很好。隐私很重要。"}, {"si": 387, "ei": 16, "dst": "你需要帮忙吗?"}, {"si": 387, "ei": 17, "dst": "不用。我不需要帮忙。"}, {"si": 387, "ei": 18, "dst": "哦,好呀。一个同路的旅人。"}, {"si": 387, "ei": 19, "dst": "不过这一带的人有点怪。"}, {"si": 387, "ei": 20, "dst": "我本来在找吃的,但他们只供应生肉。呕呃。"}, {"si": 387, "ei": 21, "dst": "看来只能回去吃植物和土了。"}, {"si": 387, "ei": 22, "dst": "啊好吧,回见。"}, {"si": 387, "ei": 23, "dst": "嘿,欢迎来到我的寒舍。"}, {"si": 387, "ei": 24, "dst": "我觉得这地方看着不错。"}, {"si": 387, "ei": 25, "dst": "也许我会开始布置一下。"}, {"si": 389, "ei": 0, "dst": "呜呼呼……"}, {"si": 389, "ei": 1, "dst": "*咕咚*"}, {"si": 389, "ei": 2, "dst": "呜哇哇哇……"}, {"si": 389, "ei": 3, "dst": "*咕咚*"}, {"si": 389, "ei": 4, "dst": "*嗝*"}, {"si": 389, "ei": 5, "dst": "哦,米尔娅……"}, {"si": 389, "ei": 6, "dst": "*吸鼻子*"}, {"si": 389, "ei": 7, "dst": "你为什么离开我?"}, {"si": 389, "ei": 8, "dst": "哦,我好孤单……"}, {"si": 389, "ei": 9, "dst": "嘿,我给你找到了个人。"}, {"si": 389, "ei": 10, "dst": "这样不好。"}, {"si": 389, "ei": 11, "dst": "我听说你最近哭得很伤心。"}, {"si": 389, "ei": 12, "dst": "让我帮你忘掉这一切。"}, {"si": 389, "ei": 13, "dst": "你什么意思?我不想忘记米尔娅……"}, {"si": 389, "ei": 14, "dst": "哦……哦哦哦……"}, {"si": 389, "ei": 15, "dst": "这条血肉蠕虫怎么样?"}, {"si": 389, "ei": 16, "dst": "我知道,它不是米尔娅。"}, {"si": 389, "ei": 17, "dst": "但也许你只是需要个能照顾的对象。"}, {"si": 389, "ei": 18, "dst": "哦。它好可爱呀。给我。"}, {"si": 389, "ei": 19, "dst": "这样真好。"}, {"si": 389, "ei": 20, "dst": "太——谢谢你……"}, {"si": 389, "ei": 21, "dst": "哦,米尔娅……"}, {"si": 389, "ei": 22, "dst": "我的朋友,你的下一杯酒我请。"}, {"si": 389, "ei": 23, "dst": "*吸鼻子*"}, {"si": 389, "ei": 24, "dst": "谢——谢啦。你是个大好人。"}, {"si": 389, "ei": 25, "dst": "听说你已经哭了一个星期了。"}, {"si": 389, "ei": 26, "dst": "拜托,跟我说说米尔娅吧。"}, {"si": 389, "ei": 27, "dst": "哦……她是外面最可——爱的小蠕虫。"}, {"si": 389, "ei": 28, "dst": "我总——是带着她到处走。"}, {"si": 389, "ei": 29, "dst": "她饿的时候……我就……"}, {"si": 389, "ei": 30, "dst": "我就吐……她就吃。"}, {"si": 389, "ei": 31, "dst": "然后她会给我看她漂亮的小牙牙。"}, {"si": 389, "ei": 32, "dst": "就像……在笑一样。"}, {"si": 389, "ei": 33, "dst": "那么开心,那么可爱。"}, {"si": 389, "ei": 34, "dst": "呜哇哇哇……"}, {"si": 389, "ei": 35, "dst": "*咕咚*"}, {"si": 389, "ei": 36, "dst": "可是后来……你知道……她好奇心重。"}, {"si": 389, "ei": 37, "dst": "总喜欢到处闻来闻去。"}, {"si": 389, "ei": 38, "dst": "她就跑去了那座炮塔。"}, {"si": 389, "ei": 39, "dst": "然后……她……她再也没回来……"}, {"si": 389, "ei": 40, "dst": "呜呼呼。"}, {"si": 389, "ei": 41, "dst": "*吸鼻子*"}, {"si": 389, "ei": 42, "dst": "现在呢?"}, {"si": 389, "ei": 43, "dst": "你自己也清楚,不能再这样下去了,对吧?"}, {"si": 389, "ei": 44, "dst": "你说得对。"}, {"si": 389, "ei": 45, "dst": "我得改变一下了。"}, {"si": 389, "ei": 46, "dst": "我要为米尔娅报仇。"}, {"si": 389, "ei": 47, "dst": "你知道吗?放手去干吧。"}, {"si": 389, "ei": 48, "dst": "千万别。守卫会杀了你的。"}, {"si": 389, "ei": 49, "dst": "这真是个馊主意。"}, {"si": 389, "ei": 50, "dst": "可是……那我该怎么办?"}, {"si": 389, "ei": 51, "dst": "再找一条血肉蠕虫。"}, {"si": 389, "ei": 52, "dst": "你要我替——替掉米尔娅?"}, {"si": 389, "ei": 53, "dst": "可是外面再也没有像她一样的了。"}, {"si": 389, "ei": 54, "dst": "米尔娅是那么*嗝*独一无二。"}, {"si": 389, "ei": 55, "dst": "你就这么想让我忘记?让我再养一条?"}, {"si": 389, "ei": 56, "dst": "你跟打死她的那座炮塔一样坏。"}, {"si": 389, "ei": 57, "dst": "去你的。"}, {"si": 389, "ei": 58, "dst": "我其实没有答案。"}, {"si": 389, "ei": 59, "dst": "我认识你才几分钟,你知道吧。"}, {"si": 389, "ei": 60, "dst": "我并不知道什么能帮你走出来。"}, {"si": 389, "ei": 61, "dst": "做点让自己开心的事。让自己忙起来。放空脑袋。"}, {"si": 389, "ei": 62, "dst": "也许你会在外面遇到谁,填补一点米尔娅留下的空缺。"}, {"si": 389, "ei": 63, "dst": "给自己一点时间就好。"}, {"si": 389, "ei": 64, "dst": "你知道吗?你说得对。"}, {"si": 389, "ei": 65, "dst": "我暂时戒酒了。"}, {"si": 389, "ei": 66, "dst": "太——太谢谢你了。"}, {"si": 389, "ei": 67, "dst": "我从守卫那听说了你的事。"}, {"si": 389, "ei": 68, "dst": "那又怎样?"}, {"si": 389, "ei": 69, "dst": "我想我能帮你。"}, {"si": 389, "ei": 70, "dst": "怎么帮?米尔娅已经没了。什——么都换不回她。"}, {"si": 389, "ei": 71, "dst": "我现在好孤——独。"}, {"si": 389, "ei": 72, "dst": "孤孤单单。"}, {"si": 389, "ei": 73, "dst": "米尔娅……"}, {"si": 389, "ei": 74, "dst": "*咕咚*"}, {"si": 389, "ei": 75, "dst": "别——烦我!"}, {"si": 389, "ei": 76, "dst": "不想说话。"}, {"si": 389, "ei": 77, "dst": "呜哇哇哇……"}, {"si": 389, "ei": 78, "dst": "那酒真是太好了。"}, {"si": 389, "ei": 79, "dst": "我应该多来几次。"}, {"si": 389, "ei": 80, "dst": "哦,既然你帮了我这么多……"}, {"si": 389, "ei": 81, "dst": "拿着这个。"}, {"si": 389, "ei": 82, "dst": "太谢谢你了。"}, {"si": 389, "ei": 83, "dst": "我不会再碰酒了……至少这几天不会。"}, {"si": 389, "ei": 84, "dst": "我确信米尔娅现在正对着泰坦们微笑呢。"}, {"si": 389, "ei": 85, "dst": "你见到我是开心呢,还是裤子里藏了条血肉蠕虫?"}, {"si": 389, "ei": 86, "dst": "对我来说两者都有。"}, {"si": 389, "ei": 87, "dst": "你还为米尔娅难过吗?"}, {"si": 389, "ei": 88, "dst": "米尔娅?那是谁?"}, {"si": 389, "ei": 89, "dst": "纳德说得对。闭嘴。"}, {"si": 389, "ei": 90, "dst": "我们正沉浸在这氛围里呢。"}, {"si": 389, "ei": 91, "dst": "哦,米尔娅……"}]