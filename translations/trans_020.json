[{"si": 649, "ei": 1, "dst": "机械故障:大门无法打开。"}, {"si": 649, "ei": 2, "dst": "[派出机器人。]"}, {"si": 651, "ei": 0, "dst": "你是来加入我的吗?加入我?"}, {"si": 651, "ei": 1, "dst": "我在找一个女人。"}, {"si": 651, "ei": 2, "dst": "女人?女人?"}, {"si": 651, "ei": 3, "dst": "很久以前有两个来过。很久以前。"}, {"si": 651, "ei": 4, "dst": "我记得她们,因为她们是最早的幸存者。最早的幸存者。"}, {"si": 651, "ei": 5, "dst": "但之后就再没见过她们。再没见过。"}, {"si": 651, "ei": 6, "dst": "这是什么地方?"}, {"si": 651, "ei": 7, "dst": "这是我的房间。我的房间。"}, {"si": 651, "ei": 8, "dst": "是我待着执行圣主吩咐的地方。他的吩咐。"}, {"si": 651, "ei": 9, "dst": "他叫我做什么我就做什么。他叫我做。"}, {"si": 651, "ei": 10, "dst": "你为什么这样说话?"}, {"si": 651, "ei": 11, "dst": "我听起来一定很怪。很怪。"}, {"si": 651, "ei": 12, "dst": "我在这里待了很久。很久。"}, {"si": 651, "ei": 13, "dst": "圣主派我来看守这一层。这一层。"}, {"si": 651, "ei": 14, "dst": "他每周给我送食物。每周。"}, {"si": 651, "ei": 15, "dst": "但之后就没什么人来找过我。什么人。"}, {"si": 651, "ei": 16, "dst": "缺少与人交流,我说起话来一定很怪。很怪。"}, {"si": 651, "ei": 17, "dst": "以圣主之名,一个幸存者。幸存者。"}, {"si": 651, "ei": 18, "dst": "一张新面孔。新面孔。"}, {"si": 651, "ei": 19, "dst": "多令人高兴。高兴。"}, {"si": 653, "ei": 1, "dst": "没什么。"}, {"si": 655, "ei": 0, "dst": "新兵!"}, {"si": 655, "ei": 1, "dst": "这里曾是一座工厂。机器用来复制自己的地方。"}, {"si": 655, "ei": 2, "dst": "它们那么多的力量,曾汇聚于此。"}, {"si": 655, "ei": 3, "dst": "想想看,如果它们失去了它。"}, {"si": 655, "ei": 4, "dst": "想想看,如果我们用它们自己的力量对付它们。"}, {"si": 655, "ei": 5, "dst": "这就是我征服此地的理由。"}, {"si": 655, "ei": 6, "dst": "这就是我召集强者的理由。"}, {"si": 655, "ei": 7, "dst": "下一场考核正等着你。祝你好运。"}, {"si": 657, "ei": 0, "dst": "你怎么这么慢?这么慢?"}, {"si": 657, "ei": 1, "dst": "它就在这儿。这儿。"}, {"si": 657, "ei": 2, "dst": "我和那个改造人谈过了。"}, {"si": 657, "ei": 3, "dst": "什么改造人?改造人?"}, {"si": 657, "ei": 4, "dst": "就是你叫的\"碍眼的东西\"。"}, {"si": 657, "ei": 5, "dst": "那其实是个失败的改造人。"}, {"si": 657, "ei": 6, "dst": "看来圣主在创造它的时候没弄好。"}, {"si": 657, "ei": 7, "dst": "这么说这东西更是对圣主荣誉的玷污了?更是玷污?"}, {"si": 657, "ei": 8, "dst": "更有理由杀了它了。杀了它。"}, {"si": 657, "ei": 9, "dst": "不。"}, {"si": 657, "ei": 10, "dst": "他很痛苦。"}, {"si": 657, "ei": 11, "dst": "我们得帮帮他。"}, {"si": 657, "ei": 12, "dst": "滚开。滚。"}, {"si": 657, "ei": 13, "dst": "你自己去帮他吧。帮他。"}, {"si": 657, "ei": 14, "dst": "你说得对。"}, {"si": 657, "ei": 15, "dst": "很好。很好。"}, {"si": 657, "ei": 16, "dst": "现在杀了它。杀。"}, {"si": 657, "ei": 17, "dst": "那个碍眼的东西我处理完了。"}, {"si": 657, "ei": 18, "dst": "干得好。干得好。"}, {"si": 657, "ei": 19, "dst": "你把另一个也处理了。另一个。"}, {"si": 657, "ei": 20, "dst": "我再高兴不过了。高兴。"}, {"si": 657, "ei": 21, "dst": "只剩一个小问题。一个问题。"}, {"si": 657, "ei": 22, "dst": "那边正好还有一个碍眼的东西。那边。"}, {"si": 657, "ei": 23, "dst": "请把它也处理掉。处理掉。"}, {"si": 657, "ei": 24, "dst": "另一个也处理完了。"}, {"si": 657, "ei": 25, "dst": "很好。很好。"}, {"si": 657, "ei": 26, "dst": "我对你的效劳感激不尽。感激不尽。"}, {"si": 657, "ei": 27, "dst": "你是新来的。新来的。"}, {"si": 657, "ei": 28, "dst": "却已经做了了不起的事。了不起。"}, {"si": 657, "ei": 29, "dst": "什么?"}, {"si": 657, "ei": 30, "dst": "你清除了那些碍眼的东西。碍眼的东西。"}, {"si": 657, "ei": 31, "dst": "我高兴得不能再高兴了。不能。"}, {"si": 657, "ei": 32, "dst": "你清除了那个碍眼的东西。碍眼的东西。"}, {"si": 657, "ei": 33, "dst": "不过还有一个。还有一个。"}, {"si": 657, "ei": 34, "dst": "你也应该把它清除。清除。"}, {"si": 657, "ei": 35, "dst": "圣主之美不应被它玷污。不被玷污。"}, {"si": 657, "ei": 36, "dst": "能帮我个忙吗?个忙?"}, {"si": 657, "ei": 37, "dst": "你想干什么?"}, {"si": 657, "ei": 38, "dst": "你看到这个房间了吗。这个房间。"}, {"si": 657, "ei": 39, "dst": "里面有个碍眼的东西。碍眼的东西。"}, {"si": 657, "ei": 40, "dst": "我们得把它弄走。弄走。"}, {"si": 657, "ei": 41, "dst": "他是个改造人。"}, {"si": 657, "ei": 42, "dst": "什么?什么?"}, {"si": 657, "ei": 43, "dst": "我们谈过了。他是个改造人。"}, {"si": 657, "ei": 44, "dst": "而且他很痛苦。"}, {"si": 657, "ei": 45, "dst": "那就更有理由杀了它。更有理由。"}, {"si": 657, "ei": 46, "dst": "不。"}, {"si": 657, "ei": 47, "dst": "他很痛苦。"}, {"si": 657, "ei": 48, "dst": "我们得帮帮他。"}, {"si": 657, "ei": 49, "dst": "滚开。滚。"}, {"si": 657, "ei": 50, "dst": "你自己去帮他吧。帮他。"}, {"si": 657, "ei": 51, "dst": "你说得对。"}, {"si": 657, "ei": 52, "dst": "很好。很好。"}, {"si": 657, "ei": 53, "dst": "现在杀了它。杀。"}, {"si": 657, "ei": 54, "dst": "碍眼的东西?"}, {"si": 657, "ei": 55, "dst": "我不知道还能怎么称呼它。怎么称呼。"}, {"si": 657, "ei": 56, "dst": "它刚从楼上下来的。从楼上。"}, {"si": 657, "ei": 57, "dst": "然后我们抓住它,关在这里。在这里。"}, {"si": 657, "ei": 58, "dst": "其他人说是圣主造了它。圣主造了它。"}, {"si": 657, "ei": 59, "dst": "但那不可能。不可能。"}, {"si": 657, "ei": 60, "dst": "圣主只创造完美。完美。"}, {"si": 657, "ei": 61, "dst": "而不是……这个。不是这个。"}, {"si": 657, "ei": 62, "dst": "那我这就去。"}, {"si": 657, "ei": 63, "dst": "你回来了。回来了。"}, {"si": 657, "ei": 64, "dst": "你真是了不起。了不起。"}, {"si": 657, "ei": 65, "dst": "你还在等什么?等什么?"}, {"si": 657, "ei": 66, "dst": "那碍眼的东西就在那边的小房间里。那边。"}, {"si": 657, "ei": 67, "dst": "嗯,另一个碍眼的东西已经没了。"}, {"si": 657, "ei": 68, "dst": "是,是。"}, {"si": 657, "ei": 69, "dst": "我再高兴不过了。高兴。"}, {"si": 657, "ei": 70, "dst": "圣主再次纯净无瑕了。再次。"}, {"si": 657, "ei": 71, "dst": "你不是想帮那东西吗。帮。"}, {"si": 657, "ei": 72, "dst": "但它还是没了。没了。"}, {"si": 657, "ei": 73, "dst": "你真是彻底没用。没用。"}, {"si": 657, "ei": 74, "dst": "你竟想帮那东西。那东西。"}, {"si": 657, "ei": 75, "dst": "你知道这不会让圣主高兴的。圣主。"}, {"si": 657, "ei": 76, "dst": "我的计划成功了。成功了。"}, {"si": 657, "ei": 77, "dst": "你可真蠢。真蠢。"}, {"si": 657, "ei": 78, "dst": "你是新来的。新来的。"}, {"si": 657, "ei": 79, "dst": "帮我除掉这个房间里的碍眼的东西。碍眼的东西。"}, {"si": 657, "ei": 80, "dst": "不,我要帮他。"}, {"si": 657, "ei": 81, "dst": "他很痛苦。"}, {"si": 657, "ei": 82, "dst": "你竟想帮那东西。那东西。"}, {"si": 657, "ei": 83, "dst": "你有什么能帮上忙的东西吗?"}, {"si": 657, "ei": 84, "dst": "帮忙?帮忙?"}, {"si": 657, "ei": 85, "dst": "我为什么要帮你这个?帮你?"}, {"si": 657, "ei": 86, "dst": "那碍眼的东西必须消失。必须消失。"}, {"si": 657, "ei": 87, "dst": "可他是圣主造的,不是吗?"}, {"si": 657, "ei": 88, "dst": "你说得对。说得对。"}, {"si": 657, "ei": 89, "dst": "这个也许有用。也许。"}, {"si": 657, "ei": 90, "dst": "但我不太确定是否真有用。不太确定。"}, {"si": 657, "ei": 91, "dst": "谢谢你。"}, {"si": 657, "ei": 92, "dst": "求你了?"}, {"si": 657, "ei": 93, "dst": "既然你坚持。坚持。"}, {"si": 657, "ei": 94, "dst": "我可以给你这个。给你。"}, {"si": 657, "ei": 95, "dst": "我确信它会管用。会管用。"}, {"si": 657, "ei": 96, "dst": "相信我。相信我。"}, {"si": 659, "ei": 0, "dst": "你。幸存者?"}, {"si": 659, "ei": 1, "dst": "我。幸存者。"}, {"si": 659, "ei": 2, "dst": "你是什么?"}, {"si": 659, "ei": 3, "dst": "我。改造人。"}, {"si": 659, "ei": 4, "dst": "差点。死了。"}, {"si": 659, "ei": 5, "dst": "圣主。找到。我。"}, {"si": 659, "ei": 6, "dst": "带走。我。"}, {"si": 659, "ei": 7, "dst": "修好。我。"}, {"si": 659, "ei": 8, "dst": "给了。身体。"}, {"si": 659, "ei": 9, "dst": "圣主。好。"}, {"si": 659, "ei": 10, "dst": "圣主。强。"}, {"si": 659, "ei": 11, "dst": "我。活着。"}, {"si": 659, "ei": 12, "dst": "我在找止痛药的原料。"}, {"si": 659, "ei": 13, "dst": "你有什么能帮上忙的东西吗?"}, {"si": 659, "ei": 14, "dst": "止痛。药。为什么?"}, {"si": 659, "ei": 15, "dst": "那边还有一个跟你一样的。"}, {"si": 659, "ei": 16, "dst": "他很痛苦。"}, {"si": 659, "ei": 17, "dst": "想。帮忙。"}, {"si": 659, "ei": 18, "dst": "但是。没有。东西。"}, {"si": 659, "ei": 19, "dst": "非常。抱歉。"}, {"si": 659, "ei": 20, "dst": "但是。只有。旧。脑。"}, {"si": 659, "ei": 21, "dst": "帮不上。忙。"}, {"si": 659, "ei": 22, "dst": "我其实正需要一个脑。"}, {"si": 659, "ei": 23, "dst": "真的?"}, {"si": 659, "ei": 24, "dst": "请。拿去。"}, {"si": 659, "ei": 25, "dst": "旧。脑。你的。了。"}, {"si": 661, "ei": 0, "dst": "求。你。救。我。"}, {"si": 661, "ei": 1, "dst": "痛。很痛。痛。忍不了。痛。"}, {"si": 661, "ei": 2, "dst": "求。别。丢下我。"}, {"si": 661, "ei": 3, "dst": "看,我给你带了止痛药。"}, {"si": 661, "ei": 4, "dst": "止痛。药?"}, {"si": 661, "ei": 5, "dst": "对。给。"}, {"si": 661, "ei": 6, "dst": "味道。难闻。"}, {"si": 661, "ei": 7, "dst": "但。会。吃。"}, {"si": 661, "ei": 8, "dst": "这。是什么?"}, {"si": 661, "ei": 9, "dst": "痛。痛。"}, {"si": 661, "ei": 10, "dst": "痛。更痛。了。"}, {"si": 661, "ei": 11, "dst": "谢。谢。"}, {"si": 661, "ei": 12, "dst": "感激。"}, {"si": 661, "ei": 14, "dst": "痛。没了。"}, {"si": 661, "ei": 15, "dst": "外面那个人要我杀了你。"}, {"si": 661, "ei": 16, "dst": "这。可以。"}, {"si": 661, "ei": 17, "dst": "太多。痛苦。"}, {"si": 661, "ei": 18, "dst": "太多。折磨。"}, {"si": 661, "ei": 19, "dst": "求。快点。"}, {"si": 661, "ei": 20, "dst": "你……是谁?"}, {"si": 661, "ei": 21, "dst": "我。改造人。"}, {"si": 661, "ei": 22, "dst": "我。失败品。"}, {"si": 661, "ei": 23, "dst": "圣主。试过。"}, {"si": 661, "ei": 24, "dst": "没。成功。"}, {"si": 661, "ei": 25, "dst": "痛。"}, {"si": 661, "ei": 26, "dst": "帮。救我。"}, {"si": 661, "ei": 27, "dst": "你。帮了我。"}, {"si": 661, "ei": 28, "dst": "痛。没了。"}, {"si": 661, "ei": 29, "dst": "感激。"}, {"si": 663, "ei": 0, "dst": "干得好,拿到那把钥匙了。"}, {"si": 663, "ei": 1, "dst": "改造人?圣主?"}, {"si": 663, "ei": 2, "dst": "是的。我们改造人是他的造物。"}, {"si": 663, "ei": 3, "dst": "他收留我们这些孱弱的人类,并强化我们。"}, {"si": 663, "ei": 4, "dst": "释放我们的潜能。"}, {"si": 663, "ei": 5, "dst": "等时机成熟,我们便能加入他对抗机器的战斗。"}, {"si": 663, "ei": 6, "dst": "你说话怎么不重复?"}, {"si": 663, "ei": 7, "dst": "你是说你上楼时遇到的那些监工,还是这里的科学家?"}, {"si": 663, "ei": 8, "dst": "我们和他们不一样。"}, {"si": 663, "ei": 9, "dst": "我是改造人。曾经只是一副血肉之躯,被圣主强化改良。"}, {"si": 663, "ei": 10, "dst": "而他们仍是未经改造的人类。"}, {"si": 663, "ei": 11, "dst": "圣主选中他们为自己效力。"}, {"si": 663, "ei": 12, "dst": "所以他们非常重要。"}, {"si": 663, "ei": 13, "dst": "你是谁?"}, {"si": 663, "ei": 14, "dst": "我叫德伦。"}, {"si": 663, "ei": 15, "dst": "独一无二之圣主的改造人守卫。"}, {"si": 663, "ei": 16, "dst": "我有钥匙。"}, {"si": 663, "ei": 17, "dst": "克鲁沃总是说真话。"}, {"si": 663, "ei": 18, "dst": "你有钥匙。给我!"}, {"si": 663, "ei": 19, "dst": "哦不。抱歉,但你猜错了。"}, {"si": 663, "ei": 20, "dst": "给我们点时间重新安排,然后再来试。"}, {"si": 663, "ei": 21, "dst": "恭喜。你猜对了。"}, {"si": 663, "ei": 22, "dst": "拿去吧,快去见圣主。"}, {"si": 663, "ei": 23, "dst": "他一定很想见见新来的人。"}, {"si": 663, "ei": 24, "dst": "克鲁沃总是撒谎。"}, {"si": 663, "ei": 25, "dst": "我没有钥……"}, {"si": 663, "ei": 27, "dst": "等等,我真没有。"}, {"si": 663, "ei": 28, "dst": "你是对我使了什么偷鸡摸狗的手段?"}, {"si": 663, "ei": 29, "dst": "我没有钥匙。"}, {"si": 663, "ei": 30, "dst": "我没有钥匙。"}, {"si": 663, "ei": 31, "dst": "我有钥……"}, {"si": 663, "ei": 33, "dst": "显然我没有钥匙。"}, {"si": 663, "ei": 34, "dst": "我有钥匙。"}, {"si": 665, "ei": 0, "dst": "你……你拿到钥匙了?你真行。"}, {"si": 665, "ei": 1, "dst": "你也是改造人?"}, {"si": 665, "ei": 2, "dst": "有那么明显吗?"}, {"si": 665, "ei": 3, "dst": "我本来并不想。"}, {"si": 665, "ei": 4, "dst": "但被说服了。"}, {"si": 665, "ei": 5, "dst": "至少我现在强壮了一点。"}, {"si": 665, "ei": 6, "dst": "你说话怎么不重复?"}, {"si": 665, "ei": 7, "dst": "我不确定你什么意思。"}, {"si": 665, "ei": 8, "dst": "我为什么要重复自己?"}, {"si": 665, "ei": 9, "dst": "我是说,塔里好多人都这样。"}, {"si": 665, "ei": 10, "dst": "是吗?"}, {"si": 665, "ei": 11, "dst": "我没注意到。"}, {"si": 665, "ei": 12, "dst": "你是谁?"}, {"si": 665, "ei": 13, "dst": "我是克鲁沃。"}, {"si": 665, "ei": 14, "dst": "谢谢你的关心。"}, {"si": 665, "ei": 15, "dst": "钥匙在我这儿。真的。"}, {"si": 665, "ei": 16, "dst": "班恩总是说真话。请相信他。"}, {"si": 665, "ei": 17, "dst": "你有钥匙。给我!"}, {"si": 665, "ei": 18, "dst": "抱歉,但你猜错了。我没有。"}, {"si": 665, "ei": 19, "dst": "请过一会儿再试。好吗?"}, {"si": 665, "ei": 20, "dst": "你……你是怎么知道的?"}, {"si": 665, "ei": 21, "dst": "你一定非常聪明。"}, {"si": 665, "ei": 22, "dst": "给,请收下。"}, {"si": 665, "ei": 23, "dst": "班恩是……班恩在撒谎。"}, {"si": 665, "ei": 24, "dst": "我没有钥……"}, {"si": 665, "ei": 26, "dst": "等等,我真没有。"}, {"si": 665, "ei": 27, "dst": "操。"}, {"si": 665, "ei": 28, "dst": "我把它弄丢了?"}, {"si": 665, "ei": 29, "dst": "哦等等……是你从我身上拿走的?"}, {"si": 665, "ei": 30, "dst": "说实话,真厉害。"}, {"si": 665, "ei": 31, "dst": "抱歉,我没有钥匙。"}, {"si": 665, "ei": 32, "dst": "抱歉,我没有钥匙。"}, {"si": 665, "ei": 33, "dst": "我有钥……"}, {"si": 665, "ei": 35, "dst": "没了。"}, {"si": 665, "ei": 36, "dst": "钥匙在我这儿。真的。"}, {"si": 667, "ei": 0, "dst": "干得好,拿到钥匙了。"}, {"si": 667, "ei": 1, "dst": "现在走吧。随你怎么用它。"}, {"si": 667, "ei": 2, "dst": "你是改造人?"}, {"si": 667, "ei": 3, "dst": "是啊。圣主给了我这个机会,我抓住了,就有了现在的我。"}, {"si": 667, "ei": 4, "dst": "强壮多了,还有份看大门的轻松差事。"}, {"si": 667, "ei": 5, "dst": "他还说了些即将来临的战争之类的事。"}, {"si": 667, "ei": 6, "dst": "真期待啊。"}, {"si": 667, "ei": 7, "dst": "你说话怎么不重复?"}, {"si": 667, "ei": 8, "dst": "你敢拿我跟那些……人比。"}, {"si": 667, "ei": 9, "dst": "\"我说句话。说句话。\""}, {"si": 667, "ei": 10, "dst": "真他妈烦人。"}, {"si": 667, "ei": 11, "dst": "所以我才在外头站岗,不跟其他人待在里面。"}, {"si": 667, "ei": 12, "dst": "要是他们像我们一样变成改造人。能太平多少啊。"}, {"si": 667, "ei": 13, "dst": "你是谁?"}, {"si": 667, "ei": 14, "dst": "班恩。"}, {"si": 667, "ei": 16, "dst": "什么?!"}, {"si": 667, "ei": 17, "dst": "我还指望你不只说个名字呢。"}, {"si": 667, "ei": 18, "dst": "你想打架?"}, {"si": 667, "ei": 19, "dst": "不。抱歉。"}, {"si": 667, "ei": 20, "dst": "很好。"}, {"si": 667, "ei": 21, "dst": "是。"}, {"si": 667, "ei": 22, "dst": "我有钥匙。"}, {"si": 667, "ei": 23, "dst": "阿斯格总是说真话。"}, {"si": 667, "ei": 24, "dst": "你有钥匙。给我!"}, {"si": 667, "ei": 25, "dst": "哈!错了!"}, {"si": 667, "ei": 26, "dst": "过会儿再试吧,如果你觉得自己还行。"}, {"si": 667, "ei": 27, "dst": "想明白了,是吧?还是瞎蒙的?"}, {"si": 667, "ei": 28, "dst": "反正无所谓。"}, {"si": 667, "ei": 29, "dst": "拿上钥匙,进去吧。"}, {"si": 667, "ei": 30, "dst": "阿斯格总是撒谎。"}, {"si": 667, "ei": 31, "dst": "我没有钥……"}, {"si": 667, "ei": 33, "dst": "哦你啊。"}, {"si": 667, "ei": 34, "dst": "你从我口袋里偷的,对吧。"}, {"si": 667, "ei": 35, "dst": "行吧,你既然拿到了,就继续走吧。"}, {"si": 667, "ei": 36, "dst": "我没有钥匙。"}, {"si": 667, "ei": 37, "dst": "我没有钥匙。"}, {"si": 667, "ei": 38, "dst": "我有钥……"}, {"si": 667, "ei": 39, "dst": "我有钥匙。"}, {"si": 669, "ei": 0, "dst": "干得好,人类。钥匙已到手。"}, {"si": 669, "ei": 1, "dst": "你是改造人?"}, {"si": 669, "ei": 2, "dst": "我是改造人。"}, {"si": 669, "ei": 3, "dst": "我已获改良。"}, {"si": 669, "ei": 4, "dst": "不必惧怕我,人类。"}, {"si": 669, "ei": 5, "dst": "我曾与你一样,人类。"}, {"si": 669, "ei": 6, "dst": "赞美圣主。"}, {"si": 669, "ei": 7, "dst": "我是他的工具。"}, {"si": 669, "ei": 8, "dst": "你说话为何不作重复?"}, {"si": 669, "ei": 9, "dst": "我是改造人。"}, {"si": 669, "ei": 10, "dst": "我已获改良。"}, {"si": 669, "ei": 11, "dst": "我的逻辑清晰。"}, {"si": 669, "ei": 12, "dst": "我正在脱离人类的语言模式。"}, {"si": 669, "ei": 13, "dst": "我不会像那些人类那样重复自己。"}, {"si": 669, "ei": 14, "dst": "我超越你们与他们的理解。"}, {"si": 669, "ei": 15, "dst": "你是谁?"}, {"si": 669, "ei": 16, "dst": "编号:阿斯格"}, {"si": 669, "ei": 17, "dst": "伟大圣主麾下之门卫。"}, {"si": 669, "ei": 18, "dst": "干得好,改造人同胞。钥匙已到手。"}, {"si": 669, "ei": 19, "dst": "我有钥匙。"}, {"si": 669, "ei": 20, "dst": "德伦在说真话。"}, {"si": 669, "ei": 21, "dst": "你有钥匙。交给我!"}, {"si": 669, "ei": 22, "dst": "错误。我们将重新部署。"}, {"si": 669, "ei": 23, "dst": "正确。"}, {"si": 669, "ei": 24, "dst": "这是你的奖励。"}, {"si": 669, "ei": 25, "dst": "德伦在撒谎。"}, {"si": 669, "ei": 26, "dst": "我没有钥……"}, {"si": 669, "ei": 28, "dst": "我没有钥匙。"}, {"si": 669, "ei": 29, "dst": "你必定使用了隐蔽手段从我处取得。"}, {"si": 669, "ei": 30, "dst": "祝贺你找到如此出人意料的解法。"}, {"si": 669, "ei": 31, "dst": "我没有钥匙。"}, {"si": 669, "ei": 32, "dst": "我没有钥匙。"}, {"si": 669, "ei": 33, "dst": "我有钥……"}, {"si": 669, "ei": 35, "dst": "我没有钥匙。"}, {"si": 669, "ei": 36, "dst": "我有钥匙。"}, {"si": 671, "ei": 0, "dst": "我再解释一遍。"}, {"si": 671, "ei": 1, "dst": "在寻找钥匙的过程中,每一位守卫要么永远对你说真话,要么永远撒谎。"}, {"si": 671, "ei": 2, "dst": "如果你猜错了,我们就换一批。"}]