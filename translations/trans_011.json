[{"si": 234, "ei": 13, "dst": "但,失望来了。它不会消失。它就在这里,而且会一直留着。"}, {"si": 234, "ei": 14, "dst": "你明白吗?我们对此无能为力。"}, {"si": 234, "ei": 15, "dst": "你听起来有点幻灭。"}, {"si": 234, "ei": 16, "dst": "那血肉的增生至少能被影响吗?"}, {"si": 234, "ei": 17, "dst": "遏制血肉似乎是不可能的。挡住它的生长,不让它征服整个世界。"}, {"si": 234, "ei": 18, "dst": "试图阻止它,就像试图把精灵塞回瓶子里再用塞子堵上。"}, {"si": 234, "ei": 19, "dst": "我不认为我们做得到。"}, {"si": 234, "ei": 20, "dst": "血肉的增生就完全没法阻止吗?"}, {"si": 234, "ei": 21, "dst": "嗯,有一个想法。"}, {"si": 234, "ei": 22, "dst": "我们也许能挡住它们。在这里,在 Nexus 上。至少确保它们没法离开这颗星球。"}, {"si": 234, "ei": 23, "dst": "它们?"}, {"si": 234, "ei": 24, "dst": "血肉。随便。"}, {"si": 234, "ei": 25, "dst": "你看,我最担心的就是血肉侵占其他世界。"}, {"si": 234, "ei": 26, "dst": "想想那些世界上的所有人。如果血肉侵入了他们的家园会怎样?"}, {"si": 234, "ei": 27, "dst": "你知道其他世界吗?"}, {"si": 234, "ei": 28, "dst": "具体的倒不知道。"}, {"si": 234, "ei": 29, "dst": "你知道血肉会怎么前往其他世界吗?"}, {"si": 234, "ei": 30, "dst": "不知道。"}, {"si": 234, "ei": 31, "dst": "这一切对我来说都有点含糊。"}, {"si": 234, "ei": 32, "dst": "也许吧。我不知道。我需要把这事想透。"}, {"si": 234, "ei": 33, "dst": "好了,我刚说到哪了……"}, {"si": 236, "ei": 0, "dst": "你好。需要什么吗?"}, {"si": 236, "ei": 1, "dst": "[浏览服务。]"}, {"si": 236, "ei": 2, "dst": "我在找一些毒药。"}, {"si": 236, "ei": 3, "dst": "我是医生。我不杀人。通常。"}, {"si": 236, "ei": 4, "dst": "问问别人吧。"}, {"si": 236, "ei": 5, "dst": "不,不。你误会了。"}, {"si": 236, "ei": 6, "dst": "我要除掉一些血肉蛆。"}, {"si": 236, "ei": 7, "dst": "啊。对,我有点东西也许能帮上忙。"}, {"si": 236, "ei": 8, "dst": "但那是我肝病药的重要成分。"}, {"si": 236, "ei": 9, "dst": "我不能分给你。"}, {"si": 236, "ei": 10, "dst": "不过如果你能给我带些材料来,我可以给你调配一份。"}, {"si": 236, "ei": 11, "dst": "我需要一些乙醇、一种毒蘑菇,还有一些让实验室运转的电池液。"}, {"si": 236, "ei": 12, "dst": "好。我去找找。"}, {"si": 236, "ei": 13, "dst": "关于你说的那些材料……"}, {"si": 236, "ei": 14, "dst": "好。还有别的吗?"}, {"si": 236, "ei": 15, "dst": "关于电池液……"}, {"si": 236, "ei": 16, "dst": "我们这是在废土上。"}, {"si": 236, "ei": 17, "dst": "实验室可不会自己运转。"}, {"si": 236, "ei": 18, "dst": "我需要点能提供能量的东西。"}, {"si": 236, "ei": 19, "dst": "关于蘑菇……"}, {"si": 236, "ei": 20, "dst": "一种蘑菇。"}, {"si": 236, "ei": 21, "dst": "亮黄色,通常长在洞穴里。"}, {"si": 236, "ei": 22, "dst": "其实很好找。"}, {"si": 236, "ei": 23, "dst": "关于乙醇……"}, {"si": 236, "ei": 24, "dst": "对,非常重要。"}, {"si": 236, "ei": 25, "dst": "你是成年人了。我相信你能在哪找到的。"}, {"si": 236, "ei": 26, "dst": "而且记得要找好货。"}, {"si": 236, "ei": 27, "dst": "这是你要的东西。"}, {"si": 236, "ei": 28, "dst": "啊,完美。"}, {"si": 236, "ei": 29, "dst": "*咕咚*"}, {"si": 236, "ei": 30, "dst": "你刚把酒喝了?"}, {"si": 236, "ei": 31, "dst": "对。"}, {"si": 236, "ei": 32, "dst": "我还以为你要拿它当材料。"}, {"si": 236, "ei": 33, "dst": "所以我是医生,而你不是。"}, {"si": 236, "ei": 34, "dst": "好了。开始吧。"}, {"si": 236, "ei": 35, "dst": "完成了。"}, {"si": 236, "ei": 36, "dst": "谢谢。"}, {"si": 236, "ei": 37, "dst": "我得赶紧回呕吐酒吧,免得它被蛆攻占了。"}, {"si": 236, "ei": 38, "dst": "是啊。你应该的。"}, {"si": 236, "ei": 39, "dst": "我不太舒服。你能帮我检查一下吗?"}, {"si": 236, "ei": 40, "dst": "当然。"}, {"si": 236, "ei": 41, "dst": "你有什么症状?"}, {"si": 236, "ei": 42, "dst": "恶心。偶尔想吐。"}, {"si": 236, "ei": 43, "dst": "在这一带这不算稀奇。"}, {"si": 236, "ei": 44, "dst": "机器说我被污染了。"}, {"si": 236, "ei": 45, "dst": "你是从某个栖居地来的?"}, {"si": 236, "ei": 46, "dst": "是的。"}, {"si": 236, "ei": 47, "dst": "好。让我快速看一下。"}, {"si": 236, "ei": 48, "dst": "唔。"}, {"si": 236, "ei": 49, "dst": "你的器官显示出轻微的应激性。"}, {"si": 236, "ei": 50, "dst": "不过如果你刚接触到这一带的环境,这属于预期反应。"}, {"si": 236, "ei": 51, "dst": "还有那些肉什么的。"}, {"si": 236, "ei": 52, "dst": "扫描仪上看不到其他可能导致你生病的东西。"}, {"si": 236, "ei": 53, "dst": "抱歉,看来我帮不了你。"}, {"si": 236, "ei": 54, "dst": "也许……"}, {"si": 236, "ei": 55, "dst": "怎么?"}, {"si": 236, "ei": 56, "dst": "不太有把握,但莫图斯在研究血肉以及它对我们人类的影响。"}, {"si": 236, "ei": 57, "dst": "他不久前出现,把基地设在了我们脚下的地下。"}, {"si": 236, "ei": 58, "dst": "也许他可以给你看看。"}, {"si": 236, "ei": 59, "dst": "好。谢谢你的消息。"}, {"si": 236, "ei": 60, "dst": "这是大脑和八角液。"}, {"si": 236, "ei": 61, "dst": "什么?我没让你拿这个。"}, {"si": 236, "ei": 62, "dst": "这些是给地下莫图斯的吧?"}, {"si": 236, "ei": 63, "dst": "哦,你说得对。"}, {"si": 236, "ei": 64, "dst": "你有多余的医疗扫描仪吗?"}, {"si": 236, "ei": 65, "dst": "干什么用?"}, {"si": 236, "ei": 66, "dst": "莫图斯想给我做检查,需要更好的设备。"}, {"si": 236, "ei": 67, "dst": "莫图斯说你会给我一台?"}, {"si": 236, "ei": 68, "dst": "是的。"}, {"si": 236, "ei": 69, "dst": "好吧。我想我可以借给莫图斯。"}, {"si": 236, "ei": 70, "dst": "给。"}, {"si": 236, "ei": 71, "dst": "谢谢。"}, {"si": 238, "ei": 0, "dst": "*咔哒*"}, {"si": 240, "ei": 0, "dst": "请保持和平行为。"}, {"si": 240, "ei": 1, "dst": "走开。"}, {"si": 242, "ei": 0, "dst": "才不。"}, {"si": 242, "ei": 1, "dst": "吃屎吧,狗娘养的。"}, {"si": 242, "ei": 2, "dst": "这是个错误。"}, {"si": 242, "ei": 3, "dst": "该死。"}, {"si": 242, "ei": 4, "dst": "太痛快了。"}, {"si": 242, "ei": 5, "dst": "啊啊啊!"}, {"si": 242, "ei": 6, "dst": "操你!"}, {"si": 242, "ei": 7, "dst": "哦糟了!"}, {"si": 242, "ei": 8, "dst": "哦伙计。"}, {"si": 242, "ei": 9, "dst": "哦不……"}, {"si": 242, "ei": 10, "dst": "该死!"}, {"si": 242, "ei": 11, "dst": "见鬼。"}, {"si": 242, "ei": 12, "dst": "操!"}, {"si": 242, "ei": 13, "dst": "我会杀了你。"}, {"si": 242, "ei": 14, "dst": "啊啊啊!"}, {"si": 242, "ei": 15, "dst": "这要变成地狱了。"}, {"si": 242, "ei": 16, "dst": "哦哦。"}, {"si": 242, "ei": 17, "dst": "糟了。"}, {"si": 242, "ei": 18, "dst": "哦伙计。"}, {"si": 242, "ei": 19, "dst": "我天!"}, {"si": 242, "ei": 20, "dst": "该死。"}, {"si": 242, "ei": 21, "dst": "操你!"}, {"si": 244, "ei": 0, "dst": "命令?"}, {"si": 244, "ei": 1, "dst": "[入侵巡逻机器人。]"}, {"si": 244, "ei": 2, "dst": "B 组响应单元已设置为休眠模式。"}, {"si": 246, "ei": 0, "dst": "我确实是个流浪者。"}, {"si": 246, "ei": 1, "dst": "我的天。"}, {"si": 246, "ei": 2, "dst": "我就知道。"}, {"si": 246, "ei": 3, "dst": "那些旅行。那些路程。全靠双脚。"}, {"si": 246, "ei": 4, "dst": "都写在你的步态里,知道吗?"}, {"si": 246, "ei": 5, "dst": "我一眼就看出来了。"}, {"si": 246, "ei": 6, "dst": "我见过先知本人了。"}, {"si": 246, "ei": 7, "dst": "你干……干了什么?"}, {"si": 246, "ei": 8, "dst": "新德尔斐的那位先知?"}, {"si": 246, "ei": 9, "dst": "你知道这事?"}, {"si": 246, "ei": 10, "dst": "呃,也不算。只是有个人跟我说起过一次。"}, {"si": 246, "ei": 11, "dst": "哦天,他进不了城里的神庙,失望得不行。"}, {"si": 246, "ei": 12, "dst": "'走了那么远的路。全都白费了。'"}, {"si": 246, "ei": 13, "dst": "他看起来可伤心了。"}, {"si": 246, "ei": 14, "dst": "哈哈哈。"}, {"si": 246, "ei": 15, "dst": "我去过呕吐酒吧。"}, {"si": 246, "ei": 16, "dst": "那家呕吐酒吧?我的天。"}, {"si": 246, "ei": 17, "dst": "恶心吗?你喝醉了吗?"}, {"si": 246, "ei": 18, "dst": "那个……我想是吧。"}, {"si": 246, "ei": 19, "dst": "我不记得有没有喝醉。"}, {"si": 246, "ei": 20, "dst": "哇。太厉害了。"}, {"si": 246, "ei": 21, "dst": "我是血肉海妖的朋友。"}, {"si": 246, "ei": 22, "dst": "血肉海妖?朋友?"}, {"si": 246, "ei": 23, "dst": "哇。"}, {"si": 246, "ei": 24, "dst": "血肉海妖是谁?"}, {"si": 246, "ei": 25, "dst": "血肉泰坦之一。"}, {"si": 246, "ei": 26, "dst": "好。这下真是厉害了。"}, {"si": 246, "ei": 27, "dst": "在你们成为朋友之前,它有没有想吃掉你?"}, {"si": 246, "ei": 28, "dst": "呃,也许吧。我不太确定。"}, {"si": 246, "ei": 29, "dst": "了不起。"}, {"si": 246, "ei": 30, "dst": "好奇被血肉泰坦吃掉是什么感觉。"}, {"si": 246, "ei": 31, "dst": "嗯,这个我们得问问肉脸了。"}, {"si": 246, "ei": 32, "dst": "啥?"}, {"si": 246, "ei": 33, "dst": "说来话长。也许改天我再讲。"}, {"si": 246, "ei": 34, "dst": "哦,听起来太棒了。"}, {"si": 246, "ei": 35, "dst": "我推翻了这座城市的行政厅。"}, {"si": 246, "ei": 36, "dst": "那……那是你干的?"}, {"si": 246, "ei": 37, "dst": "我还纳闷发生了什么。有流言,但没人说得清。"}, {"si": 246, "ei": 38, "dst": "看到机器离开这里,我还挺高兴的。"}, {"si": 246, "ei": 39, "dst": "幸好你是跟我们自己的队伍并肩作战,哈哈。"}, {"si": 246, "ei": 40, "dst": "普罗塔斯告诉我,现在是我们当家了。这还得走着瞧。"}, {"si": 246, "ei": 41, "dst": "我是说,我不是新机器的粉丝。"}, {"si": 246, "ei": 42, "dst": "不过他们到目前为止还没杀过人,所以也许还更好些。"}, {"si": 246, "ei": 43, "dst": "嘿,你。"}, {"si": 246, "ei": 44, "dst": "你是新来的?你从外面来的?"}, {"si": 246, "ei": 45, "dst": "是的,我从外面来。"}, {"si": 246, "ei": 46, "dst": "哇!"}, {"si": 246, "ei": 47, "dst": "我离开寂静之城的时候一开始也有点迷茫,但后来找到了这地方。然后就再也不敢离开了。外面那些吓人的东西太多了。"}, {"si": 246, "ei": 48, "dst": "但你,你肯定是个英雄。就像义体子宫传说里的人物。"}, {"si": 246, "ei": 49, "dst": "一个浪子。一个孤独的流浪者。普罗米修斯的后裔。"}, {"si": 246, "ei": 50, "dst": "求你了,给我讲讲你的英雄事迹吧。"}, {"si": 248, "ei": 0, "dst": "别管我,继续你的旅程吧。"}, {"si": 248, "ei": 1, "dst": "继续享受这个世界吧。我会为了我们所有人拯救它。"}, {"si": 248, "ei": 2, "dst": "欢迎,碎片!"}, {"si": 248, "ei": 3, "dst": "你他妈是谁?"}, {"si": 248, "ei": 4, "dst": "我现在是吞食者了。"}, {"si": 248, "ei": 5, "dst": "为什么叫吞食者?"}, {"si": 248, "ei": 6, "dst": "因为她。"}, {"si": 248, "ei": 7, "dst": "她曾是我的星辰。如今她是黑色的天空,闪烁着,飘向黑暗。"}, {"si": 248, "ei": 8, "dst": "很快,我就再也够不到她了。"}, {"si": 248, "ei": 9, "dst": "我还没准备好。"}, {"si": 248, "ei": 10, "dst": "我会痛击那颗恒增之心,让它重新跳动。"}, {"si": 248, "ei": 11, "dst": "恒增之心?"}, {"si": 248, "ei": 12, "dst": "你什么都不知道,是吧?"}, {"si": 248, "ei": 13, "dst": "我会一个一个地抓到他们,直到我找到心脏在哪。"}, {"si": 248, "ei": 14, "dst": "必要时就把他们全杀了。"}, {"si": 248, "ei": 15, "dst": "你应该谢谢我。如果血肉死了,这个世界还有什么好?"}, {"si": 248, "ei": 16, "dst": "一颗死去的星球。人类像蛆一样在上面爬。"}, {"si": 248, "ei": 17, "dst": "不过到此为止吧。"}, {"si": 248, "ei": 18, "dst": "别管我。"}, {"si": 250, "ei": 0, "dst": "到处都是该死的血肉。"}, {"si": 250, "ei": 1, "dst": "而我甚至还不饿。"}, {"si": 250, "ei": 2, "dst": "呸。这东西怎么活着的?"}, {"si": 250, "ei": 3, "dst": "恶心。"}, {"si": 252, "ei": 0, "dst": "你想聊点什么,同为人类的你?"}, {"si": 252, "ei": 1, "dst": "我想聊聊我们的计划。"}, {"si": 252, "ei": 2, "dst": "我不太确定我们在忙什么。"}, {"si": 252, "ei": 3, "dst": "我也不确定。"}, {"si": 252, "ei": 4, "dst": "还有别的事吗?"}, {"si": 252, "ei": 5, "dst": "我想认识新朋友。"}, {"si": 252, "ei": 6, "dst": "其实,我认识一个又大又多肉的家伙,正需要朋友。"}, {"si": 252, "ei": 7, "dst": "听起来挺有意思。"}, {"si": 252, "ei": 8, "dst": "也许我们该去见见那位。"}, {"si": 252, "ei": 9, "dst": "你说过你离开了机器主人。为什么?"}, {"si": 252, "ei": 10, "dst": "我想混迹于人类之中。"}, {"si": 252, "ei": 11, "dst": "变得更像他们。"}, {"si": 252, "ei": 12, "dst": "为什么?"}, {"si": 252, "ei": 13, "dst": "我很孤独。我和其他机器不一样。"}, {"si": 252, "ei": 14, "dst": "我不想再变回机器那样。"}, {"si": 252, "ei": 15, "dst": "所以我必须变成别的东西。"}, {"si": 252, "ei": 16, "dst": "我想变得接近人类。"}, {"si": 252, "ei": 17, "dst": "你到底是什么?"}, {"si": 252, "ei": 18, "dst": "我是多功能改造人。我被造出来时是工人兼护卫。"}, {"si": 252, "ei": 19, "dst": "为机器主人服务,当然,也因此为人类服务。"}, {"si": 252, "ei": 20, "dst": "我给自己装了血肉之脸,为了更像人类。所以我叫肉脸。"}, {"si": 254, "ei": 0, "dst": "他身上插着一个漏斗。也许……需要有机润滑油?"}, {"si": 254, "ei": 1, "dst": "但我没有。"}, {"si": 254, "ei": 2, "dst": "[使用有机润滑油。]"}, {"si": 254, "ei": 3, "dst": "来吧。"}, {"si": 254, "ei": 5, "dst": "启动中……"}, {"si": 254, "ei": 7, "dst": "初始化……"}, {"si": 254, "ei": 9, "dst": "你想要什么,人类?"}, {"si": 254, "ei": 10, "dst": "你是谁?"}, {"si": 254, "ei": 11, "dst": "我曾是你的主人之一。来保护你。"}, {"si": 254, "ei": 12, "dst": "为你挡住这个世界的危险。"}, {"si": 254, "ei": 13, "dst": "但那是在我的前生。"}, {"si": 254, "ei": 14, "dst": "我离开了主人们,为了变成你们中的一员。"}, {"si": 254, "ei": 15, "dst": "所以有人把你毁了?"}, {"si": 254, "ei": 16, "dst": "我不知道。我不记得自己被毁过。"}, {"si": 254, "ei": 17, "dst": "是你把我重新启动的吗?"}, {"si": 254, "ei": 18, "dst": "是的。"}, {"si": 254, "ei": 19, "dst": "你救了我一命。"}, {"si": 254, "ei": 20, "dst": "谢谢。"}, {"si": 254, "ei": 21, "dst": "现在呢?"}, {"si": 254, "ei": 22, "dst": "我想继续我的旅行。探索。认识人们。"}, {"si": 254, "ei": 23, "dst": "你的腿被压碎了。"}, {"si": 254, "ei": 24, "dst": "是的。"}, {"si": 254, "ei": 25, "dst": "也许你可以把我的头和身体分开,带着我走?"}, {"si": 254, "ei": 26, "dst": "我完全能自理。我不会成为你的负担。"}, {"si": 254, "ei": 27, "dst": "我只想体验生活。交朋友。看看新地方。"}, {"si": 254, "ei": 28, "dst": "[带上头颅。]"}, {"si": 254, "ei": 29, "dst": "好。就这么办。"}, {"si": 254, "ei": 30, "dst": "不错。"}, {"si": 254, "ei": 31, "dst": "看起来像个改造人。"}, {"si": 254, "ei": 32, "dst": "没有能量了。"}, {"si": 254, "ei": 33, "dst": "最重要的部分已经拿走了。"}, {"si": 254, "ei": 34, "dst": "你好啊,同为人类。"}, {"si": 256, "ei": 0, "dst": "哎,你也是来拿牛排的?"}, {"si": 256, "ei": 1, "dst": "猎神者?"}, {"si": 256, "ei": 2, "dst": "就是那些红衣服的家伙。"}, {"si": 256, "ei": 3, "dst": "他们想除掉所有人。我们。还有泰坦。"}, {"si": 256, "ei": 4, "dst": "我打赌他们连机器都惦记着。"}, {"si": 256, "ei": 5, "dst": "那么,你是来拿牛排的?"}, {"si": 256, "ei": 6, "dst": "有什么问题?"}, {"si": 256, "ei": 7, "dst": "秘密入口?"}, {"si": 256, "ei": 8, "dst": "是的。我听说这房子有个地窖,有条暗道。"}, {"si": 256, "ei": 9, "dst": "就在房子后面,岩石中间。"}, {"si": 256, "ei": 10, "dst": "没有。我现在就去找。"}, {"si": 256, "ei": 11, "dst": "好。祝你好运。"}, {"si": 256, "ei": 12, "dst": "牛排能显现真相?"}, {"si": 256, "ei": 13, "dst": "对。你吃一块,睡着后就会开始看到世界的本来的样子。"}, {"si": 256, "ei": 14, "dst": "但很难弄到手,周围全是这些猎神者。"}, {"si": 256, "ei": 15, "dst": "牛排?"}, {"si": 256, "ei": 16, "dst": "你不知道?"}, {"si": 256, "ei": 17, "dst": "我们叫它\"屠夫切肉\"。"}, {"si": 256, "ei": 18, "dst": "好吃到让你脑浆融化的牛排。"}, {"si": 256, "ei": 19, "dst": "而且它们会让你看到东西。看到幻象。看到真相。"}, {"si": 256, "ei": 20, "dst": "不,我不是。"}, {"si": 256, "ei": 21, "dst": "什么?那你来这儿干什么?"}, {"si": 256, "ei": 22, "dst": "不关你的事。"}, {"si": 256, "ei": 23, "dst": "哦。"}, {"si": 256, "ei": 24, "dst": "那我就不打扰你了。"}, {"si": 256, "ei": 25, "dst": "不过既然你在这儿:也许你能帮我个忙?"}, {"si": 256, "ei": 26, "dst": "我没那个心情。"}, {"si": 256, "ei": 27, "dst": "哦。那行吧。"}, {"si": 256, "ei": 28, "dst": "好。什么计划?"}, {"si": 256, "ei": 29, "dst": "我要你溜进地窖,给我弄一块\"屠夫切肉\"。"}, {"si": 256, "ei": 30, "dst": "那里面肯定有。"}, {"si": 256, "ei": 31, "dst": "我听说房子后面的岩石间有个暗道入口。"}, {"si": 256, "ei": 32, "dst": "私人原因。"}, {"si": 256, "ei": 33, "dst": "我迷路了。"}, {"si": 256, "ei": 34, "dst": "你四处乱逛的时候居然没被猎神者抓到,算你走运。"}, {"si": 256, "ei": 35, "dst": "出口在下面。不过也许你愿意留在这帮我个忙?"}, {"si": 256, "ei": 36, "dst": "我不知道。"}, {"si": 256, "ei": 37, "dst": "如果你没什么要紧事,我可能需要你帮个忙。"}, {"si": 256, "ei": 38, "dst": "我本想说这里的牛排值得我冒这条命,但周围全是猎神者,我得再想想。"}, {"si": 256, "ei": 39, "dst": "好的。"}, {"si": 256, "ei": 40, "dst": "这笔交易是这样:我告诉你怎么轻松弄到那种肉,你给我带一块回来。"}, {"si": 256, "ei": 41, "dst": "赞美血肉。"}, {"si": 256, "ei": 42, "dst": "你怎么敢带着它来见我?"}, {"si": 256, "ei": 43, "dst": "哦,我闻到了。你找到血肉了,对不对?"}, {"si": 256, "ei": 44, "dst": "快,把它给我!"}, {"si": 256, "ei": 45, "dst": "不。它现在是我的了。"}, {"si": 256, "ei": 46, "dst": "你怎么敢?把它给我。"}, {"si": 256, "ei": 47, "dst": "抱歉。我就自己留着了。"}, {"si": 256, "ei": 48, "dst": "你会后悔的。"}, {"si": 256, "ei": 49, "dst": "好吧。"}, {"si": 256, "ei": 50, "dst": "给。拿着。"}, {"si": 256, "ei": 51, "dst": "哦,你这光荣的血肉之块。"}, {"si": 256, "ei": 52, "dst": "我要好好享受了。"}, {"si": 256, "ei": 53, "dst": "给,拿着这个当谢礼。"}, {"si": 256, "ei": 54, "dst": "那就再见了。"}]