[{"si": 427, "ei": 29, "dst": "疼。疼。但我不想抱怨太多。太多。"}, {"si": 427, "ei": 30, "dst": "你的呢?你的?"}, {"si": 427, "ei": 31, "dst": "比疼还糟。还糟。真是他妈的。真的。"}, {"si": 427, "ei": 32, "dst": "就好像有人存心把这里变成我的地狱。地狱。往我头上淋屎……淋……"}, {"si": 427, "ei": 33, "dst": "啊,算了,我也不想抱怨。不想。"}, {"si": 427, "ei": 34, "dst": "欢迎!欢迎!"}, {"si": 429, "ei": 0, "dst": "提示:等待用户指令。"}, {"si": 431, "ei": 0, "dst": "还有别的吗?"}, {"si": 431, "ei": 1, "dst": "你还想要?"}, {"si": 431, "ei": 2, "dst": "你还需要?"}, {"si": 433, "ei": 0, "dst": "唔。这团血肉堵着某个入口。"}, {"si": 433, "ei": 1, "dst": "[尝试与血肉交流。]"}, {"si": 433, "ei": 2, "dst": "血肉无视了你。"}, {"si": 433, "ei": 3, "dst": "血肉对你的存在做出了反应。"}, {"si": 433, "ei": 4, "dst": "它在等待指令。"}, {"si": 433, "ei": 5, "dst": "放我进去。"}, {"si": 433, "ei": 6, "dst": "那我们就看看吧。"}, {"si": 433, "ei": 7, "dst": "里面有人吗?"}, {"si": 433, "ei": 8, "dst": "没有回答。"}, {"si": 435, "ei": 0, "dst": "某种线条和符号。"}, {"si": 435, "ei": 1, "dst": "不过我看不太懂。"}, {"si": 435, "ei": 2, "dst": "我也许该学学怎么读这些。"}, {"si": 435, "ei": 3, "dst": "外面肯定有懂图纸和工具的人。"}, {"si": 435, "ei": 4, "dst": "如果我没记错,陶里斯的商人提过一个往西边去的人。"}, {"si": 435, "ei": 5, "dst": "也许我找到的那本书能帮上忙。"}, {"si": 435, "ei": 6, "dst": "也许我可以把这些材料挪作他用。"}, {"si": 435, "ei": 7, "dst": "要学会不破坏材料就把这东西拆开,会很有用。"}, {"si": 437, "ei": 0, "dst": "我还得再琢磨琢磨。别管我,只是在盯着永恒看,哈哈。"}, {"si": 437, "ei": 1, "dst": "这是不是非常有意思?"}, {"si": 437, "ei": 2, "dst": "什么有意思?"}, {"si": 437, "ei": 3, "dst": "我不知道我们在哪。我跌跌撞撞穿过这个世界,然后发现了这个地方。就在这里。"}, {"si": 437, "ei": 4, "dst": "我在想:这里就是全部吗?这就是我们凝视的尽头吗?还是永恒?这里是无穷的吗?"}, {"si": 437, "ei": 5, "dst": "我知道我们活在一个破碎的世界里,有那么多角落和缝隙。但这里,这个角落,这个地方,是世界的尽头,还是我们正处在万物的中央?"}, {"si": 437, "ei": 6, "dst": "我他妈才不在乎。"}, {"si": 437, "ei": 7, "dst": "真无礼。"}, {"si": 437, "ei": 8, "dst": "我不知道。"}, {"si": 437, "ei": 9, "dst": "嗯。我也不确定。"}, {"si": 437, "ei": 10, "dst": "唔。谢谢你的见解。"}, {"si": 437, "ei": 11, "dst": "这不是尽头。"}, {"si": 437, "ei": 12, "dst": "为什么?"}, {"si": 437, "ei": 13, "dst": "我们在旅途之中。而旅程尚未结束。"}, {"si": 437, "ei": 14, "dst": "前面还会有更多。更多的角落。"}, {"si": 437, "ei": 15, "dst": "所以,我们不在尽头。"}, {"si": 437, "ei": 16, "dst": "感觉像个尽头。"}, {"si": 437, "ei": 17, "dst": "你这么觉得?"}, {"si": 437, "ei": 18, "dst": "是的。这里走不了多远了。我们在世界的一端。"}, {"si": 437, "ei": 19, "dst": "最远的角落之一。"}, {"si": 439, "ei": 0, "dst": "等等!"}, {"si": 439, "ei": 1, "dst": "朋友。"}, {"si": 441, "ei": 0, "dst": "看起来我可以下到这来——如果我也有什么能帮我再爬上去的话。"}, {"si": 441, "ei": 1, "dst": "[使用绳索。]"}, {"si": 441, "ei": 2, "dst": "不错。"}, {"si": 443, "ei": 0, "dst": "阅读和搜寻。"}, {"si": 443, "ei": 1, "dst": "你能给我看一条先知的规则吗?"}, {"si": 443, "ei": 2, "dst": "不读。"}, {"si": 443, "ei": 3, "dst": "血肉?"}, {"si": 443, "ei": 4, "dst": "读!"}, {"si": 443, "ei": 5, "dst": "谢谢。"}, {"si": 443, "ei": 6, "dst": "你在读什么?"}, {"si": 443, "ei": 7, "dst": "先知的卷轴。真理。"}, {"si": 443, "ei": 8, "dst": "智慧。血肉。非血肉。全非血肉。"}, {"si": 443, "ei": 9, "dst": "但又是血肉。"}, {"si": 443, "ei": 10, "dst": "而又非血肉。"}, {"si": 443, "ei": 11, "dst": "好。信息量很大。血肉与非血肉。"}, {"si": 443, "ei": 12, "dst": "为什么是血肉和非血肉?"}, {"si": 443, "ei": 13, "dst": "说实话?我不知道。"}, {"si": 443, "ei": 14, "dst": "困住了。"}, {"si": 443, "ei": 15, "dst": "命运。"}, {"si": 445, "ei": 0, "dst": "在这儿放轻脚步,陌生人。你要是敢跟我过不去,我就杀了你。"}, {"si": 445, "ei": 1, "dst": "其实我才是这里最强的。"}, {"si": 445, "ei": 2, "dst": "哈哈哈。你不是来真的吧!想要个证明的机会吗?"}, {"si": 445, "ei": 3, "dst": "唔。还是不了。"}, {"si": 445, "ei": 4, "dst": "哈!我就知道你会退缩。"}, {"si": 445, "ei": 5, "dst": "那么,还有什么事?"}, {"si": 445, "ei": 6, "dst": "来。"}, {"si": 445, "ei": 7, "dst": "哦哦,这将是一场酣战!"}, {"si": 445, "ei": 8, "dst": "打到死为止!"}, {"si": 445, "ei": 9, "dst": "我不想跟你打。"}, {"si": 445, "ei": 10, "dst": "那就别打。离开这地方。"}, {"si": 445, "ei": 11, "dst": "那边那个变异人……"}, {"si": 445, "ei": 12, "dst": "他怎么了?他很弱。"}, {"si": 445, "ei": 13, "dst": "没什么。"}, {"si": 445, "ei": 14, "dst": "他也这么说你来着。"}, {"si": 445, "ei": 15, "dst": "什么?!那个浮夸的血肉书记员?我能轻松把他踩进地里。"}, {"si": 445, "ei": 16, "dst": "我不知道。他看着挺壮的。"}, {"si": 445, "ei": 17, "dst": "呸!我会让你看看谁才是最强的。"}, {"si": 445, "ei": 18, "dst": "你准备好为你的地盘而战了吗?"}, {"si": 445, "ei": 19, "dst": "是的。这地方。我不知道这是什么地方,但它是个地方。我可以为它而战。"}, {"si": 445, "ei": 20, "dst": "战斗是好事。让我保持强壮。"}, {"si": 445, "ei": 21, "dst": "嘿!你!"}, {"si": 445, "ei": 22, "dst": "这是强者的生存法则。你是来挑战我的吗?"}, {"si": 445, "ei": 23, "dst": "你最好现在就走,免得脑袋开花。我已经准备好为我的地盘而战了。"}, {"si": 447, "ei": 0, "dst": "啊。"}, {"si": 447, "ei": 1, "dst": "哎哟!"}, {"si": 447, "ei": 2, "dst": "哦哦。"}, {"si": 447, "ei": 3, "dst": "哎哟!"}, {"si": 449, "ei": 0, "dst": "你的万物子宫之旅结束了。你死了。||||游戏时长:"}, {"si": 451, "ei": 0, "dst": "Nexus 吞噬了你的身体与灵魂。||||游戏时长:"}, {"si": 453, "ei": 0, "dst": "站住,你这个邪恶的猎神者!"}, {"si": 455, "ei": 0, "dst": "我不会让你拿到泰坦之肠的!"}, {"si": 455, "ei": 1, "dst": "我是来取肠子的。"}, {"si": 455, "ei": 2, "dst": "休想!"}, {"si": 455, "ei": 3, "dst": "我不是猎神者。"}, {"si": 455, "ei": 4, "dst": "我只想要一枚印记。"}, {"si": 455, "ei": 5, "dst": "想得美,我可不会上当。"}, {"si": 455, "ei": 6, "dst": "我的口粮还够吃几个月呢。"}, {"si": 455, "ei": 8, "dst": "噁。那玩意简直不能算食物。"}, {"si": 457, "ei": 0, "dst": "正在启动数据终端……"}, {"si": 457, "ei": 1, "dst": "有一条可用录像。"}, {"si": 457, "ei": 2, "dst": "命令?"}, {"si": 457, "ei": 3, "dst": "给我那条录像的详情。"}, {"si": 457, "ei": 4, "dst": "有一条栖居者死亡的录像可用。"}, {"si": 457, "ei": 5, "dst": "提取到数据容器?"}, {"si": 457, "ei": 6, "dst": "不。"}, {"si": 457, "ei": 7, "dst": "是。"}, {"si": 457, "ei": 8, "dst": "数据容器处理完毕。"}, {"si": 457, "ei": 9, "dst": "谢谢。"}, {"si": 457, "ei": 10, "dst": "错误。录像已被处理过。没有更多数据记录器可用。"}, {"si": 459, "ei": 0, "dst": "嘿,你需要的是什么来着?"}, {"si": 459, "ei": 1, "dst": "嘿,你要我做什么来着?"}, {"si": 459, "ei": 2, "dst": "你要我做的事是什么?"}, {"si": 461, "ei": 0, "dst": "需要我的服务吗?"}, {"si": 461, "ei": 1, "dst": "你能教我点什么吗?"}, {"si": 461, "ei": 2, "dst": "嗯。修东西和拆东西,我还懂一两手。"}, {"si": 461, "ei": 3, "dst": "其实有过一本基础入门指南。但卖给一个往西走的人了。"}, {"si": 461, "ei": 4, "dst": "还有别的事吗?"}, {"si": 461, "ei": 5, "dst": "是这本吗?"}, {"si": 461, "ei": 6, "dst": "哦。是的。……那个人怎么了?"}, {"si": 461, "ei": 7, "dst": "发现他的时候已经死了。"}, {"si": 461, "ei": 8, "dst": "啊,好。那现在归你了。你应该读读它。"}, {"si": 461, "ei": 9, "dst": "让我看看你的服务。"}, {"si": 461, "ei": 10, "dst": "好吧。我可以给你换一张脸。或者重塑你的脑波模式。"}, {"si": 461, "ei": 11, "dst": "你卖什么特殊装备吗?"}, {"si": 461, "ei": 12, "dst": "嗯,我卖一些植入体和小零件。"}, {"si": 461, "ei": 13, "dst": "你可以在我的店里看看。"}, {"si": 461, "ei": 14, "dst": "啊哈……"}, {"si": 461, "ei": 15, "dst": "我在找更……有冲击力的东西。"}, {"si": 461, "ei": 16, "dst": "有冲击力?那你也许该看看旁边那台机器。"}, {"si": 461, "ei": 17, "dst": "谢了,大概吧?"}, {"si": 461, "ei": 18, "dst": "拜托……就这些?"}, {"si": 461, "ei": 19, "dst": "别再烦我了。传单我已经给过你了。"}, {"si": 461, "ei": 20, "dst": "好啦陌生人,如果你真在找火热的好货,看看这个。"}, {"si": 461, "ei": 21, "dst": "唔,广告……"}, {"si": 461, "ei": 22, "dst": "你旁边这台机器是什么?"}, {"si": 461, "ei": 23, "dst": "是台机器商人。好东西,对吧?收藏者装的。"}, {"si": 461, "ei": 24, "dst": "好吧。"}, {"si": 461, "ei": 25, "dst": "要是有人攻击它呢?"}, {"si": 461, "ei": 26, "dst": "有人试过。但这机器好像毁不掉。"}, {"si": 461, "ei": 27, "dst": "我打赌它还会记录所有试图攻击的行为。"}, {"si": 461, "ei": 28, "dst": "别耍花样。我可不想惹恼收藏者,哈哈。"}, {"si": 461, "ei": 29, "dst": "收藏者?"}, {"si": 461, "ei": 30, "dst": "一群商人。找稀有废料,但其实什么货都感兴趣。"}, {"si": 461, "ei": 31, "dst": "没听说过他们?你从哪来的?"}, {"si": 461, "ei": 32, "dst": "这真的很重要吗?"}, {"si": 461, "ei": 33, "dst": "不重要。我只是好奇。"}, {"si": 461, "ei": 34, "dst": "总之……还有别的想要的吗?"}, {"si": 461, "ei": 35, "dst": "被社会驱逐了。"}, {"si": 461, "ei": 36, "dst": "嗯。我们不都是吗?不过有些人在这里待了很久了。"}, {"si": 461, "ei": 37, "dst": "多久?"}, {"si": 461, "ei": 38, "dst": "几十年。这地方本身存在得还要久得多。"}, {"si": 461, "ei": 39, "dst": "[指向西边。]"}, {"si": 461, "ei": 40, "dst": "哈。好久没人从那边来了。"}, {"si": 463, "ei": 0, "dst": "*隆隆*"}, {"si": 463, "ei": 1, "dst": "泰坦在打量你。"}, {"si": 463, "ei": 2, "dst": "但你没有听到任何话语。"}, {"si": 463, "ei": 3, "dst": "欢迎回来,孩子。"}, {"si": 463, "ei": 4, "dst": "嗯,我最好继续我的旅行了。"}, {"si": 463, "ei": 5, "dst": "交合三重夫人?"}, {"si": 463, "ei": 6, "dst": "那头衔其实很容易得来。正好发挥了我的个人长处。"}, {"si": 463, "ei": 7, "dst": "那你怎么……"}, {"si": 463, "ei": 8, "dst": "啊,\"臣民\",这把戏一眼就能识破。"}, {"si": 463, "ei": 9, "dst": "你想跟我谈交合让我神魂颠倒,好钻进我的被窝,然后一辈子吹嘘自己上了伟大的玛尔加斯女王。"}, {"si": 463, "ei": 10, "dst": "这可不行。不能路过一个就上一个。"}, {"si": 463, "ei": 11, "dst": "至少今天不行。"}, {"si": 463, "ei": 12, "dst": "你们有国王吗?"}, {"si": 463, "ei": 13, "dst": "哦,有过很多。但他们都被皇家的欲望碾碎了。"}, {"si": 463, "ei": 14, "dst": "碾碎?被你的欲望?"}, {"si": 463, "ei": 15, "dst": "孩子,谈论皇家的体重可不合适。"}, {"si": 463, "ei": 16, "dst": "啊啊,又一个渴望女王垂青的凡人。"}, {"si": 463, "ei": 17, "dst": "但我今天有点不适。"}, {"si": 463, "ei": 18, "dst": "也许臣民可以改日再来。"}, {"si": 463, "ei": 19, "dst": "改日可不行。"}, {"si": 463, "ei": 20, "dst": "什么?它居然会回话?"}, {"si": 463, "ei": 21, "dst": "好吧,我素来慷慨。而且这说不定还能给我们添点乐子。"}, {"si": 463, "ei": 22, "dst": "咳咳。欢迎,臣民。它叫什么名字,想要什么?"}, {"si": 463, "ei": 23, "dst": "**forename**。我只是好奇你是谁。"}, {"si": 463, "ei": 24, "dst": "**forename**。嗯,不能指望一个凡人有更讲究的名字了,对吧?"}, {"si": 463, "ei": 25, "dst": "我是觉醒女王玛尔加斯,冥界守卫,谢布祖守护者,交合三重夫人。"}, {"si": 465, "ei": 0, "dst": "好像有人拿这个当壁炉用。"}, {"si": 465, "ei": 1, "dst": "我可以在这里烤点肉。"}, {"si": 465, "ei": 2, "dst": "如果我有肉的话。"}, {"si": 465, "ei": 3, "dst": "[烤肉。]"}, {"si": 465, "ei": 4, "dst": "那香味……"}, {"si": 465, "ei": 5, "dst": "你在烤肉吗?"}, {"si": 465, "ei": 6, "dst": "哦,哇。一定是泰坦派你来的。他们听到了我的祈祷。"}, {"si": 465, "ei": 7, "dst": "我来了。"}, {"si": 465, "ei": 8, "dst": "把那块肉给我!"}, {"si": 465, "ei": 10, "dst": "泰坦在上,这真是太棒了。"}, {"si": 465, "ei": 11, "dst": "就凭这个我都想给你一枚印记。"}, {"si": 465, "ei": 12, "dst": "但我现在身上一枚也没有。"}, {"si": 465, "ei": 13, "dst": "肯定是猎神者偷走了我的存货。"}, {"si": 465, "ei": 14, "dst": "你可以从泰坦之心北边山脚的祭司那里再拿一枚印记。"}, {"si": 465, "ei": 15, "dst": "请收下这个。你应得的,哈哈。"}, {"si": 465, "ei": 16, "dst": "那香味……"}, {"si": 465, "ei": 17, "dst": "你在烤肉吗?"}, {"si": 465, "ei": 18, "dst": "哦,哇。一定是泰坦派你来的。他们听到了我的祈祷。"}, {"si": 465, "ei": 19, "dst": "我来了。"}, {"si": 467, "ei": 0, "dst": "这是圣地。"}, {"si": 467, "ei": 1, "dst": "供奉血肉泰坦之肠的神龛。"}, {"si": 467, "ei": 2, "dst": "如果你想成为泰坦的朝圣者,请去新德尔斐找大祭司。"}, {"si": 467, "ei": 3, "dst": "看来泰坦确实保佑了你。"}, {"si": 467, "ei": 4, "dst": "小心。"}, {"si": 467, "ei": 5, "dst": "猎神者最近老是鬼鬼祟祟地出没。"}, {"si": 467, "ei": 6, "dst": "猎神者?"}, {"si": 467, "ei": 7, "dst": "背弃信仰的人,决意要征服我们的神。"}, {"si": 467, "ei": 8, "dst": "他们试图杀害泰坦。"}, {"si": 467, "ei": 9, "dst": "你能想象吗?"}, {"si": 467, "ei": 10, "dst": "关于印记的事。"}, {"si": 467, "ei": 11, "dst": "你可以从泰坦之心北边山脚的祭司那里再拿一枚印记。"}, {"si": 467, "ei": 12, "dst": "我能感觉到你身上散发出的灵性力量。"}, {"si": 467, "ei": 13, "dst": "如果你集齐了,就该去新德尔斐找大祭司谈谈。"}, {"si": 467, "ei": 14, "dst": "那香味是从哪来的?"}, {"si": 467, "ei": 15, "dst": "我不想再吃这种口粮了。"}, {"si": 467, "ei": 16, "dst": "你在干什么?"}, {"si": 467, "ei": 17, "dst": "这下猎神者就能直接进来了。"}, {"si": 469, "ei": 0, "dst": "这是圣地。"}, {"si": 469, "ei": 1, "dst": "供奉泰坦之颅的神龛。"}, {"si": 469, "ei": 2, "dst": "如果你想成为泰坦的朝圣者,请去新德尔斐找大祭司。"}, {"si": 469, "ei": 3, "dst": "回答我这个问题:"}, {"si": 469, "ei": 4, "dst": "谁是你的主人?"}, {"si": 469, "ei": 5, "dst": "每一位泰坦……"}, {"si": 469, "ei": 6, "dst": "……只要它让自己浴血……"}, {"si": 469, "ei": 7, "dst": "……并且热爱把玩玩具。"}, {"si": 469, "ei": 8, "dst": "至少我是这么说的。"}, {"si": 469, "ei": 9, "dst": "这不对。"}, {"si": 469, "ei": 10, "dst": "不可思议。"}, {"si": 469, "ei": 11, "dst": "你向我证明了你信仰泰坦的深度。"}, {"si": 469, "ei": 12, "dst": "收下这枚印记,作为我认可的信物,然后往东去泰坦之肠。"}, {"si": 469, "ei": 13, "dst": "愿泰坦保佑你。"}, {"si": 469, "ei": 14, "dst": "不过其他神明也可以接受。"}, {"si": 469, "ei": 15, "dst": "受祝福了。"}, {"si": 469, "ei": 16, "dst": "我只以它的名义杀戮。"}, {"si": 469, "ei": 17, "dst": "……并以其存在本身赐予无穷智慧。"}, {"si": 469, "ei": 18, "dst": "……还会在我饿的时候喂我血肉蠕虫。"}, {"si": 469, "ei": 19, "dst": "……还会替我杀掉敌人。"}, {"si": 469, "ei": 20, "dst": "……那个住在树里的……"}, {"si": 469, "ei": 21, "dst": "……那个栖息在星球上的……"}, {"si": 469, "ei": 22, "dst": "……那个在晴天懒洋洋晒太阳的……"}, {"si": 469, "ei": 23, "dst": "寰宇社会……"}, {"si": 469, "ei": 24, "dst": "机器……"}, {"si": 469, "ei": 25, "dst": "没有人……"}, {"si": 469, "ei": 26, "dst": "大祭司派我来的。"}, {"si": 469, "ei": 27, "dst": "你要给我一枚印记?"}, {"si": 469, "ei": 28, "dst": "一位追寻真正虔诚的朝圣者。"}, {"si": 469, "ei": 29, "dst": "是的,我确实有一枚印记给你。"}, {"si": 469, "ei": 30, "dst": "但你需要挣到它。"}, {"si": 469, "ei": 31, "dst": "我通常把印记发给在这里证明了对泰坦虔诚的朝圣者。"}, {"si": 469, "ei": 32, "dst": "但看来我的印记用完了。"}, {"si": 469, "ei": 33, "dst": "恕我直言,我现在帮不了你。"}, {"si": 469, "ei": 34, "dst": "你可以去试试东边泰坦之肠的祭司,运气也许会好些。"}, {"si": 469, "ei": 35, "dst": "祝你的朝圣一切顺利。"}, {"si": 469, "ei": 36, "dst": "东边泰坦之肠的祭司会有进一步的信息给你。"}, {"si": 469, "ei": 37, "dst": "看来泰坦确实保佑了你。"}]