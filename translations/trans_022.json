[{"si": 701, "ei": 13, "dst": "若你想超越血肉的极限。"}, {"si": 701, "ei": 14, "dst": "便到塔顶来见我。"}, {"si": 701, "ei": 15, "dst": "一切自会适时解答。"}, {"si": 701, "ei": 16, "dst": "什么?"}, {"si": 703, "ei": 0, "dst": "你抵达了我这里。"}, {"si": 703, "ei": 1, "dst": "这把枪是怎么回事?"}, {"si": 703, "ei": 2, "dst": "我把这件武器给你,是为了帮助你。"}, {"si": 703, "ei": 3, "dst": "别告诉我你不想要它?"}, {"si": 703, "ei": 4, "dst": "哦不,它很好。"}, {"si": 703, "ei": 5, "dst": "我只是好奇。"}, {"si": 703, "ei": 6, "dst": "那就好。"}, {"si": 703, "ei": 7, "dst": "我有点担心你不喜欢它,毕竟我是强迫你收下的。"}, {"si": 703, "ei": 8, "dst": "我不喜欢。"}, {"si": 703, "ei": 9, "dst": "那我便收回它。"}, {"si": 703, "ei": 10, "dst": "这让我非常失望。"}, {"si": 703, "ei": 11, "dst": "我想变得更强。"}, {"si": 703, "ei": 12, "dst": "当然。"}, {"si": 703, "ei": 13, "dst": "嗯,好多了。"}, {"si": 703, "ei": 14, "dst": "你能更新我体内的机器吗?"}, {"si": 703, "ei": 15, "dst": "塔外那个人少了一位朋友。"}, {"si": 703, "ei": 16, "dst": "不必担忧。"}, {"si": 703, "ei": 17, "dst": "因为她还活着。"}, {"si": 703, "ei": 18, "dst": "她和她的朋友都通过了我的考验。"}, {"si": 703, "ei": 19, "dst": "但她们中只有一人愿意成为更好的人类。"}, {"si": 703, "ei": 20, "dst": "而我派另一个出去召集更多人。"}, {"si": 703, "ei": 21, "dst": "原来你之前问的就是她。"}, {"si": 703, "ei": 22, "dst": "那个女人现在在哪儿?"}, {"si": 703, "ei": 23, "dst": "在楼上的房间里,和我其他被改良的孩子们在一起。"}, {"si": 703, "ei": 24, "dst": "你能放她走吗?"}, {"si": 703, "ei": 25, "dst": "好让你像屠戮我其他孩子那样宰了她?"}, {"si": 703, "ei": 26, "dst": "不,我不会允许。"}, {"si": 703, "ei": 27, "dst": "我的孩子没有一个得到过你的帮助。"}, {"si": 703, "ei": 28, "dst": "你也未曾向我宣誓效忠,或以任何形式帮助过我。"}, {"si": 703, "ei": 29, "dst": "我不明白我为何要满足你这个愿望。"}, {"si": 703, "ei": 30, "dst": "既然你已成为我的孩子,我便满足你这个愿望。"}, {"si": 703, "ei": 31, "dst": "她会在塔外等你。"}, {"si": 703, "ei": 32, "dst": "你确实减轻了我一个失误的痛苦。"}, {"si": 703, "ei": 33, "dst": "我便满足你这个愿望,作为对我失误的忏悔,也是对你善行的奖赏。"}, {"si": 703, "ei": 34, "dst": "我能去那儿吗?"}, {"si": 703, "ei": 35, "dst": "你不可以!"}, {"si": 703, "ei": 36, "dst": "那是唯有极少数人才能进入的地方。"}, {"si": 703, "ei": 37, "dst": "尽管你已成为我的孩子之一,那地方也不是你能踏足的。"}, {"si": 703, "ei": 38, "dst": "那么,她现在在哪儿?"}, {"si": 703, "ei": 39, "dst": "所以你在这里召集人?"}, {"si": 703, "ei": 40, "dst": "是的,我召集强者。"}, {"si": 703, "ei": 41, "dst": "他们将加入我的力量。"}, {"si": 703, "ei": 42, "dst": "他们也将得到改良。"}, {"si": 703, "ei": 43, "dst": "那些从这里逃走的东西呢?"}, {"si": 703, "ei": 44, "dst": "并非每个人都能很好地承受我的强化。"}, {"si": 703, "ei": 45, "dst": "他们是我耻辱过去的一部分。"}, {"si": 703, "ei": 46, "dst": "但他们仍是我珍爱的孩子。"}, {"si": 703, "ei": 47, "dst": "那些失败的改造人呢?"}, {"si": 703, "ei": 48, "dst": "也是你造的吗?"}, {"si": 703, "ei": 49, "dst": "承认这一点令人羞愧。"}, {"si": 703, "ei": 50, "dst": "但没错,他们是我最初尝试的结果。"}, {"si": 703, "ei": 51, "dst": "我尝试了许多次,才将此地的机器与强壮人类的身体结合。"}, {"si": 703, "ei": 52, "dst": "不过一路上的所有失误,也正展现了我的进步。"}, {"si": 703, "ei": 53, "dst": "我和珍爱其他孩子一样珍爱他们。"}, {"si": 703, "ei": 54, "dst": "那些说话怪里怪气的人也是被\"改良\"的吗?"}, {"si": 703, "ei": 55, "dst": "不完全是。"}, {"si": 703, "ei": 56, "dst": "起初,并非所有人都自愿来投奔我。"}, {"si": 703, "ei": 57, "dst": "而我需要追随者为我效力。"}, {"si": 703, "ei": 58, "dst": "于是我推了他们一把。"}, {"si": 703, "ei": 59, "dst": "他们的脑子因此有点乱了。"}, {"si": 703, "ei": 60, "dst": "但别担心。除此之外他们都好好的。"}, {"si": 703, "ei": 61, "dst": "你是说那些改造人?"}, {"si": 703, "ei": 62, "dst": "是的。他们是我的杰作。"}, {"si": 703, "ei": 63, "dst": "不过你似乎对他们有些意见。"}, {"si": 703, "ei": 64, "dst": "别担心,我能把你造得比他们更好。"}, {"si": 703, "ei": 65, "dst": "让我强化你,超越你的人类极限。"}, {"si": 703, "ei": 66, "dst": "接纳一些机器。让你变得更好。"}, {"si": 703, "ei": 67, "dst": "让你自己变得更像我。"}, {"si": 703, "ei": 68, "dst": "[拒绝。]"}, {"si": 703, "ei": 69, "dst": "真是遗憾。"}, {"si": 703, "ei": 70, "dst": "如果你改变主意,随时再来问我。"}, {"si": 703, "ei": 71, "dst": "你已经证明了自己。"}, {"si": 703, "ei": 72, "dst": "[接受。]"}, {"si": 703, "ei": 73, "dst": "看看你。"}, {"si": 703, "ei": 74, "dst": "你已近乎完美,我的孩子。"}, {"si": 703, "ei": 75, "dst": "不过,似乎还有个问题。"}, {"si": 703, "ei": 76, "dst": "你的身体没有完全接纳我。"}, {"si": 703, "ei": 77, "dst": "假以时日,它会恢复成原来的样子。大体上。"}, {"si": 703, "ei": 78, "dst": "到那时,再来找我一次。"}, {"si": 703, "ei": 79, "dst": "在那之前,你将是我的武器。"}, {"si": 703, "ei": 80, "dst": "用上这个,助我们达成宏愿。"}, {"si": 703, "ei": 81, "dst": "我把它造得永远不会离开你。"}, {"si": 703, "ei": 82, "dst": "即使你体内机器的影响消退。"}, {"si": 703, "ei": 83, "dst": "你见过他们了,不是吗?"}, {"si": 703, "ei": 84, "dst": "他们难道不精彩吗?"}, {"si": 703, "ei": 85, "dst": "你难道不想加入他们?"}, {"si": 703, "ei": 86, "dst": "就像你对我做的那样?"}, {"si": 703, "ei": 87, "dst": "是的。我让你更接近机器。"}, {"si": 703, "ei": 88, "dst": "用他们的武器让你更强。"}, {"si": 703, "ei": 89, "dst": "并削弱了你的一部分人性弱点。"}, {"si": 703, "ei": 90, "dst": "我对大多数征服此塔的人都这么做。"}, {"si": 703, "ei": 91, "dst": "这里在发生什么?"}, {"si": 703, "ei": 92, "dst": "你已通过考验,那我便告诉你。"}, {"si": 703, "ei": 93, "dst": "这里是我集结军队对抗机器之神的地方。"}, {"si": 703, "ei": 94, "dst": "我夺下了他的工厂,正在生产我自己的。"}, {"si": 703, "ei": 95, "dst": "但这还不够。"}, {"si": 703, "ei": 96, "dst": "光靠机器,我无法与机器作战。"}, {"si": 703, "ei": 97, "dst": "所以我召集强者。"}, {"si": 703, "ei": 98, "dst": "你回来了,我的孩子。"}, {"si": 703, "ei": 99, "dst": "你想变得强壮吗?"}, {"si": 705, "ei": 0, "dst": "嘿,你和那个泰坦谈过了吗?"}, {"si": 707, "ei": 0, "dst": "这以前大概是一张床。"}, {"si": 709, "ei": 0, "dst": "对,这不是我的。"}, {"si": 711, "ei": 0, "dst": "我已经用过了。"}, {"si": 711, "ei": 1, "dst": "它已经开了。"}, {"si": 713, "ei": 0, "dst": "\"请补充有机润滑剂。\""}, {"si": 713, "ei": 1, "dst": "这是什么意思?"}, {"si": 713, "ei": 2, "dst": "来了。"}, {"si": 713, "ei": 3, "dst": "哦嘿,成了。"}, {"si": 713, "ei": 4, "dst": "这台机器看起来和门连着。"}, {"si": 713, "ei": 5, "dst": "\"请补充有机润滑剂。\""}, {"si": 713, "ei": 6, "dst": "我上哪儿去找有机润滑剂?"}, {"si": 713, "ei": 7, "dst": "这个嘛……"}, {"si": 713, "ei": 8, "dst": "我不再需要这台机器的任何东西了。"}, {"si": 713, "ei": 9, "dst": "我也不想再往里面填我自己的东西了。"}, {"si": 715, "ei": 0, "dst": "看起来像个怪物。"}, {"si": 715, "ei": 1, "dst": "看起来像血肉海妖。"}, {"si": 717, "ei": 0, "dst": "不知道这是什么。"}, {"si": 717, "ei": 1, "dst": "显然它还在运作。"}, {"si": 717, "ei": 2, "dst": "这很久以前一定很值钱。"}, {"si": 717, "ei": 3, "dst": "这是些老古董科技。"}, {"si": 719, "ei": 0, "dst": "这是什么地方?"}, {"si": 721, "ei": 0, "dst": "这里有些坏掉的工具。不过没什么有用的。"}, {"si": 723, "ei": 0, "dst": "这里没什么有用的东西。"}, {"si": 723, "ei": 1, "dst": "那堆东西里没一样能用。"}, {"si": 723, "ei": 2, "dst": "看起来还能用,但我不知道它是干什么用的。"}, {"si": 723, "ei": 3, "dst": "我不知道那是什么。"}, {"si": 723, "ei": 4, "dst": "不确定这是什么。但没有我能用的。"}, {"si": 723, "ei": 5, "dst": "这里什么都没有。"}, {"si": 723, "ei": 6, "dst": "这里没有用的东西。"}, {"si": 725, "ei": 0, "dst": "老天,真好喝。"}, {"si": 725, "ei": 1, "dst": "*咕咚*"}, {"si": 725, "ei": 2, "dst": "操,爽。"}, {"si": 727, "ei": 0, "dst": "这双靴子属于卡琳·泰勒,水晶之城的创始守护者之一。"}, {"si": 729, "ei": 0, "dst": "某个人的脑,他靠想象自己已死而意外自杀了。"}, {"si": 729, "ei": 1, "dst": "他思维链的记录被保存了下来,但后来被抹除。"}, {"si": 731, "ei": 0, "dst": "这些衣服是在街上发现的,四周围着一圈沉默而震惊的人群。"}, {"si": 731, "ei": 1, "dst": "目击者谈及一次人性枷锁的深刻脱落——一位老人再次解放了自己,挣脱了布料的束缚。"}, {"si": 733, "ei": 0, "dst": "血肉披挂在金属上,我猜。"}, {"si": 735, "ei": 0, "dst": "某件未定义的雕塑。"}, {"si": 737, "ei": 0, "dst": "嘿。把武器收起来。"}, {"si": 737, "ei": 1, "dst": "我们希望里面保持太平。"}, {"si": 737, "ei": 2, "dst": "你要太平,来的却是战争。[开始战斗。]"}, {"si": 737, "ei": 3, "dst": "我的武器想带到哪儿就带到哪儿。"}, {"si": 737, "ei": 4, "dst": "行。那你就待在外面。"}, {"si": 737, "ei": 5, "dst": "里面的人神经绷得很紧。他们要是看见你手里有武器,会开枪的。"}, {"si": 737, "ei": 6, "dst": "好吧。"}, {"si": 737, "ei": 7, "dst": "很好。在里面别拔武器。大家都很紧张。"}, {"si": 737, "ei": 8, "dst": "他妈的离我远点。"}, {"si": 739, "ei": 0, "dst": "走开。"}, {"si": 739, "ei": 1, "dst": "求你,别管我。"}, {"si": 739, "ei": 2, "dst": "别犯傻。"}, {"si": 739, "ei": 3, "dst": "他妈的离我远点。"}, {"si": 739, "ei": 4, "dst": "嘿,别干蠢事。"}, {"si": 741, "ei": 0, "dst": "嘿。把那武器收起来,不然你会没命的。"}, {"si": 741, "ei": 1, "dst": "嘿。把武器收起来,不然你会后悔的。"}, {"si": 743, "ei": 0, "dst": "嘿!我盯着你呢。"}, {"si": 743, "ei": 1, "dst": "嘿!别碰那个。"}, {"si": 743, "ei": 2, "dst": "别碰那个!"}, {"si": 745, "ei": 0, "dst": "别烦我。"}, {"si": 745, "ei": 1, "dst": "操。"}, {"si": 745, "ei": 2, "dst": "走开。"}, {"si": 745, "ei": 3, "dst": "哦天。"}, {"si": 747, "ei": 0, "dst": "嘿,想看看我的货吗?"}, {"si": 749, "ei": 0, "dst": "泰坦是我们的主人。"}, {"si": 749, "ei": 1, "dst": "他们走到哪里,血肉便生长到哪里。"}, {"si": 749, "ei": 2, "dst": "血肉生长之处,生命便绽放。"}, {"si": 749, "ei": 3, "dst": "所以我们追随他们。"}, {"si": 749, "ei": 4, "dst": "你相信泰坦吗?"}, {"si": 749, "ei": 5, "dst": "你说的\"相信\"是什么意思?"}, {"si": 749, "ei": 6, "dst": "他们确实存在。"}, {"si": 749, "ei": 7, "dst": "你误解了。"}, {"si": 749, "ei": 8, "dst": "泰坦是我们的领袖"}, {"si": 749, "ei": 9, "dst": "他们会带给我们太平。"}, {"si": 749, "ei": 10, "dst": "如果你想了解更多,应该去新德尔斐。"}, {"si": 749, "ei": 11, "dst": "不。"}, {"si": 749, "ei": 12, "dst": "也许你才应该去。"}, {"si": 749, "ei": 13, "dst": "是。"}, {"si": 749, "ei": 14, "dst": "那很好。"}, {"si": 749, "ei": 15, "dst": "听说我们的一件圣物最近被偷了。"}, {"si": 749, "ei": 16, "dst": "但泰坦派出了一位勇士去取回它。"}, {"si": 749, "ei": 17, "dst": "这证明泰坦的意志是真实的。"}, {"si": 749, "ei": 18, "dst": "哦,别在意我们。"}, {"si": 749, "ei": 19, "dst": "我们只是在去新德尔斐朝圣的路上歇脚。"}, {"si": 751, "ei": 0, "dst": "我曾以为旅行会让人兴奋。"}, {"si": 751, "ei": 1, "dst": "但外面其实挺无聊的。"}, {"si": 751, "ei": 2, "dst": "我腿疼。"}, {"si": 751, "ei": 3, "dst": "我们已经走了好几天了。"}, {"si": 751, "ei": 4, "dst": "我带着宠物血肉蠕虫踏上这段旅程。"}, {"si": 751, "ei": 5, "dst": "但在沙漠里断了粮,只好把它吃了。"}, {"si": 751, "ei": 6, "dst": "我可以再给你一条。"}, {"si": 751, "ei": 7, "dst": "不用了,谢谢。我已经很饱了。"}, {"si": 751, "ei": 8, "dst": "给,这个给你。"}, {"si": 751, "ei": 9, "dst": "我不要了。"}, {"si": 751, "ei": 10, "dst": "你一个人旅行?"}, {"si": 751, "ei": 11, "dst": "你要么非常勇敢,要么非常蠢。"}, {"si": 753, "ei": 0, "dst": "嘿!"}, {"si": 755, "ei": 0, "dst": "你好,陌生人。"}, {"si": 755, "ei": 1, "dst": "我会盯着你,但你可以随意走动。"}, {"si": 755, "ei": 2, "dst": "我们不常有访客来这儿。"}, {"si": 755, "ei": 3, "dst": "你是泰坦的朋友吗?"}, {"si": 755, "ei": 4, "dst": "我不这么认为。"}, {"si": 755, "ei": 5, "dst": "那你最好三思下一步行动。"}, {"si": 755, "ei": 6, "dst": "我们爱好和平,但并非没有防御能力。"}, {"si": 755, "ei": 7, "dst": "这个嘛,不好说。"}, {"si": 755, "ei": 8, "dst": "那我就把这当成你回心转意的机会吧。"}, {"si": 755, "ei": 9, "dst": "去探索世界,与人交谈,与血肉交谈,然后回到我们身边。"}, {"si": 755, "ei": 10, "dst": "其实,我正在找一个。"}, {"si": 755, "ei": 11, "dst": "嗯?"}, {"si": 755, "ei": 12, "dst": "给一位泰坦找朋友。"}, {"si": 755, "ei": 13, "dst": "是吗?哪位泰坦?"}, {"si": 755, "ei": 14, "dst": "血肉海妖。"}, {"si": 755, "ei": 15, "dst": "哈哈。那个老纠缠鬼。"}, {"si": 755, "ei": 16, "dst": "我会盯着你,但你可以随意走动。"}, {"si": 755, "ei": 17, "dst": "我想是的。"}, {"si": 755, "ei": 18, "dst": "很好。"}, {"si": 755, "ei": 19, "dst": "请把武器收起来。这里是和平之地。"}, {"si": 755, "ei": 20, "dst": "完全融合"}, {"si": 755, "ei": 21, "dst": "欢迎来到阳光下"}, {"si": 755, "ei": 22, "dst":